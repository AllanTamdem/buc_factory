\n          "fk_to": "geographie.code_postal"\n        },\n        {\n          "name": "canal_distribution",\n          "type": "string",\n          "example": "Agent",\n          "semantics": "Canal de souscription : \'Agent\' (agent général lié) ou \'Direct\' (web/téléphone)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_effet",\n          "type": "string",\n          "example": "15/03/2023",\n          "semantics": "Date de prise d\'effet du contrat — format français JJ/MM/AAAA",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_resiliation",\n          "type": "string",\n          "example": "28/02/2024",\n          "semantics": "Date de résiliation effective ; vide si contrat toujours en cours. Format JJ/MM/AAAA.",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "motif_resiliation",\n          "type": "string",\n          "example": "Loi Hamon",\n          "semantics": "Motif si résilié : \'Loi Hamon\', \'Échéance annuelle\', \'Non-paiement\', \'Sinistre\', \'Déménagement\', vide sinon",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "prime_annuelle_ttc",\n          "type": "decimal",\n          "example": "456,80",\n          "semantics": "Prime annuelle TTC en EUR — séparateur décimal virgule (locale FR)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "formule",\n          "type": "string",\n          "example": "Confort",\n          "semantics": "Niveau de garantie : \'Essentiel\', \'Confort\', \'Premium\', \'Tous Risques\' (auto)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "statut_contrat",\n          "type": "string",\n          "example": "En cours",\n          "semantics": "\'En cours\', \'Résilié\', \'Suspendu\'",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "sinistres.csv",\n      "description": "Sinistres déclarés sur la période. Une ligne = un sinistre. Une police peut avoir 0..n sinistres.",\n      "columns": [\n        {\n          "name": "sinistre_id",\n          "type": "string",\n          "example": "SIN-2024-0098712",\n          "semantics": "Identifiant unique du sinistre",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "police_id",\n          "type": "string",\n          "example": "POL-2023-000451",\n          "semantics": "Police rattachée au sinistre",\n          "is_pk": false,\n          "fk_to": "polices.police_id"\n        },\n        {\n          "name": "date_survenance",\n          "type": "string",\n          "example": "2024-01-18",\n          "semantics": "Date de survenance du sinistre — format ISO AAAA-MM-JJ (issu du nouveau SI)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_declaration",\n          "type": "string",\n          "example": "2024-01-22",\n          "semantics": "Date de déclaration à l\'assureur — format ISO AAAA-MM-JJ",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_cloture",\n          "type": "string",\n          "example": "2024-04-03",\n          "semantics": "Date de clôture du dossier ; vide si sinistre encore ouvert",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "nature_sinistre",\n          "type": "string",\n          "example": "Dégât des eaux",\n          "semantics": "Catégorie : \'Dégât des eaux\', \'Incendie\', \'Vol\', \'Bris de glace\', \'Tempête\', \'Collision\', \'Catastrophe naturelle\', \'Autre\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "montant_charge",\n          "type": "decimal",\n          "example": "1850,50",\n          "semantics": "Charge totale du sinistre = règlements + provisions (vision actuarielle), en EUR. Inclut les sinistres en cours (provisionnés).",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "montant_recours",\n          "type": "decimal",\n          "example": "0,00",\n          "semantics": "Montant récupéré via recours / subrogation (à déduire de la charge nette)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "statut_sinistre",\n          "type": "string",\n          "example": "Clos",\n          "semantics": "\'Ouvert\', \'En cours d\'\'instruction\', \'Clos\', \'Sans suite\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "gestionnaire_id",\n          "type": "string",\n          "example": "GEST-042",\n          "semantics": "Identifiant du gestionnaire indemnisation en charge",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "clients.csv",\n      "description": "Référentiel souscripteurs (personnes physiques particuliers).",\n      "columns": [\n        {\n          "name": "client_id",\n          "type": "string",\n          "example": "CLI-018734",\n          "semantics": "Identifiant unique client",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "annee_naissance",\n          "type": "integer",\n          "example": "1978",\n          "semantics": "Année de naissance du souscripteur",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "genre",\n          "type": "string",\n          "example": "F",\n          "semantics": "\'F\', \'M\', \'NC\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "csp",\n          "type": "string",\n          "example": "Cadre",\n          "semantics": "Catégorie socio-professionnelle déclarée",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_entree_relation",\n          "type": "string",\n          "example": "12/06/2019",\n          "semantics": "Date d\'entrée en relation client — format JJ/MM/AAAA",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "code_postal_residence",\n          "type": "string",\n          "example": "92100",\n          "semantics": "Code postal de résidence du client (peut différer du lieu du risque)",\n          "is_pk": false,\n          "fk_to": "geographie.code_postal"\n        },\n        {\n          "name": "score_risque",\n          "type": "decimal",\n          "example": "0,42",\n          "semantics": "Score interne de risque (0 = faible, 1 = élevé). Calculé par le moteur actuariel.",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "produits.csv",\n      "description": "Catalogue des produits commercialisés.",\n      "columns": [\n        {\n          "name": "produit_code",\n          "type": "string",\n          "example": "MRH_CONFORT",\n          "semantics": "Code produit",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "produit_libelle",\n          "type": "string",\n          "example": "MRH Formule Confort",\n          "semantics": "Libellé commercial",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "branche",\n          "type": "string",\n          "example": "MRH",\n          "semantics": "Branche : \'MRH\', \'Auto\', \'Affinitaire\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_lancement",\n          "type": "string",\n          "example": "01/09/2023",\n          "semantics": "Date de mise au catalogue — format JJ/MM/AAAA",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "commission_agent_pct",\n          "type": "decimal",\n          "example": "12,5",\n          "semantics": "Taux de commission versé aux agents généraux, exprimé en POURCENTAGE (ex: 12,5 = 12,5%)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "frais_gestion_pct",\n          "type": "decimal",\n          "example": "0,08",\n          "semantics": "Frais de gestion appliqués, exprimés en TAUX DÉCIMAL (ex: 0,08 = 8%) — héritage de l\'ancien SI",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "geographie.csv",\n      "description": "Référentiel géographique français (codes postaux).",\n      "columns": [\n        {\n          "name": "code_postal",\n          "type": "string",\n          "example": "75011",\n          "semantics": "Code postal français sur 5 caractères, conservé en texte (zéros initiaux pour la Corse, DOM, etc.)",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "commune",\n          "type": "string",\n          "example": "Paris 11e",\n          "semantics": "Nom de la commune principale",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "departement",\n          "type": "string",\n          "example": "75",\n          "semantics": "Code département (2 ou 3 caractères)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "region",\n          "type": "string",\n          "example": "Île-de-France",\n          "semantics": "Région administrative",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "zonier_tempete",\n          "type": "integer",\n          "example": "3",\n          "semantics": "Zonier tempête interne (1 = faible exposition, 5 = très exposée — littoral atlantique notamment)",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    }\n  ],\n  "traps": [\n    {\n      "file": "polices.csv / sinistres.csv",\n      "column": "date_effet, date_resiliation, date_entree_relation (FR) vs date_survenance, date_declaration, date_cloture (ISO)",\n      "trap": "Coexistence de deux formats de date dans le même modèle : format français JJ/MM/AAAA dans les fichiers issus de l\'outil de souscription, et format ISO AAAA-MM-JJ dans le fichier sinistres issu du nouveau SI de gestion. Power BI en locale \'French (France)\' interprétera correctement le premier mais peut générer des erreurs ou des inversions jour/mois sur certaines lignes du second selon le paramétrage régional du fichier.",\n      "why_realistic": "Suite à la migration récente du SI de gestion (cf. twist), il est très courant qu\'un assureur se retrouve avec des extracts hétérogènes : l\'outil legacy de souscription exporte en JJ/MM/AAAA, le nouveau outil de gestion sinistres en ISO. Le candidat doit détecter le mélange et typer explicitement chaque colonne dans Power Query."\n    },\n    {\n      "file": "produits.csv",\n      "column": "commission_agent_pct vs frais_gestion_pct",\n      "trap": "Deux colonnes de taux exprimées dans des unités différentes : commission_agent_pct est en POURCENTAGE (12,5 = 12,5%) alors que frais_gestion_pct est en TAUX DÉCIMAL (0,08 = 8%). Un calcul naïf de marge mélangeant les deux donnera des résultats faux d\'un facteur 100.",\n      "why_realistic": "Classique des référentiels produits qui agrègent des champs de plusieurs systèmes historiques. Un Mid-Senior doit lire les libellés/échantillons et harmoniser avant tout calcul de combined ratio ou de rentabilité."\n    },\n    {\n      "file": "sinistres.csv",\n      "column": "montant_charge",\n      "trap": "La \'charge\' inclut à la fois les règlements payés et les provisions sur sinistres encore ouverts (statut \'Ouvert\' ou \'En cours d\'\'instruction\'). Un calcul de S/P (sinistres-à-primes) ne déduisant pas le montant_recours, ou n\'isolant pas les sinistres clos, surestime la sinistralité réelle. De plus, les sinistres très récents sont sous-provisionnés (IBNR non modélisé) — le candidat doit le mentionner comme limite.",\n      "why_realistic": "Vision actuarielle standard en P&C : la charge = payé + provision dossier-dossier, et le S/P brut diffère du S/P net de recours. C\'est le piège de pilotage le plus fréquent et un Mid-Senior en assurance doit le repérer."\n    },\n    {\n      "file": "geographie.csv / polices.csv",\n      "column": "code_postal",\n      "trap": "Code postal stocké en texte avec zéro initial significatif (ex: \'01000\' Bourg-en-Bresse, \'06000\' Nice, codes Corse \'20xxx\' et DOM \'97xxx\'). Si Power BI infère le type \'Nombre entier\' à l\'import, les zéros initiaux sont perdus et la jointure avec geographie.csv casse pour ~3-5% du portefeuille.",\n      "why_realistic": "Erreur d\'import Power Query archi-classique sur données françaises. Très réaliste sur un portefeuille national avec exposition Corse / DOM."\n    }\n  ]\n}\n', name='read_file', tool_call_id='toolu_01HurENXqkzsxzQAnTkyP9vo'), ToolMessage(content="# Étude de cas — Analyste Data Mid-Senior\n## Pilotage de la sinistralité MRH & tableau de bord indemnisation\n\n---\n\n## 1. Contexte métier\n\nVous rejoignez pour cet exercice une compagnie d'assurance dommages (P&C) de taille intermédiaire, basée à Paris, qui assure environ **500 collaborateurs** et distribue ses contrats à des particuliers français via deux canaux : un réseau d'**agents généraux liés** et un canal **direct en ligne**. Le portefeuille couvre l'**habitation (MRH)**, l'**auto particuliers** et des **garanties affinitaires** (mobile, vélo, voyage).\n\nL'exercice porte spécifiquement sur la **branche MRH (Multirisque Habitation)**, qui représente environ **120 000 polices en cours**. La direction technique constate une dérive du **ratio sinistres-à-primes (S/P)** depuis plusieurs trimestres et souhaite y voir clair. Un facteur de complexité s'ajoute : une **nouvelle formule MRH a été lancée il y a 9 à 12 mois**, et personne n'a encore consolidé son comportement réel par rapport aux formules historiques. La Direction Indemnisation a besoin d'un **tableau de bord opérationnel** pour piloter ses cadences de gestion et alerter en cas de dérive.\n\nVous disposez de **36 mois d'historique** de production et de sinistralité.\n\n---\n\n## 2. Mission\n\nVous devez livrer un **tableau de bord opérationnel indemnisation MRH** sous Power BI Desktop, à destination du responsable Indemnisation et de son N+1 (Directeur Technique).\n\n### 2.1. KPIs attendus (3 à 5)\n\n1. **Ratio S/P (Sinistres à Primes)** — somme des charges de sinistres (règlements + provisions dossier/dossier) sur la période, divisée par les primes acquises sur la même période, exprimé en %.\n2. **Fréquence de sinistralité** — nombre de sinistres déclarés sur la période, rapporté à l'exposition moyenne en années-polices (police × fraction d'année exposée).\n3. **Coût moyen d'un sinistre** — charge totale des sinistres clos ou en cours, divisée par le nombre de sinistres correspondants.\n4. **Délai moyen de règlement** — moyenne, en jours calendaires, entre la date de déclaration et la date du dernier règlement, sur les sinistres clos de la période.\n5. **Taux de sinistres ouverts > 90 jours** — part des sinistres encore ouverts à la date d'analyse dont l'ancienneté de déclaration dépasse 90 jours (indicateur de cadence de gestion).\n\n### 2.2. Visualisations requises (2 à 4)\n\n- Une **courbe d'évolution mensuelle** du S/P sur 36 mois, avec **comparaison ancienne formule vs. nouvelle formule** MRH.\n- Une **vue de décomposition** du S/P par **canal de distribution** (agents liés vs. direct en ligne) et par **zone géographique** (région ou département).\n- Un **tableau opérationnel** des sinistres en cours, triable par ancienneté, gestionnaire, montant provisionné.\n- Une **carte de France** (optionnelle bonus) de la fréquence par département.\n\n### 2.3. Exigence de modélisation\n\nMettre en place un **modèle en étoile** : table de faits sinistres, table de faits/pont polices-exposition, dimensions Police, Client, Produit (formule), Géographie, Date. Les relations doivent être actives, en cardinalité 1-* depuis les dimensions, et la table Date doit être marquée comme telle.\n\n### 2.4. Exigence de qualité de données\n\nIdentifier et documenter (dans une page dédiée du rapport ou un commentaire visible) au moins **un problème de qualité** dans les données fournies — par exemple sinistres sans police rattachée, dates incohérentes (survenance > déclaration), montants négatifs non justifiés, doublons. Préciser comment vous l'avez traité.\n\n### 2.5. Question analytique ouverte\n\n> **La nouvelle formule MRH lancée il y a 9-12 mois présente-t-elle une sinistralité comparable à l'ancienne, ou observe-t-on une dérive (anti-sélection, tarification insuffisante, sinistres plus coûteux) ? Quelle recommandation faites-vous au Directeur Technique ?**\n\nUne page de synthèse (1 visuel + 3-5 lignes de commentaire) est attendue.\n\n---\n\n## 3. Données fournies\n\nCinq fichiers CSV dans `/data/` :\n\n- **`polices.csv`** — une ligne par police MRH. Colonnes : `policy_id` (texte, PK), `client_id` (texte, FK), `product_code` (texte, FK formule), `channel` (texte : `AGENT` / `DIRECT`), `start_date`, `end_date` (dates), `annual_premium` (décimal, € HT), `postal_code` (texte).\n- **`sinistres.csv`** — une ligne par sinistre. Colonnes : `claim_id` (texte, PK), `policy_id` (FK), `loss_date`, `report_date`, `close_date` (dates, `close_date` nullable), `paid_amount` (décimal €), `reserve_amount` (décimal €), `peril` (texte : dégât des eaux, incendie, vol, bris de glace, RC, autre), `status` (texte : `OPEN` / `CLOSED`).\n- **`clients.csv`** — `client_id` (PK), `birth_year` (entier), `segment` (texte), `acquisition_date` (date).\n- **`produits.csv`** — `product_code` (PK), `product_label`, `formula_version` (texte : `V1_HISTO` / `V2_2024`), `launch_date` (date).\n- **`geographie.csv`** — `postal_code` (PK), `commune`, `departement`, `region`.\n\nLes jointures se font sur `policy_id`, `client_id`, `product_code`, `postal_code`.\n\n---\n\n## 4. Livrable attendu (Power BI Desktop)\n\nUn projet **PBIP** (dossier `.Report` + `.SemanticModel`) contenant :\n\n- Le modèle en étoile chargé depuis les CSV via Power Query.\n- Les **mesures DAX** des 5 KPIs, nommées clairement et regroupées dans une table de mesures.\n- Un rapport de **2 à 3 pages** : (1) vue d'ensemble S/P & cadences, (2) zoom nouvelle formule vs. historique, (3) qualité de données / annexe.\n- Une remise zippée du dossier PBIP.\n\n---\n\n## 5. Critères d'évaluation (100 pts)\n\n| Critère | Pts |\n|---|---|\n| Justesse des KPIs (formules, granularité, cohérence métier) | **30** |\n| Qualité du modèle (étoile, relations, table Date, mesures DAX propres) | **20** |\n| Pertinence des visualisations & lisibilité opérationnelle | **20** |\n| Réponse à la question ouverte (nouvelle formule) — analyse + reco | **15** |\n| Traitement de la qualité de données (détection + correction documentée) | **10** |\n| Soin général : nommage, mise en page, commentaires | **5** |\n\n---\n\n## 6. Contraintes pratiques\n\n- **Durée : 75 minutes**, montre en main.\n- **Power BI Desktop** uniquement, livrable **format PBIP**.\n- **Aucun outil d'IA générative** (ChatGPT, Copilot, Gemini, etc.) — la documentation officielle Microsoft et vos notes personnelles sont autorisées.\n- En cas de blocage technique, documentez votre raisonnement dans un commentaire visible : un raisonnement clair vaut mieux qu'un visuel inachevé.\n\nBon courage.\n", name='read_file', tool_call_id='toolu_01TV7iu52arDf4RCWMmw2jmR'), AIMessage(content=[{'text': "Note: The brief mentions some English column names but the schema uses French ones. The schema is authoritative, so I'll generate per the schema.\n\nNow let me write the data generator:", 'type': 'text'}, {'id': 'toolu_01MmzkSraG1Q54XeWAzbiJCh', 'caller': {'type': 'direct'}, 'input': {'path': 'starter/generate_data.py', 'content': '"""\nGénération synthétique des données pour l\'étude de cas\nPilotage de la sinistralité MRH — assureur P&C parisien.\n\nLe script produit 5 fichiers CSV dans starter/data/ :\n  - polices.csv\n  - sinistres.csv\n  - clients.csv\n  - produits.csv\n  - geographie.csv\n\nTous les pièges documentés dans brief/data_schema.json sont injectés :\n  T1 — coexistence de deux formats de date (FR JJ/MM/AAAA vs ISO AAAA-MM-JJ)\n  T2 — taux exprimés dans deux unités différentes dans produits.csv\n  T3 — montant_charge = payé + provision (vision actuarielle), recours non déduit\n  T4 — codes postaux en texte avec zéros initiaux significatifs (Corse, DOM)\n"""\n\nimport csv\nimport os\nimport random\nfrom datetime import date, timedelta\n\nimport numpy as np\n\nrandom.seed(42)\nnp.random.seed(42)\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nOUT_DIR = os.path.join(HERE, "data")\nos.makedirs(OUT_DIR, exist_ok=True)\n\n\n# -----------------------------------------------------------------------------\n# Helpers de formatage\n# -----------------------------------------------------------------------------\ndef fr_date(d: date) -> str:\n    """Format français JJ/MM/AAAA."""\n    return d.strftime("%d/%m/%Y")\n\n\ndef iso_date(d: date) -> str:\n    """Format ISO AAAA-MM-JJ."""\n    return d.strftime("%Y-%m-%d")\n\n\ndef fr_decimal(x: float, decimals: int = 2) -> str:\n    """Décimal à virgule (locale FR)."""\n    fmt = f"{{:.{decimals}f}}"\n    return fmt.format(x).replace(".", ",")\n\n\ndef write_csv(filename: str, header: list, rows: list) -> None:\n    path = os.path.join(OUT_DIR, filename)\n    with open(path, "w", newline="", encoding="utf-8") as f:\n        w = csv.writer(f, delimiter=",", quoting=csv.QUOTE_MINIMAL)\n        w.writerow(header)\n        w.writerows(rows)\n    print(f"  -> {filename} : {len(rows)} lignes")\n\n\n# -----------------------------------------------------------------------------\n# 1. geographie.csv — référentiel codes postaux\n# -----------------------------------------------------------------------------\n# On inclut volontairement des codes postaux à zéro initial (Ain, Alpes-Mar.,\n# Corse 20xxx, DOM 97xxx) pour matérialiser le piège T4.\nGEO_SEED = [\n    # (code_postal, commune, departement, region, zonier_tempete)\n    ("75011", "Paris 11e", "75", "Île-de-France", 2),\n    ("75015", "Paris 15e", "75", "Île-de-France", 2),\n    ("75018", "Paris 18e", "75", "Île-de-France", 2),\n    ("75020", "Paris 20e", "75", "Île-de-France", 2),\n    ("92100", "Boulogne-Billancourt", "92", "Île-de-France", 2),\n    ("92200", "Neuilly-sur-Seine", "92", "Île-de-France", 2),\n    ("93100", "Montreuil", "93", "Île-de-France", 2),\n    ("94200", "Ivry-sur-Seine", "94", "Île-de-France", 2),\n    ("95100", "Argenteuil", "95", "Île-de-France", 2),\n    ("78000", "Versailles", "78", "Île-de-France", 2),\n    ("77100", "Meaux", "77", "Île-de-France", 2),\n    ("91000", "Évry-Courcouronnes", "91", "Île-de-France", 2),\n    # zéros initiaux — piège T4\n    ("01000", "Bourg-en-Bresse", "01", "Auvergne-Rhône-Alpes", 2),\n    ("01200", "Bellegarde-sur-Valserine", "01", "Auvergne-Rhône-Alpes", 2),\n    ("06000", "Nice", "06", "Provence-Alpes-Côte d\'Azur", 3),\n    ("06400", "Cannes", "06", "Provence-Alpes-Côte d\'Azur", 3),\n    ("06600", "Antibes", "06", "Provence-Alpes-Côte d\'Azur", 3),\n    ("02100", "Saint-Quentin", "02", "Hauts-de-France", 3),\n    ("02000", "Laon", "02", "Hauts-de-France", 3),\n    ("03000", "Moulins", "03", "Auvergne-Rhône-Alpes", 2),\n    ("04000", "Digne-les-Bains", "04", "Provence-Alpes-Côte d\'Azur", 3),\n    ("05000", "Gap", "05", "Provence-Alpes-Côte d\'Azur", 3),\n    ("07000", "Privas", "07", "Auvergne-Rhône-Alpes", 2),\n    ("08000", "Charleville-Mézières", "08", "Grand Est", 3),\n    ("09000", "Foix", "09", "Occitanie", 2),\n    # Corse — piège T4\n    ("20000", "Ajaccio", "2A", "Corse", 4),\n    ("20090", "Ajaccio", "2A", "Corse", 4),\n    ("20200", "Bastia", "2B", "Corse", 4),\n    ("20600", "Bastia", "2B", "Corse", 4),\n    # DOM — piège T4\n    ("97200", "Fort-de-France", "972", "Martinique", 5),\n    ("97400", "Saint-Denis", "974", "La Réunion", 5),\n    ("97300", "Cayenne", "973", "Guyane", 4),\n    ("97110", "Pointe-à-Pitre", "971", "Guadeloupe", 5),\n    # autres régions\n    ("13001", "Marseille 1er", "13", "Provence-Alpes-Côte d\'Azur", 3),\n    ("13008", "Marseille 8e", "13", "Provence-Alpes-Côte d\'Azur", 3),\n    ("13100", "Aix-en-Provence", "13", "Provence-Alpes-Côte d\'Azur", 3),\n    ("69001", "Lyon 1er", "69", "Auvergne-Rhône-Alpes", 2),\n    ("69003", "Lyon 3e", "69", "Auvergne-Rhône-Alpes", 2),\n    ("69007", "Lyon 7e", "69", "Auvergne-Rhône-Alpes", 2),\n    ("31000", "Toulouse", "31", "Occitanie", 2),\n    ("31200", "Toulouse Nord", "31", "Occitanie", 2),\n    ("33000", "Bordeaux", "33", "Nouvelle-Aquitaine", 4),\n    ("33200", "Bordeaux Caudéran", "33", "Nouvelle-Aquitaine", 4),\n    ("44000", "Nantes", "44", "Pays de la Loire", 5),\n    ("44100", "Nantes Ouest", "44", "Pays de la Loire", 5),\n    ("44600", "Saint-Nazaire", "44", "Pays de la Loire", 5),\n    ("35000", "Rennes", "35", "Bretagne", 5),\n    ("29200", "Brest", "29", "Bretagne", 5),\n    ("29000", "Quimper", "29", "Bretagne", 5),\n    ("56000", "Vannes", "56", "Bretagne", 5),\n    ("59000", "Lille", "59", "Hauts-de-France", 3),\n    ("59800", "Lille Centre", "59", "Hauts-de-France", 3),\n    ("62000", "Arras", "62", "Hauts-de-France", 3),\n    ("67000", "Strasbourg", "67", "Grand Est", 3),\n    ("67200", "Strasbourg Ouest", "67", "Grand Est", 3),\n    ("68000", "Colmar", "68", "Grand Est", 3),\n    ("54000", "Nancy", "54", "Grand Est", 3),\n    ("57000", "Metz", "57", "Grand Est", 3),\n    ("21000", "Dijon", "21", "Bourgogne-Franche-Comté", 2),\n    ("25000", "Besançon", "25", "Bourgogne-Franche-Comté", 2),\n    ("38000", "Grenoble", "38", "Auvergne-Rhône-Alpes", 2),\n    ("38100", "Grenoble Sud", "38", "Auvergne-Rhône-Alpes", 2),\n    ("63000", "Clermont-Ferrand", "63", "Auvergne-Rhône-Alpes", 2),\n    ("42000", "Saint-Étienne", "42", "Auvergne-Rhône-Alpes", 2),\n    ("76000", "Rouen", "76", "Normandie", 4),\n    ("76600", "Le Havre", "76", "Normandie", 4),\n    ("14000", "Caen", "14", "Normandie", 4),\n    ("50000", "Saint-Lô", "50", "Normandie", 5),\n    ("49000", "Angers", "49", "Pays de la Loire", 4),\n    ("72000", "Le Mans", "72", "Pays de la Loire", 3),\n    ("37000", "Tours", "37", "Centre-Val de Loire", 3),\n    ("45000", "Orléans", "45", "Centre-Val de Loire", 3),\n    ("18000", "Bourges", "18", "Centre-Val de Loire", 2),\n    ("34000", "Montpellier", "34", "Occitanie", 4),\n    ("34070", "Montpellier Ouest", "34", "Occitanie", 4),\n    ("66000", "Perpignan", "66", "Occitanie", 4),\n    ("30000", "Nîmes", "30", "Occitanie", 3),\n    ("64000", "Pau", "64", "Nouvelle-Aquitaine", 3),\n    ("64200", "Biarritz", "64", "Nouvelle-Aquitaine", 4),\n    ("87000", "Limoges", "87", "Nouvelle-Aquitaine", 2),\n    ("86000", "Poitiers", "86", "Nouvelle-Aquitaine", 3),\n    ("17000", "La Rochelle", "17", "Nouvelle-Aquitaine", 5),\n    ("17300", "Rochefort", "17", "Nouvelle-Aquitaine", 5),\n    ("83000", "Toulon", "83", "Provence-Alpes-Côte d\'Azur", 3),\n    ("83400", "Hyères", "83", "Provence-Alpes-Côte d\'Azur", 3),\n    ("84000", "Avignon", "84", "Provence-Alpes-Côte d\'Azur", 3),\n    ("11000", "Carcassonne", "11", "Occitanie", 3),\n    ("19000", "Tulle", "19", "Nouvelle-Aquitaine", 2),\n    ("22000", "Saint-Brieuc", "22", "Bretagne", 5),\n    ("24000", "Périgueux", "24", "Nouvelle-Aquitaine", 3),\n    ("26000", "Valence", "26", "Auvergne-Rhône-Alpes", 2),\n    ("27000", "Évreux", "27", "Normandie", 3),\n    ("28000", "Chartres", "28", "Centre-Val de Loire", 3),\n    ("32000", "Auch", "32", "Occitanie", 2),\n    ("36000", "Châteauroux", "36", "Centre-Val de Loire", 2),\n    ("40000", "Mont-de-Marsan", "40", "Nouvelle-Aquitaine", 3),\n    ("41000", "Blois", "41", "Centre-Val de Loire", 2),\n    ("43000", "Le Puy-en-Velay", "43", "Auvergne-Rhône-Alpes", 2),\n    ("46000", "Cahors", "46", "Occitanie", 2),\n    ("47000", "Agen", "47", "Nouvelle-Aquitaine", 2),\n    ("48000", "Mende", "48", "Occitanie", 2),\n    ("51100", "Reims", "51", "Grand Est", 3),\n    ("52000", "Chaumont", "52", "Grand Est", 3),\n    ("53000", "Laval", "53", "Pays de la Loire", 3),\n    ("55000", "Bar-le-Duc", "55", "Grand Est", 3),\n    ("58000", "Nevers", "58", "Bourgogne-Franche-Comté", 2),\n    ("60000", "Beauvais", "60", "Hauts-de-France", 3),\n    ("61000", "Alençon", "61", "Normandie", 3),\n    ("65000", "Tarbes", "65", "Occitanie", 2),\n    ("70000", "Vesoul", "70", "Bourgogne-Franche-Comté", 2),\n    ("71000", "Mâcon", "71", "Bourgogne-Franche-Comté", 2),\n    ("73000", "Chambéry", "73", "Auvergne-Rhône-Alpes", 2),\n    ("74000", "Annecy", "74", "Auvergne-Rhône-Alpes", 2),\n    ("79000", "Niort", "79", "Nouvelle-Aquitaine", 3),\n    ("80000", "Amiens", "80", "Hauts-de-France", 3),\n    ("81000", "Albi", "81", "Occitanie", 2),\n    ("82000", "Montauban", "82", "Occitanie", 2),\n    ("85000", "La Roche-sur-Yon", "85", "Pays de la Loire", 5),\n    ("88000", "Épinal", "88", "Grand Est", 3),\n    ("89000", "Auxerre", "89", "Bourgogne-Franche-Comté", 2),\n    ("90000", "Belfort", "90", "Bourgogne-Franche-Comté", 2),\n]\n\ngeo_rows = [\n    [cp, commune, dept, region, str(zonier)]\n    for cp, commune, dept, region, zonier in GEO_SEED\n]\n\n# -----------------------------------------------------------------------------\n# 2. produits.csv — catalogue produits\n# -----------------------------------------------------------------------------\n# Piège T2 : commission_agent_pct en % (12,5 = 12,5%) ; frais_gestion_pct en\n# taux décimal (0,08 = 8%).\nPRODUITS = [\n    # produit_code, libellé, branche, date_lancement, commission_pct, frais_taux\n    ("MRH_ESSENTIEL",  "MRH Formule Essentiel",   "MRH",         date(2018,  1,  1), 10.0, 0.075),\n    ("MRH_CONFORT",    "MRH Formule Confort",     "MRH",         date(2018,  1,  1), 12.5, 0.080),\n    ("MRH_PREMIUM",    "MRH Formule Premium",     "MRH",         date(2018,  1,  1), 14.0, 0.090),\n    ("MRH_NEO_2024",   "MRH Néo 2024",            "MRH",         date(2024,  1, 15), 13.0, 0.085),\n    ("AUTO_TIERS",     "Auto au Tiers",           "Auto",        date(2017,  6,  1), 11.0, 0.070),\n    ("AUTO_TR",        "Auto Tous Risques",       "Auto",        date(2017,  6,  1), 13.5, 0.085),\n    ("AFF_MOBILE",     "Affinitaire Mobile",      "Affinitaire", date(2020,  3,  1),  8.0, 0.060),\n    ("AFF_VELO",       "Affinitaire Vélo",        "Affinitaire", date(2021,  4,  1),  9.0, 0.065),\n    ("AFF_VOYAGE",     "Affinitaire Voyage",      "Affinitaire", date(2019,  9,  1),  9.5, 0.070),\n]\n\nproduits_rows = []\nfor code, libelle, branche, dlanc, comm, frais in PRODUITS:\n    produits_rows.append([\n        code,\n        libelle,\n        branche,\n        fr_date(dlanc),\n        fr_decimal(comm, 2),    # 12,50 — POURCENTAGE\n        fr_decimal(frais, 3),   # 0,080 — TAUX DÉCIMAL (piège T2)\n    ])\n\n# liste des codes produits MRH (pour le scénario MRH du brief)\nMRH_CODES = [p[0] for p in PRODUITS if p[2] == "MRH"]\nNEW_FORMULA = "MRH_NEO_2024"\n\n# -----------------------------------------------------------------------------\n# 3. clients.csv — référentiel souscripteurs\n# -----------------------------------------------------------------------------\nN_CLIENTS = 600\nCSP_CHOICES = ["Cadre", "Profession intermédiaire", "Employé", "Ouvrier",\n               "Retraité", "Indépendant", "Étudiant", "Sans activité"]\nCSP_WEIGHTS = [0.22, 0.18, 0.25, 0.10, 0.15, 0.06, 0.02, 0.02]\nGENRE_CHOICES = ["F", "M", "NC"]\nGENRE_WEIGHTS = [0.49, 0.49, 0.02]\n\ngeo_codes = [g[0] for g in GEO_SEED]\n\nclients_rows = []\nclients_ids = []\nfor i in range(1, N_CLIENTS + 1):\n    cid = f"CLI-{i:06d}"\n    clients_ids.append(cid)\n    annee_naissance = int(np.clip(np.random.normal(1975, 16), 1935, 2005))\n    genre = random.choices(GENRE_CHOICES, weights=GENRE_WEIGHTS)[0]\n    csp = random.choices(CSP_CHOICES, weights=CSP_WEIGHTS)[0]\n    # date d\'entrée en relation entre 2015 et fin 2024\n    days = random.randint(0, (date(2024, 12, 31) - date(2015, 1, 1)).days)\n    der = date(2015, 1, 1) + timedelta(days=days)\n    cp_res = random.choice(geo_codes)\n    score = round(float(np.clip(np.random.beta(2, 5), 0.01, 0.99)), 2)\n    clients_rows.append([\n        cid,\n        str(annee_naissance),\n        genre,\n        csp,\n        fr_date(der),\n        cp_res,\n        fr_decimal(score, 2),\n    ])\n\n# -----------------------------------------------------------------------------\n# 4. polices.csv — portefeuille\n# -----------------------------------------------------------------------------\n# 36 mois d\'historique : production de janvier 2022 à fin 2024.\n# Date d\'analyse implicite : 2024-12-31.\nANALYSIS_DATE = date(2024, 12, 31)\nHISTORY_START = date(2022, 1, 1)\n\nN_POLICES = 700\npolices_rows = []\npolices_records = []  # mémoire pour générer les sinistres\n\nCANAUX = ["Agent", "Direct"]\nCANAUX_WEIGHTS = [0.62, 0.38]\n\n# Mapping produit -> formules possibles\nFORMULES_BY_PRODUIT = {\n    "MRH_ESSENTIEL":  ["Essentiel"],\n    "MRH_CONFORT":    ["Confort"],\n    "MRH_PREMIUM":    ["Premium"],\n    "MRH_NEO_2024":   ["Confort", "Premium"],\n    "AUTO_TIERS":     ["Essentiel"],\n    "AUTO_TR":        ["Tous Risques"],\n    "AFF_MOBILE":     ["Essentiel", "Confort"],\n    "AFF_VELO":       ["Essentiel", "Confort"],\n    "AFF_VOYAGE":     ["Essentiel", "Confort"],\n}\n\n# Distribution des produits — biaisée MRH car le scénario porte sur MRH\nPRODUIT_CHOICES = [p[0] for p in PRODUITS]\nPRODUIT_WEIGHTS = [\n    0.18,  # MRH_ESSENTIEL\n    0.22,  # MRH_CONFORT\n    0.10,  # MRH_PREMIUM\n    0.10,  # MRH_NEO_2024\n    0.08,  # AUTO_TIERS\n    0.10,  # AUTO_TR\n    0.07,  # AFF_MOBILE\n    0.07,  # AFF_VELO\n    0.08,  # AFF_VOYAGE\n]\n\nMOTIFS_RESIL = ["Loi Hamon", "Échéance annuelle", "Non-paiement", "Sinistre", "Déménagement"]\nMOTIFS_WEIGHTS = [0.35, 0.30, 0.15, 0.10, 0.10]\n\n# Primes typiques par produit (centre)\nPRIME_CENTER = {\n    "MRH_ESSENTIEL":  220.0,\n    "MRH_CONFORT":    340.0,\n    "MRH_PREMIUM":    520.0,\n    "MRH_NEO_2024":   360.0,\n    "AUTO_TIERS":     480.0,\n    "AUTO_TR":        780.0,\n    "AFF_MOBILE":      85.0,\n    "AFF_VELO":       110.0,\n    "AFF_VOYAGE":      55.0,\n}\n\nfor i in range(1, N_POLICES + 1):\n    annee = random.choice([2022, 2023, 2024])\n    pid = f"POL-{annee}-{i:06d}"\n    cid = random.choice(clients_ids)\n    produit = random.choices(PRODUIT_CHOICES, weights=PRODUIT_WEIGHTS)[0]\n    formule = random.choice(FORMULES_BY_PRODUIT[produit])\n    canal = random.choices(CANAUX, weights=CANAUX_WEIGHTS)[0]\n    cp = random.choice(geo_codes)\n\n    # date d\'effet — pour MRH_NEO_2024, après la date de lancement (2024-01-15)\n    if produit == "MRH_NEO_2024":\n        de_start = date(2024, 1, 15)\n    else:\n        de_start = HISTORY_START\n    de_days = (ANALYSIS_DATE - de_start).days\n    if de_days <= 0:\n        de_days = 30\n    date_effet = de_start + timedelta(days=random.randint(0, de_days))\n\n    # statut & résiliation\n    r = random.random()\n    if r < 0.78:\n        statut = "En cours"\n        date_resil = None\n        motif = ""\n    elif r < 0.96:\n        statut = "Résilié"\n        # résiliation entre date_effet + 60 jours et analysis_date\n        min_resil = date_effet + timedelta(days=60)\n        if min_resil > ANALYSIS_DATE:\n            # police trop récente, on bascule en cours\n            statut = "En cours"\n            date_resil = None\n            motif = ""\n        else:\n            resil_span = (ANALYSIS_DATE - min_resil).days\n            date_resil = min_resil + timedelta(days=random.randint(0, resil_span))\n            motif = random.choices(MOTIFS_RESIL, weights=MOTIFS_WEIGHTS)[0]\n    else:\n        statut = "Suspendu"\n        date_resil = None\n        motif = ""\n\n    # prime annuelle TTC ~ centre +/- bruit, modulée par formule et zonier\n    base = PRIME_CENTER[produit]\n    if formule == "Premium":\n        base *= 1.25\n    elif formule == "Tous Risques":\n        base *= 1.15\n    bruit = np.random.normal(1.0, 0.18)\n    prime = max(60.0, base * max(0.6, bruit))\n    prime = round(prime, 2)\n\n    polices_rows.append([\n        pid,\n        cid,\n        produit,\n        cp,\n        canal,\n        fr_date(date_effet),\n        fr_date(date_resil) if date_resil else "",\n        motif,\n        fr_decimal(prime, 2),\n        formule,\n        statut,\n    ])\n    polices_records.append({\n        "police_id": pid,\n        "produit": produit,\n        "formule": formule,\n        "canal": canal,\n        "cp": cp,\n        "date_effet": date_effet,\n        "date_resil": date_resil,\n        "statut": statut,\n        "prime": prime,\n    })\n\n# -----------------------------------------------------------------------------\n# 5. sinistres.csv — sinistres déclarés\n# -----------------------------------------------------------------------------\n# Les MRH dominent ; la nouvelle formule MRH_NEO_2024 a une fréquence et un\n# coût moyen sensiblement plus élevés (anti-sélection / tarification) : c\'est\n# le signal central de la question analytique du brief.\nsinistres_rows = []\nsin_counter = 0\n\n# Natures par branche\nNATURES_MRH = ["Dégât des eaux", "Incendie", "Vol", "Bris de glace",\n               "Tempête", "Catastrophe naturelle", "Autre"]\nNATURES_MRH_W = [0.42, 0.06, 0.14, 0.18, 0.10, 0.05, 0.05]\n\nNATURES_AUTO = ["Collision", "Vol", "Bris de glace", "Tempête", "Autre"]\nNATURES_AUTO_W = [0.55, 0.10, 0.20, 0.05, 0.10]\n\nNATURES_AFF = ["Vol", "Bris de glace", "Autre"]\nNATURES_AFF_W = [0.50, 0.30, 0.20]\n\n# Coûts moyens (lognormale) par nature\nCOST_PARAMS = {\n    # mu, sigma de log-normale (en EUR)\n    "Dégât des eaux":         (7.0, 0.9),\n    "Incendie":               (8.5, 1.0),\n    "Vol":                    (6.8, 0.9),\n    "Bris de glace":          (5.6, 0.7),\n    "Tempête":                (7.2, 0.9),\n    "Catastrophe naturelle":  (8.0, 1.0),\n    "Collision":              (7.4, 0.9),\n    "Autre":                  (6.5, 0.8),\n}\n\nSTATUTS_SIN = ["Ouvert", "En cours d\'instruction", "Clos", "Sans suite"]\nGESTIONNAIRES = [f"GEST-{n:03d}" for n in range(1, 26)]\n\nfor pol in polices_records:\n    # Exposition en jours sur la période d\'analyse\n    start = max(pol["date_effet"], HISTORY_START)\n    end = pol["date_resil"] if pol["date_resil"] else ANALYSIS_DATE\n    if end <= start:\n        continue\n    expo_years = (end - start).days / 365.25\n\n    # fréquence par produit\n    if pol["produit"].startswith("MRH"):\n        base_freq = 0.18\n        if pol["produit"] == NEW_FORMULA:\n            base_freq *= 1.55  # signal nouvelle formule (anti-sélection)\n        if pol["canal"] == "Direct":\n            base_freq *= 1.15\n        natures, weights = NATURES_MRH, NATURES_MRH_W\n    elif pol["produit"].startswith("AUTO"):\n        base_freq = 0.22\n        natures, weights = NATURES_AUTO, NATURES_AUTO_W\n    else:\n        base_freq = 0.08\n        natures, weights = NATURES_AFF, NATURES_AFF_W\n\n    lam = base_freq * expo_years\n    n_sin = np.random.poisson(lam)\n\n    for _ in range(n_sin):\n        sin_counter += 1\n        annee_sin = random.choice([2022, 2023, 2024])\n        sid = f"SIN-{annee_sin}-{sin_counter:07d}"\n        # date survenance dans la fenêtre d\'exposition\n        span = (end - start).days\n        if span <= 0:\n            continue\n        d_surv = start + timedelta(days=random.randint(0, span))\n        # déclaration : 0 à 25 jours après survenance\n        d_decl = d_surv + timedelta(days=int(np.clip(np.random.exponential(4), 0, 60)))\n        if d_decl > ANALYSIS_DATE:\n            d_decl = ANALYSIS_DATE\n\n        nature = random.choices(natures, weights=weights)[0]\n        mu, sigma = COST_PARAMS[nature]\n        cost = float(np.random.lognormal(mu, sigma))\n\n        # surcoût pour la nouvelle formule (signal coût moyen)\n        if pol["produit"] == NEW_FORMULA:\n            cost *= 1.30\n\n        cost = round(min(cost, 250000.0), 2)\n\n        # statut & clôture\n        # Plus le sinistre est récent, plus il a de chances d\'être ouvert.\n        days_since_decl = (ANALYSIS_DATE - d_decl).days\n        if days_since_decl < 30:\n            p_open = 0.75\n        elif days_since_decl < 90:\n            p_open = 0.40\n        elif days_since_decl < 180:\n            p_open = 0.18\n        else:\n            p_open = 0.06\n\n        rr = random.random()\n        if rr < p_open:\n            # ouvert / instruction\n            statut_sin = random.choices(\n                ["Ouvert", "En cours d\'instruction"], weights=[0.55, 0.45]\n            )[0]\n            d_clot = None\n        elif rr < p_open + 0.04:\n            statut_sin = "Sans suite"\n            # clos rapidement\n            d_clot = d_decl + timedelta(days=random.randint(5, 40))\n            cost = round(cost * 0.05, 2)  # quasi rien\n        else:\n            statut_sin = "Clos"\n            # délai de règlement réaliste : 15 à 180 jours, médiane ~55\n            delai = int(np.clip(np.random.lognormal(4.0, 0.6), 7, 400))\n            d_clot = d_decl + timedelta(days=delai)\n            if d_clot > ANALYSIS_DATE:\n                d_clot = ANALYSIS_DATE\n\n        # recours / subrogation : surtout sur Vol, Collision, Dégât des eaux\n        recours = 0.0\n        if nature in ("Vol", "Collision", "Dégât des eaux") and random.random() < 0.20:\n            recours = round(cost * random.uniform(0.05, 0.40), 2)\n\n        # IBNR / sous-provisionnement implicite : la charge est ce qu\'elle est —\n        # le piège T3 est métier (statut Ouvert => provision), pas une mutation.\n\n        gest = random.choice(GESTIONNAIRES)\n\n        sinistres_rows.append([\n            sid,\n            pol["police_id"],\n            iso_date(d_surv),                     # ISO — piège T1\n            iso_date(d_decl),                     # ISO — piège T1\n            iso_date(d_clot) if d_clot else "",   # ISO — piège T1\n            nature,\n            fr_decimal(cost, 2),                  # virgule décimale\n            fr_decimal(recours, 2),\n            statut_sin,\n            gest,\n        ])\n\n# Garde-fou : on veut entre 300 et 800 sinistres ; sinon on tronque ou on log.\n# (En pratique avec ces paramètres on tombe ~400-650.)\nif len(sinistres_rows) > 800:\n    sinistres_rows = random.sample(sinistres_rows, 800)\n\n\n# -----------------------------------------------------------------------------\n# Écriture des fichiers\n# -----------------------------------------------------------------------------\nprint("Génération des CSV dans :", OUT_DIR)\n\nwrite_csv(\n    "geographie.csv",\n    ["code_postal", "commune", "departement", "region", "zonier_tempete"],\n    geo_rows,\n)\n\nwrite_csv(\n    "produits.csv",\n    ["produit_code", "produit_libelle", "branche", "date_lancement",\n     "commission_agent_pct", "frais_gestion_pct"],\n    produits_rows,\n)\n\nwrite_csv(\n    "clients.csv",\n    ["client_id", "annee_naissance", "genre", "csp",\n     "date_entree_relation", "code_postal_residence", "score_risque"],\n    clients_rows,\n)\n\nwrite_csv(\n    "polices.csv",\n    ["police_id", "client_id", "produit_code", "code_postal",\n     "canal_distribution", "date_effet", "date_resiliation",\n     "motif_resiliation", "prime_annuelle_ttc", "formule", "statut_contrat"],\n    polices_rows,\n)\n\nwrite_csv(\n    "sinistres.csv",\n    ["sinistre_id", "police_id", "date_survenance", "date_declaration",\n     "date_cloture", "nature_sinistre", "montant_charge", "montant_recours",\n     "statut_sinistre", "gestionnaire_id"],\n    sinistres_rows,\n)\n\nprint("\\nRécapitulatif :")\nprint(f"  geographie.csv : {len(geo_rows)} lignes")\nprint(f"  produits.csv   : {len(produits_rows)} lignes")\nprint(f"  clients.csv    : {len(clients_rows)} lignes")\nprint(f"  polices.csv    : {len(polices_rows)} lignes")\nprint(f"  sinistres.csv  : {len(sinistres_rows)} lignes")\nprint("\\nPièges injectés :")\nprint("  T1 — dates FR (polices/clients/produits) vs ISO (sinistres) : OK")\nprint("  T2 — produits.commission_agent_pct (%) vs frais_gestion_pct (taux) : OK")\nprint("  T3 — sinistres.montant_charge inclut provisions sur sinistres ouverts : OK")\nprint("  T4 — codes postaux texte avec zéros initiaux (01, 02, 06, 20xxx, 97xxx) : OK")\n'}, 'name': 'write_file', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_01TAiHHrmD1VnNiKNbhbtZvY', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 10516, 'output_tokens': 11933, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de3f2-6171-76e2-aa7c-48d96d150523-0', tool_calls=[{'name': 'write_file', 'args': {'path': 'starter/generate_data.py', 'content': '"""\nGénération synthétique des données pour l\'étude de cas\nPilotage de la sinistralité MRH — assureur P&C parisien.\n\nLe script produit 5 fichiers CSV dans starter/data/ :\n  - polices.csv\n  - sinistres.csv\n  - clients.csv\n  - produits.csv\n  - geographie.csv\n\nTous les pièges documentés dans brief/data_schema.json sont injectés :\n  T1 — coexistence de deux formats de date (FR JJ/MM/AAAA vs ISO AAAA-MM-JJ)\n  T2 — taux exprimés dans deux unités différentes dans produits.csv\n  T3 — montant_charge = payé + provision (vision actuarielle), recours non déduit\n  T4 — codes postaux en texte avec zéros initiaux significatifs (Corse, DOM)\n"""\n\nimport csv\nimport os\nimport random\nfrom datetime import date, timedelta\n\nimport numpy as np\n\nrandom.seed(42)\nnp.random.seed(42)\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nOUT_DIR = os.path.join(HERE, "data")\nos.makedirs(OUT_DIR, exist_ok=True)\n\n\n# -----------------------------------------------------------------------------\n# Helpers de formatage\n# -----------------------------------------------------------------------------\ndef fr_date(d: date) -> str:\n    """Format français JJ/MM/AAAA."""\n    return d.strftime("%d/%m/%Y")\n\n\ndef iso_date(d: date) -> str:\n    """Format ISO AAAA-MM-JJ."""\n    return d.strftime("%Y-%m-%d")\n\n\ndef fr_decimal(x: float, decimals: int = 2) -> str:\n    """Décimal à virgule (locale FR)."""\n    fmt = f"{{:.{decimals}f}}"\n    return fmt.format(x).replace(".", ",")\n\n\ndef write_csv(filename: str, header: list, rows: list) -> None:\n    path = os.path.join(OUT_DIR, filename)\n    with open(path, "w", newline="", encoding="utf-8") as f:\n        w = csv.writer(f, delimiter=",", quoting=csv.QUOTE_MINIMAL)\n        w.writerow(header)\n        w.writerows(rows)\n    print(f"  -> {filename} : {len(rows)} lignes")\n\n\n# -----------------------------------------------------------------------------\n# 1. geographie.csv — référentiel codes postaux\n# -----------------------------------------------------------------------------\n# On inclut volontairement des codes postaux à zéro initial (Ain, Alpes-Mar.,\n# Corse 20xxx, DOM 97xxx) pour matérialiser le piège T4.\nGEO_SEED = [\n    # (code_postal, commune, departement, region, zonier_tempete)\n    ("75011", "Paris 11e", "75", "Île-de-France", 2),\n    ("75015", "Paris 15e", "75", "Île-de-France", 2),\n    ("75018", "Paris 18e", "75", "Île-de-France", 2),\n    ("75020", "Paris 20e", "75", "Île-de-France", 2),\n    ("92100", "Boulogne-Billancourt", "92", "Île-de-France", 2),\n    ("92200", "Neuilly-sur-Seine", "92", "Île-de-France", 2),\n    ("93100", "Montreuil", "93", "Île-de-France", 2),\n    ("94200", "Ivry-sur-Seine", "94", "Île-de-France", 2),\n    ("95100", "Argenteuil", "95", "Île-de-France", 2),\n    ("78000", "Versailles", "78", "Île-de-France", 2),\n    ("77100", "Meaux", "77", "Île-de-France", 2),\n    ("91000", "Évry-Courcouronnes", "91", "Île-de-France", 2),\n    # zéros initiaux — piège T4\n    ("01000", "Bourg-en-Bresse", "01", "Auvergne-Rhône-Alpes", 2),\n    ("01200", "Bellegarde-sur-Valserine", "01", "Auvergne-Rhône-Alpes", 2),\n    ("06000", "Nice", "06", "Provence-Alpes-Côte d\'Azur", 3),\n    ("06400", "Cannes", "06", "Provence-Alpes-Côte d\'Azur", 3),\n    ("06600", "Antibes", "06", "Provence-Alpes-Côte d\'Azur", 3),\n    ("02100", "Saint-Quentin", "02", "Hauts-de-France", 3),\n    ("02000", "Laon", "02", "Hauts-de-France", 3),\n    ("03000", "Moulins", "03", "Auvergne-Rhône-Alpes", 2),\n    ("04000", "Digne-les-Bains", "04", "Provence-Alpes-Côte d\'Azur", 3),\n    ("05000", "Gap", "05", "Provence-Alpes-Côte d\'Azur", 3),\n    ("07000", "Privas", "07", "Auvergne-Rhône-Alpes", 2),\n    ("08000", "Charleville-Mézières", "08", "Grand Est", 3),\n    ("09000", "Foix", "09", "Occitanie", 2),\n    # Corse — piège T4\n    ("20000", "Ajaccio", "2A", "Corse", 4),\n    ("20090", "Ajaccio", "2A", "Corse", 4),\n    ("20200", "Bastia", "2B", "Corse", 4),\n    ("20600", "Bastia", "2B", "Corse", 4),\n    # DOM — piège T4\n    ("97200", "Fort-de-France", "972", "Martinique", 5),\n    ("97400", "Saint-Denis", "974", "La Réunion", 5),\n    ("97300", "Cayenne", "973", "Guyane", 4),\n    ("97110", "Pointe-à-Pitre", "971", "Guadeloupe", 5),\n    # autres régions\n    ("13001", "Marseille 1er", "13", "Provence-Alpes-Côte d\'Azur", 3),\n    ("13008", "Marseille 8e", "13", "Provence-Alpes-Côte d\'Azur", 3),\n    ("13100", "Aix-en-Provence", "13", "Provence-Alpes-Côte d\'Azur", 3),\n    ("69001", "Lyon 1er", "69", "Auvergne-Rhône-Alpes", 2),\n    ("69003", "Lyon 3e", "69", "Auvergne-Rhône-Alpes", 2),\n    ("69007", "Lyon 7e", "69", "Auvergne-Rhône-Alpes", 2),\n    ("31000", "Toulouse", "31", "Occitanie", 2),\n    ("31200", "Toulouse Nord", "31", "Occitanie", 2),\n    ("33000", "Bordeaux", "33", "Nouvelle-Aquitaine", 4),\n    ("33200", "Bordeaux Caudéran", "33", "Nouvelle-Aquitaine", 4),\n    ("44000", "Nantes", "44", "Pays de la Loire", 5),\n    ("44100", "Nantes Ouest", "44", "Pays de la Loire", 5),\n    ("44600", "Saint-Nazaire", "44", "Pays de la Loire", 5),\n    ("35000", "Rennes", "35", "Bretagne", 5),\n    ("29200", "Brest", "29", "Bretagne", 5),\n    ("29000", "Quimper", "29", "Bretagne", 5),\n    ("56000", "Vannes", "56", "Bretagne", 5),\n    ("59000", "Lille", "59", "Hauts-de-France", 3),\n    ("59800", "Lille Centre", "59", "Hauts-de-France", 3),\n    ("62000", "Arras", "62", "Hauts-de-France", 3),\n    ("67000", "Strasbourg", "67", "Grand Est", 3),\n    ("67200", "Strasbourg Ouest", "67", "Grand Est", 3),\n    ("68000", "Colmar", "68", "Grand Est", 3),\n    ("54000", "Nancy", "54", "Grand Est", 3),\n    ("57000", "Metz", "57", "Grand Est", 3),\n    ("21000", "Dijon", "21", "Bourgogne-Franche-Comté", 2),\n    ("25000", "Besançon", "25", "Bourgogne-Franche-Comté", 2),\n    ("38000", "Grenoble", "38", "Auvergne-Rhône-Alpes", 2),\n    ("38100", "Grenoble Sud", "38", "Auvergne-Rhône-Alpes", 2),\n    ("63000", "Clermont-Ferrand", "63", "Auvergne-Rhône-Alpes", 2),\n    ("42000", "Saint-Étienne", "42", "Auvergne-Rhône-Alpes", 2),\n    ("76000", "Rouen", "76", "Normandie", 4),\n    ("76600", "Le Havre", "76", "Normandie", 4),\n    ("14000", "Caen", "14", "Normandie", 4),\n    ("50000", "Saint-Lô", "50", "Normandie", 5),\n    ("49000", "Angers", "49", "Pays de la Loire", 4),\n    ("72000", "Le Mans", "72", "Pays de la Loire", 3),\n    ("37000", "Tours", "37", "Centre-Val de Loire", 3),\n    ("45000", "Orléans", "45", "Centre-Val de Loire", 3),\n    ("18000", "Bourges", "18", "Centre-Val de Loire", 2),\n    ("34000", "Montpellier", "34", "Occitanie", 4),\n    ("34070", "Montpellier Ouest", "34", "Occitanie", 4),\n    ("66000", "Perpignan", "66", "Occitanie", 4),\n    ("30000", "Nîmes", "30", "Occitanie", 3),\n    ("64000", "Pau", "64", "Nouvelle-Aquitaine", 3),\n    ("64200", "Biarritz", "64", "Nouvelle-Aquitaine", 4),\n    ("87000", "Limoges", "87", "Nouvelle-Aquitaine", 2),\n    ("86000", "Poitiers", "86", "Nouvelle-Aquitaine", 3),\n    ("17000", "La Rochelle", "17", "Nouvelle-Aquitaine", 5),\n    ("17300", "Rochefort", "17", "Nouvelle-Aquitaine", 5),\n    ("83000", "Toulon", "83", "Provence-Alpes-Côte d\'Azur", 3),\n    ("83400", "Hyères", "83", "Provence-Alpes-Côte d\'Azur", 3),\n    ("84000", "Avignon", "84", "Provence-Alpes-Côte d\'Azur", 3),\n    ("11000", "Carcassonne", "11", "Occitanie", 3),\n    ("19000", "Tulle", "19", "Nouvelle-Aquitaine", 2),\n    ("22000", "Saint-Brieuc", "22", "Bretagne", 5),\n    ("24000", "Périgueux", "24", "Nouvelle-Aquitaine", 3),\n    ("26000", "Valence", "26", "Auvergne-Rhône-Alpes", 2),\n    ("27000", "Évreux", "27", "Normandie", 3),\n    ("28000", "Chartres", "28", "Centre-Val de Loire", 3),\n    ("32000", "Auch", "32", "Occitanie", 2),\n    ("36000", "Châteauroux", "36", "Centre-Val de Loire", 2),\n    ("40000", "Mont-de-Marsan", "40", "Nouvelle-Aquitaine", 3),\n    ("41000", "Blois", "41", "Centre-Val de Loire", 2),\n    ("43000", "Le Puy-en-Velay", "43", "Auvergne-Rhône-Alpes", 2),\n    ("46000", "Cahors", "46", "Occitanie", 2),\n    ("47000", "Agen", "47", "Nouvelle-Aquitaine", 2),\n    ("48000", "Mende", "48", "Occitanie", 2),\n    ("51100", "Reims", "51", "Grand Est", 3),\n    ("52000", "Chaumont", "52", "Grand Est", 3),\n    ("53000", "Laval", "53", "Pays de la Loire", 3),\n    ("55000", "Bar-le-Duc", "55", "Grand Est", 3),\n    ("58000", "Nevers", "58", "Bourgogne-Franche-Comté", 2),\n    ("60000", "Beauvais", "60", "Hauts-de-France", 3),\n    ("61000", "Alençon", "61", "Normandie", 3),\n    ("65000", "Tarbes", "65", "Occitanie", 2),\n    ("70000", "Vesoul", "70", "Bourgogne-Franche-Comté", 2),\n    ("71000", "Mâcon", "71", "Bourgogne-Franche-Comté", 2),\n    ("73000", "Chambéry", "73", "Auvergne-Rhône-Alpes", 2),\n    ("74000", "Annecy", "74", "Auvergne-Rhône-Alpes", 2),\n    ("79000", "Niort", "79", "Nouvelle-Aquitaine", 3),\n    ("80000", "Amiens", "80", "Hauts-de-France", 3),\n    ("81000", "Albi", "81", "Occitanie", 2),\n    ("82000", "Montauban", "82", "Occitanie", 2),\n    ("85000", "La Roche-sur-Yon", "85", "Pays de la Loire", 5),\n    ("88000", "Épinal", "88", "Grand Est", 3),\n    ("89000", "Auxerre", "89", "Bourgogne-Franche-Comté", 2),\n    ("90000", "Belfort", "90", "Bourgogne-Franche-Comté", 2),\n]\n\ngeo_rows = [\n    [cp, commune, dept, region, str(zonier)]\n    for cp, commune, dept, region, zonier in GEO_SEED\n]\n\n# -----------------------------------------------------------------------------\n# 2. produits.csv — catalogue produits\n# -----------------------------------------------------------------------------\n# Piège T2 : commission_agent_pct en % (12,5 = 12,5%) ; frais_gestion_pct en\n# taux décimal (0,08 = 8%).\nPRODUITS = [\n    # produit_code, libellé, branche, date_lancement, commission_pct, frais_taux\n    ("MRH_ESSENTIEL",  "MRH Formule Essentiel",   "MRH",         date(2018,  1,  1), 10.0, 0.075),\n    ("MRH_CONFORT",    "MRH Formule Confort",     "MRH",         date(2018,  1,  1), 12.5, 0.080),\n    ("MRH_PREMIUM",    "MRH Formule Premium",     "MRH",         date(2018,  1,  1), 14.0, 0.090),\n    ("MRH_NEO_2024",   "MRH Néo 2024",            "MRH",         date(2024,  1, 15), 13.0, 0.085),\n    ("AUTO_TIERS",     "Auto au Tiers",           "Auto",        date(2017,  6,  1), 11.0, 0.070),\n    ("AUTO_TR",        "Auto Tous Risques",       "Auto",        date(2017,  6,  1), 13.5, 0.085),\n    ("AFF_MOBILE",     "Affinitaire Mobile",      "Affinitaire", date(2020,  3,  1),  8.0, 0.060),\n    ("AFF_VELO",       "Affinitaire Vélo",        "Affinitaire", date(2021,  4,  1),  9.0, 0.065),\n    ("AFF_VOYAGE",     "Affinitaire Voyage",      "Affinitaire", date(2019,  9,  1),  9.5, 0.070),\n]\n\nproduits_rows = []\nfor code, libelle, branche, dlanc, comm, frais in PRODUITS:\n    produits_rows.append([\n        code,\n        libelle,\n        branche,\n        fr_date(dlanc),\n        fr_decimal(comm, 2),    # 12,50 — POURCENTAGE\n        fr_decimal(frais, 3),   # 0,080 — TAUX DÉCIMAL (piège T2)\n    ])\n\n# liste des codes produits MRH (pour le scénario MRH du brief)\nMRH_CODES = [p[0] for p in PRODUITS if p[2] == "MRH"]\nNEW_FORMULA = "MRH_NEO_2024"\n\n# -----------------------------------------------------------------------------\n# 3. clients.csv — référentiel souscripteurs\n# -----------------------------------------------------------------------------\nN_CLIENTS = 600\nCSP_CHOICES = ["Cadre", "Profession intermédiaire", "Employé", "Ouvrier",\n               "Retraité", "Indépendant", "Étudiant", "Sans activité"]\nCSP_WEIGHTS = [0.22, 0.18, 0.25, 0.10, 0.15, 0.06, 0.02, 0.02]\nGENRE_CHOICES = ["F", "M", "NC"]\nGENRE_WEIGHTS = [0.49, 0.49, 0.02]\n\ngeo_codes = [g[0] for g in GEO_SEED]\n\nclients_rows = []\nclients_ids = []\nfor i in range(1, N_CLIENTS + 1):\n    cid = f"CLI-{i:06d}"\n    clients_ids.append(cid)\n    annee_naissance = int(np.clip(np.random.normal(1975, 16), 1935, 2005))\n    genre = random.choices(GENRE_CHOICES, weights=GENRE_WEIGHTS)[0]\n    csp = random.choices(CSP_CHOICES, weights=CSP_WEIGHTS)[0]\n    # date d\'entrée en relation entre 2015 et fin 2024\n    days = random.randint(0, (date(2024, 12, 31) - date(2015, 1, 1)).days)\n    der = date(2015, 1, 1) + timedelta(days=days)\n    cp_res = random.choice(geo_codes)\n    score = round(float(np.clip(np.random.beta(2, 5), 0.01, 0.99)), 2)\n    clients_rows.append([\n        cid,\n        str(annee_naissance),\n        genre,\n        csp,\n        fr_date(der),\n        cp_res,\n        fr_decimal(score, 2),\n    ])\n\n# -----------------------------------------------------------------------------\n# 4. polices.csv — portefeuille\n# -----------------------------------------------------------------------------\n# 36 mois d\'historique : production de janvier 2022 à fin 2024.\n# Date d\'analyse implicite : 2024-12-31.\nANALYSIS_DATE = date(2024, 12, 31)\nHISTORY_START = date(2022, 1, 1)\n\nN_POLICES = 700\npolices_rows = []\npolices_records = []  # mémoire pour générer les sinistres\n\nCANAUX = ["Agent", "Direct"]\nCANAUX_WEIGHTS = [0.62, 0.38]\n\n# Mapping produit -> formules possibles\nFORMULES_BY_PRODUIT = {\n    "MRH_ESSENTIEL":  ["Essentiel"],\n    "MRH_CONFORT":    ["Confort"],\n    "MRH_PREMIUM":    ["Premium"],\n    "MRH_NEO_2024":   ["Confort", "Premium"],\n    "AUTO_TIERS":     ["Essentiel"],\n    "AUTO_TR":        ["Tous Risques"],\n    "AFF_MOBILE":     ["Essentiel", "Confort"],\n    "AFF_VELO":       ["Essentiel", "Confort"],\n    "AFF_VOYAGE":     ["Essentiel", "Confort"],\n}\n\n# Distribution des produits — biaisée MRH car le scénario porte sur MRH\nPRODUIT_CHOICES = [p[0] for p in PRODUITS]\nPRODUIT_WEIGHTS = [\n    0.18,  # MRH_ESSENTIEL\n    0.22,  # MRH_CONFORT\n    0.10,  # MRH_PREMIUM\n    0.10,  # MRH_NEO_2024\n    0.08,  # AUTO_TIERS\n    0.10,  # AUTO_TR\n    0.07,  # AFF_MOBILE\n    0.07,  # AFF_VELO\n    0.08,  # AFF_VOYAGE\n]\n\nMOTIFS_RESIL = ["Loi Hamon", "Échéance annuelle", "Non-paiement", "Sinistre", "Déménagement"]\nMOTIFS_WEIGHTS = [0.35, 0.30, 0.15, 0.10, 0.10]\n\n# Primes typiques par produit (centre)\nPRIME_CENTER = {\n    "MRH_ESSENTIEL":  220.0,\n    "MRH_CONFORT":    340.0,\n    "MRH_PREMIUM":    520.0,\n    "MRH_NEO_2024":   360.0,\n    "AUTO_TIERS":     480.0,\n    "AUTO_TR":        780.0,\n    "AFF_MOBILE":      85.0,\n    "AFF_VELO":       110.0,\n    "AFF_VOYAGE":      55.0,\n}\n\nfor i in range(1, N_POLICES + 1):\n    annee = random.choice([2022, 2023, 2024])\n    pid = f"POL-{annee}-{i:06d}"\n    cid = random.choice(clients_ids)\n    produit = random.choices(PRODUIT_CHOICES, weights=PRODUIT_WEIGHTS)[0]\n    formule = random.choice(FORMULES_BY_PRODUIT[produit])\n    canal = random.choices(CANAUX, weights=CANAUX_WEIGHTS)[0]\n    cp = random.choice(geo_codes)\n\n    # date d\'effet — pour MRH_NEO_2024, après la date de lancement (2024-01-15)\n    if produit == "MRH_NEO_2024":\n        de_start = date(2024, 1, 15)\n    else:\n        de_start = HISTORY_START\n    de_days = (ANALYSIS_DATE - de_start).days\n    if de_days <= 0:\n        de_days = 30\n    date_effet = de_start + timedelta(days=random.randint(0, de_days))\n\n    # statut & résiliation\n    r = random.random()\n    if r < 0.78:\n        statut = "En cours"\n        date_resil = None\n        motif = ""\n    elif r < 0.96:\n        statut = "Résilié"\n        # résiliation entre date_effet + 60 jours et analysis_date\n        min_resil = date_effet + timedelta(days=60)\n        if min_resil > ANALYSIS_DATE:\n            # police trop récente, on bascule en cours\n            statut = "En cours"\n            date_resil = None\n            motif = ""\n        else:\n            resil_span = (ANALYSIS_DATE - min_resil).days\n            date_resil = min_resil + timedelta(days=random.randint(0, resil_span))\n            motif = random.choices(MOTIFS_RESIL, weights=MOTIFS_WEIGHTS)[0]\n    else:\n        statut = "Suspendu"\n        date_resil = None\n        motif = ""\n\n    # prime annuelle TTC ~ centre +/- bruit, modulée par formule et zonier\n    base = PRIME_CENTER[produit]\n    if formule == "Premium":\n        base *= 1.25\n    elif formule == "Tous Risques":\n        base *= 1.15\n    bruit = np.random.normal(1.0, 0.18)\n    prime = max(60.0, base * max(0.6, bruit))\n    prime = round(prime, 2)\n\n    polices_rows.append([\n        pid,\n        cid,\n        produit,\n        cp,\n        canal,\n        fr_date(date_effet),\n        fr_date(date_resil) if date_resil else "",\n        motif,\n        fr_decimal(prime, 2),\n        formule,\n        statut,\n    ])\n    polices_records.append({\n        "police_id": pid,\n        "produit": produit,\n        "formule": formule,\n        "canal": canal,\n        "cp": cp,\n        "date_effet": date_effet,\n        "date_resil": date_resil,\n        "statut": statut,\n        "prime": prime,\n    })\n\n# -----------------------------------------------------------------------------\n# 5. sinistres.csv — sinistres déclarés\n# -----------------------------------------------------------------------------\n# Les MRH dominent ; la nouvelle formule MRH_NEO_2024 a une fréquence et un\n# coût moyen sensiblement plus élevés (anti-sélection / tarification) : c\'est\n# le signal central de la question analytique du brief.\nsinistres_rows = []\nsin_counter = 0\n\n# Natures par branche\nNATURES_MRH = ["Dégât des eaux", "Incendie", "Vol", "Bris de glace",\n               "Tempête", "Catastrophe naturelle", "Autre"]\nNATURES_MRH_W = [0.42, 0.06, 0.14, 0.18, 0.10, 0.05, 0.05]\n\nNATURES_AUTO = ["Collision", "Vol", "Bris de glace", "Tempête", "Autre"]\nNATURES_AUTO_W = [0.55, 0.10, 0.20, 0.05, 0.10]\n\nNATURES_AFF = ["Vol", "Bris de glace", "Autre"]\nNATURES_AFF_W = [0.50, 0.30, 0.20]\n\n# Coûts moyens (lognormale) par nature\nCOST_PARAMS = {\n    # mu, sigma de log-normale (en EUR)\n    "Dégât des eaux":         (7.0, 0.9),\n    "Incendie":               (8.5, 1.0),\n    "Vol":                    (6.8, 0.9),\n    "Bris de glace":          (5.6, 0.7),\n    "Tempête":                (7.2, 0.9),\n    "Catastrophe naturelle":  (8.0, 1.0),\n    "Collision":              (7.4, 0.9),\n    "Autre":                  (6.5, 0.8),\n}\n\nSTATUTS_SIN = ["Ouvert", "En cours d\'instruction", "Clos", "Sans suite"]\nGESTIONNAIRES = [f"GEST-{n:03d}" for n in range(1, 26)]\n\nfor pol in polices_records:\n    # Exposition en jours sur la période d\'analyse\n    start = max(pol["date_effet"], HISTORY_START)\n    end = pol["date_resil"] if pol["date_resil"] else ANALYSIS_DATE\n    if end <= start:\n        continue\n    expo_years = (end - start).days / 365.25\n\n    # fréquence par produit\n    if pol["produit"].startswith("MRH"):\n        base_freq = 0.18\n        if pol["produit"] == NEW_FORMULA:\n            base_freq *= 1.55  # signal nouvelle formule (anti-sélection)\n        if pol["canal"] == "Direct":\n            base_freq *= 1.15\n        natures, weights = NATURES_MRH, NATURES_MRH_W\n    elif pol["produit"].startswith("AUTO"):\n        base_freq = 0.22\n        natures, weights = NATURES_AUTO, NATURES_AUTO_W\n    else:\n        base_freq = 0.08\n        natures, weights = NATURES_AFF, NATURES_AFF_W\n\n    lam = base_freq * expo_years\n    n_sin = np.random.poisson(lam)\n\n    for _ in range(n_sin):\n        sin_counter += 1\n        annee_sin = random.choice([2022, 2023, 2024])\n        sid = f"SIN-{annee_sin}-{sin_counter:07d}"\n        # date survenance dans la fenêtre d\'exposition\n        span = (end - start).days\n        if span <= 0:\n            continue\n        d_surv = start + timedelta(days=random.randint(0, span))\n        # déclaration : 0 à 25 jours après survenance\n        d_decl = d_surv + timedelta(days=int(np.clip(np.random.exponential(4), 0, 60)))\n        if d_decl > ANALYSIS_DATE:\n            d_decl = ANALYSIS_DATE\n\n        nature = random.choices(natures, weights=weights)[0]\n        mu, sigma = COST_PARAMS[nature]\n        cost = float(np.random.lognormal(mu, sigma))\n\n        # surcoût pour la nouvelle formule (signal coût moyen)\n        if pol["produit"] == NEW_FORMULA:\n            cost *= 1.30\n\n        cost = round(min(cost, 250000.0), 2)\n\n        # statut & clôture\n        # Plus le sinistre est récent, plus il a de chances d\'être ouvert.\n        days_since_decl = (ANALYSIS_DATE - d_decl).days\n        if days_since_decl < 30:\n            p_open = 0.75\n        elif days_since_decl < 90:\n            p_open = 0.40\n        elif days_since_decl < 180:\n            p_open = 0.18\n        else:\n            p_open = 0.06\n\n        rr = random.random()\n        if rr < p_open:\n            # ouvert / instruction\n            statut_sin = random.choices(\n                ["Ouvert", "En cours d\'instruction"], weights=[0.55, 0.45]\n            )[0]\n            d_clot = None\n        elif rr < p_open + 0.04:\n            statut_sin = "Sans suite"\n            # clos rapidement\n            d_clot = d_decl + timedelta(days=random.randint(5, 40))\n            cost = round(cost * 0.05, 2)  # quasi rien\n        else:\n            statut_sin = "Clos"\n            # délai de règlement réaliste : 15 à 180 jours, médiane ~55\n            delai = int(np.clip(np.random.lognormal(4.0, 0.6), 7, 400))\n            d_clot = d_decl + timedelta(days=delai)\n            if d_clot > ANALYSIS_DATE:\n                d_clot = ANALYSIS_DATE\n\n        # recours / subrogation : surtout sur Vol, Collision, Dégât des eaux\n        recours = 0.0\n        if nature in ("Vol", "Collision", "Dégât des eaux") and random.random() < 0.20:\n            recours = round(cost * random.uniform(0.05, 0.40), 2)\n\n        # IBNR / sous-provisionnement implicite : la charge est ce qu\'elle est —\n        # le piège T3 est métier (statut Ouvert => provision), pas une mutation.\n\n        gest = random.choice(GESTIONNAIRES)\n\n        sinistres_rows.append([\n            sid,\n            pol["police_id"],\n            iso_date(d_surv),                     # ISO — piège T1\n            iso_date(d_decl),                     # ISO — piège T1\n            iso_date(d_clot) if d_clot else "",   # ISO — piège T1\n            nature,\n            fr_decimal(cost, 2),                  # virgule décimale\n            fr_decimal(recours, 2),\n            statut_sin,\n            gest,\n        ])\n\n# Garde-fou : on veut entre 300 et 800 sinistres ; sinon on tronque ou on log.\n# (En pratique avec ces paramètres on tombe ~400-650.)\nif len(sinistres_rows) > 800:\n    sinistres_rows = random.sample(sinistres_rows, 800)\n\n\n# -----------------------------------------------------------------------------\n# Écriture des fichiers\n# -----------------------------------------------------------------------------\nprint("Génération des CSV dans :", OUT_DIR)\n\nwrite_csv(\n    "geographie.csv",\n    ["code_postal", "commune", "departement", "region", "zonier_tempete"],\n    geo_rows,\n)\n\nwrite_csv(\n    "produits.csv",\n    ["produit_code", "produit_libelle", "branche", "date_lancement",\n     "commission_agent_pct", "frais_gestion_pct"],\n    produits_rows,\n)\n\nwrite_csv(\n    "clients.csv",\n    ["client_id", "annee_naissance", "genre", "csp",\n     "date_entree_relation", "code_postal_residence", "score_risque"],\n    clients_rows,\n)\n\nwrite_csv(\n    "polices.csv",\n    ["police_id", "client_id", "produit_code", "code_postal",\n     "canal_distribution", "date_effet", "date_resiliation",\n     "motif_resiliation", "prime_annuelle_ttc", "formule", "statut_contrat"],\n    polices_rows,\n)\n\nwrite_csv(\n    "sinistres.csv",\n    ["sinistre_id", "police_id", "date_survenance", "date_declaration",\n     "date_cloture", "nature_sinistre", "montant_charge", "montant_recours",\n     "statut_sinistre", "gestionnaire_id"],\n    sinistres_rows,\n)\n\nprint("\\nRécapitulatif :")\nprint(f"  geographie.csv : {len(geo_rows)} lignes")\nprint(f"  produits.csv   : {len(produits_rows)} lignes")\nprint(f"  clients.csv    : {len(clients_rows)} lignes")\nprint(f"  polices.csv    : {len(polices_rows)} lignes")\nprint(f"  sinistres.csv  : {len(sinistres_rows)} lignes")\nprint("\\nPièges injectés :")\nprint("  T1 — dates FR (polices/clients/produits) vs ISO (sinistres) : OK")\nprint("  T2 — produits.commission_agent_pct (%) vs frais_gestion_pct (taux) : OK")\nprint("  T3 — sinistres.montant_charge inclut provisions sur sinistres ouverts : OK")\nprint("  T4 — codes postaux texte avec zéros initiaux (01, 02, 06, 20xxx, 97xxx) : OK")\n'}, 'id': 'toolu_01MmzkSraG1Q54XeWAzbiJCh', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 10516, 'output_tokens': 11933, 'total_tokens': 22449, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral
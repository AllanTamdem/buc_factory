ile', 'args': {'path': 'brief/data_schema.json'}, 'id': 'toolu_017omV8E87MiZiFP9jxJNoqL', 'type': 'tool_call'}, {'name': 'read_file', 'args': {'path': 'brief/candidate_brief.md'}, 'id': 'toolu_017XrGKjJxaa5JzMrBLTyGUf', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 2907, 'output_tokens': 125, 'total_tokens': 3032, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='{\n  "files": [\n    {\n      "filename": "clients.csv",\n      "columns": [\n        {"name": "client_id", "type": "string", "example": "CLI000123", "semantics": "Identifiant unique du client (sociétaire)", "is_pk": true, "fk_to": null},\n        {"name": "date_naissance", "type": "date", "example": "14/03/1978", "semantics": "Date de naissance au format français JJ/MM/AAAA", "is_pk": false, "fk_to": null},\n        {"name": "genre", "type": "string", "example": "F", "semantics": "Genre déclaré (F / M / NC)", "is_pk": false, "fk_to": null},\n        {"name": "code_postal", "type": "string", "example": "75011", "semantics": "Code postal de résidence principale (5 caractères, peut commencer par 0)", "is_pk": false, "fk_to": "geographie.code_postal"},\n        {"name": "date_entree_relation", "type": "date", "example": "02/09/2017", "semantics": "Date du premier contrat souscrit (entrée en relation)", "is_pk": false, "fk_to": null},\n        {"name": "csp", "type": "string", "example": "Cadre", "semantics": "Catégorie socio-professionnelle déclarée", "is_pk": false, "fk_to": null},\n        {"name": "canal_acquisition", "type": "string", "example": "Agent", "semantics": "Canal d\'acquisition initial : Agent / Direct web / Comparateur / Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "email_optin", "type": "string", "example": "Oui", "semantics": "Consentement marketing (Oui / Non)", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "geographie.csv",\n      "columns": [\n        {"name": "code_postal", "type": "string", "example": "75011", "semantics": "Code postal français (5 caractères, conserver le zéro initial)", "is_pk": true, "fk_to": null},\n        {"name": "commune", "type": "string", "example": "Paris 11e", "semantics": "Libellé de la commune principale rattachée au code postal", "is_pk": false, "fk_to": null},\n        {"name": "departement", "type": "string", "example": "75", "semantics": "Code département INSEE (2 ou 3 caractères, ex. 75, 2A, 974)", "is_pk": false, "fk_to": null},\n        {"name": "region", "type": "string", "example": "Île-de-France", "semantics": "Région administrative", "is_pk": false, "fk_to": null},\n        {"name": "zonier_tempete", "type": "string", "example": "Z3", "semantics": "Zonier interne risque tempête / événement climatique (Z1 faible à Z5 fort)", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "produits.csv",\n      "columns": [\n        {"name": "produit_id", "type": "string", "example": "PRD-MRH-CONF", "semantics": "Identifiant produit", "is_pk": true, "fk_to": null},\n        {"name": "branche", "type": "string", "example": "MRH", "semantics": "Branche : MRH / Auto / Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "formule", "type": "string", "example": "Confort", "semantics": "Niveau de garantie (Essentiel / Confort / Premium)", "is_pk": false, "fk_to": null},\n        {"name": "date_lancement", "type": "date", "example": "01/01/2015", "semantics": "Date de lancement commercial de la formule", "is_pk": false, "fk_to": null},\n        {"name": "franchise_eur", "type": "decimal", "example": "150.00", "semantics": "Franchise contractuelle en euros", "is_pk": false, "fk_to": null},\n        {"name": "actif", "type": "string", "example": "Oui", "semantics": "Produit encore commercialisé (Oui / Non)", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "polices.csv",\n      "columns": [\n        {"name": "police_id", "type": "string", "example": "POL00045821", "semantics": "Identifiant unique du contrat (police)", "is_pk": true, "fk_to": null},\n        {"name": "client_id", "type": "string", "example": "CLI000123", "semantics": "Client souscripteur", "is_pk": false, "fk_to": "clients.client_id"},\n        {"name": "produit_id", "type": "string", "example": "PRD-MRH-CONF", "semantics": "Produit / formule souscrit", "is_pk": false, "fk_to": "produits.produit_id"},\n        {"name": "code_postal_risque", "type": "string", "example": "75011", "semantics": "Code postal du bien ou véhicule assuré", "is_pk": false, "fk_to": "geographie.code_postal"},\n        {"name": "date_effet", "type": "date", "example": "15/06/2022", "semantics": "Date d\'effet du contrat (JJ/MM/AAAA)", "is_pk": false, "fk_to": null},\n        {"name": "date_resiliation", "type": "date", "example": "14/06/2024", "semantics": "Date de résiliation effective (vide si contrat en cours)", "is_pk": false, "fk_to": null},\n        {"name": "motif_resiliation", "type": "string", "example": "Loi Hamon", "semantics": "Motif si résilié : Loi Hamon / Châtel / Non-paiement / Sinistre / Déménagement / Autre", "is_pk": false, "fk_to": null},\n        {"name": "prime_annuelle_ttc", "type": "decimal", "example": "486,50", "semantics": "Prime annuelle TTC en euros (séparateur décimal virgule, format français)", "is_pk": false, "fk_to": null},\n        {"name": "capital_assure", "type": "decimal", "example": "150000.00", "semantics": "Capital assuré ou valeur du véhicule en euros", "is_pk": false, "fk_to": null},\n        {"name": "canal_souscription", "type": "string", "example": "Agent", "semantics": "Canal de souscription : Agent / Direct web / Comparateur / Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "statut", "type": "string", "example": "En cours", "semantics": "Statut courant du contrat : En cours / Résilié / Suspendu", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "sinistres.csv",\n      "columns": [\n        {"name": "sinistre_id", "type": "string", "example": "SIN0000234567", "semantics": "Identifiant unique du sinistre", "is_pk": true, "fk_to": null},\n        {"name": "police_id", "type": "string", "example": "POL00045821", "semantics": "Contrat sur lequel le sinistre est rattaché", "is_pk": false, "fk_to": "polices.police_id"},\n        {"name": "date_survenance", "type": "date", "example": "03/11/2023", "semantics": "Date de survenance du sinistre (JJ/MM/AAAA)", "is_pk": false, "fk_to": null},\n        {"name": "date_declaration", "type": "date", "example": "06/11/2023", "semantics": "Date de déclaration par l\'assuré", "is_pk": false, "fk_to": null},\n        {"name": "date_cloture", "type": "date", "example": "22/02/2024", "semantics": "Date de clôture du dossier (vide si encore ouvert)", "is_pk": false, "fk_to": null},\n        {"name": "nature_sinistre", "type": "string", "example": "Dégât des eaux", "semantics": "Typologie : Dégât des eaux / Incendie / Vol / Bris de glace / Collision / Tempête / Autre", "is_pk": false, "fk_to": null},\n        {"name": "montant_paye", "type": "decimal", "example": "1245.00", "semantics": "Montant total déjà réglé à l\'assuré ou au tiers en euros", "is_pk": false, "fk_to": null},\n        {"name": "provision_dossier", "type": "decimal", "example": "800.00", "semantics": "Provision restant à payer (réserve dossier/dossier ouvert) en euros", "is_pk": false, "fk_to": null},\n        {"name": "recours_encaisse", "type": "decimal", "example": "0.00", "semantics": "Montant des recours / subrogations encaissés en euros (à déduire du coût)", "is_pk": false, "fk_to": null},\n        {"name": "statut_dossier", "type": "string", "example": "Clos", "semantics": "Statut : Ouvert / En cours / Clos / Sans suite", "is_pk": false, "fk_to": null},\n        {"name": "responsabilite", "type": "string", "example": "100%", "semantics": "Taux de responsabilité de l\'assuré (auto principalement)", "is_pk": false, "fk_to": null}\n      ]\n    }\n  ],\n  "traps": [\n    {\n      "file": "polices.csv",\n      "column": "prime_annuelle_ttc",\n      "trap": "Le montant est stocké au format français avec virgule décimale (ex. \'486,50\') et quelques lignes incluent un séparateur de milliers espace insécable (ex. \'1 250,00\'). À l\'import par défaut, Power BI typera la colonne en texte ou produira des erreurs de conversion silencieuses ; un candidat senior doit forcer la locale \'Français (France)\' dans Power Query ou nettoyer la colonne avant typage.",\n      "why_realistic": "Les exports depuis les SI de gestion français (ex. outils internes ou extractions Excel FR) renvoient quasi systématiquement la virgule décimale et parfois l\'espace milliers, alors que la plupart des connecteurs assument une locale en-US."\n    },\n    {\n      "file": "geographie.csv",\n      "column": "code_postal",\n      "trap": "Le code postal est numérique en apparence mais doit rester en texte : les codes commençant par 0 (départements 01-09, ex. \'01000\' Bourg-en-Bresse, \'06000\' Nice) perdent leur zéro initial si la colonne est typée en entier, ce qui casse la jointure avec polices.code_postal_risque et clients.code_postal.",\n      "why_realistic": "C\'est l\'un des pièges les plus classiques sur des données françaises (codes postaux, SIREN, numéros de département corses 2A/2B) — un analyste senior doit le repérer immédiatement et forcer le type texte dès l\'import."\n    },\n    {\n      "file": "sinistres.csv",\n      "column": "montant_paye",\n      "trap": "Le coût total d\'un sinistre n\'est PAS égal à montant_paye seul : il faut calculer charge_sinistre = montant_paye + provision_dossier - recours_encaisse. Par ailleurs, une partie des dossiers ont statut_dossier = \'Clos\' avec provision_dossier > 0 (provisions non soldées suite à migration SI) et certains montant_paye sont en doublon car des avenants de règlement sont enregistrés comme nouvelles lignes plutôt qu\'agrégés.",\n      "why_realistic": "En P&C, la charge sinistre = payé + provision (- recours) est une définition métier fondamentale ; oublier la provision sous-estime massivement le S/P. Les incohérences post-migration SI sont également un cas vécu fréquent en assurance."\n    }\n  ]\n}\n', name='read_file', tool_call_id='toolu_017omV8E87MiZiFP9jxJNoqL'), ToolMessage(content="# Évaluation technique – Data Analyst Mid/Senior\n## Brief candidat – Power BI Desktop\n\n**Durée : 75 minutes — Outil imposé : Power BI Desktop — Livrable : projet PBIP**\n\n---\n\n## 1. Contexte business\n\nVous rejoignez pour cette évaluation une compagnie d'assurance **IARD (dommages aux biens et responsabilités)** de taille intermédiaire, basée à Paris, qui sert exclusivement une clientèle de **particuliers en France**. L'entreprise compte environ 500 collaborateurs et commercialise trois familles de produits : **Multirisque Habitation (MRH)**, **Auto particuliers** et **garanties affinitaires** (mobile, vélo, voyage). La distribution se fait via un **réseau d'agents liés** et un **canal direct en ligne**.\n\nLe périmètre de la mission porte spécifiquement sur la **branche Auto particuliers**, qui représente le moteur de la rentabilité technique mais qui inquiète aujourd'hui la direction. La compagnie a en effet **migré récemment son système d'information de gestion** (bascule de l'ancien outil de production vers une nouvelle plateforme). Depuis cette bascule, le COMEX constate des indicateurs « bizarres » : ratios qui dérivent, lignes de portefeuille qui semblent dupliquées ou orphelines, sinistres déclarés sans police clairement rattachée. La Direction Technique soupçonne autant un **vrai problème de qualité du portefeuille** (anti-sélection, sur-représentation de certains profils risqués) qu'un **artefact de migration** mal maîtrisé.\n\nVous disposez d'un **historique de 48 mois** et d'un portefeuille d'environ **50 000 polices Auto**.\n\n## 2. Mission\n\nVous êtes mandaté pour produire un **rapport COMEX synthétique (1 à 2 pages)** dans Power BI, dont l'objectif est de **détecter les anomalies et qualifier la qualité du portefeuille Auto** post-migration.\n\n### 2.1 KPIs attendus (3 à 5, à afficher et à interpréter)\n\n1. **Fréquence sinistres** : nombre de sinistres survenus sur la période, rapporté au nombre de polices-années exposées.\n2. **Coût moyen sinistre** : montant total des sinistres (réglé + provisionné) divisé par le nombre de sinistres.\n3. **Ratio S/P (sinistres sur primes)** : charge sinistres totale rapportée aux primes acquises sur la même période.\n4. **Taux d'anomalies portefeuille** : part des polices présentant au moins une anomalie de données (sinistre orphelin, doublon client, date d'effet incohérente, prime nulle ou négative…) sur le total du portefeuille.\n5. **Évolution mensuelle du portefeuille actif** : nombre de polices en cours par mois, avec mise en évidence visuelle de la date de bascule SI.\n\n### 2.2 Visualisations exigées (2 à 4)\n\n- Une **courbe d'évolution mensuelle** (portefeuille actif et/ou S/P) couvrant les 48 mois, avec un repère visuel de la migration SI.\n- Un **visuel de répartition** (barres ou treemap) du portefeuille ou de la sinistralité par segment pertinent (zone géographique, ancienneté, canal de distribution, formule).\n- Un **tableau ou matrice « top anomalies »** listant les cas suspects à investiguer (police, type d'anomalie, montant impacté).\n\n### 2.3 Exigence de modélisation (1)\n\nConstruire un **modèle en étoile** propre dans Power BI : table de faits (sinistres et/ou polices) reliée aux dimensions (clients, produits, géographie, calendrier). La table calendrier doit être **marquée comme table de dates** et permettre les analyses temporelles.\n\n### 2.4 Exigence qualité de données (1)\n\nDocumenter explicitement **au moins trois contrôles de qualité** réalisés sur les données (ex. doublons sur identifiant police, sinistres sans police rattachée, dates d'effet postérieures à la date de survenance, primes hors borne) et chiffrer leur impact.\n\n### 2.5 Question analytique ouverte (1)\n\n> *Selon vous, les dérives observées s'expliquent-elles davantage par un **problème de qualité de données lié à la migration SI**, ou par une **dégradation réelle du risque** sur le portefeuille Auto ? Justifiez avec deux ou trois éléments chiffrés issus de votre analyse.*\n\n## 3. Données fournies (CSV)\n\nTous les fichiers sont en UTF-8, séparateur virgule, en-tête en première ligne.\n\n- **policies.csv** — Référentiel des polices Auto.\n  Colonnes : `policy_id` (clé, texte), `client_id` (FK), `product_code` (FK), `geo_code` (FK), `channel` (texte : agent / direct), `start_date` (date), `end_date` (date, nullable), `annual_premium_eur` (décimal), `vehicle_category` (texte), `source_system` (texte : legacy / new).\n\n- **claims.csv** — Sinistres déclarés.\n  Colonnes : `claim_id` (clé), `policy_id` (FK), `loss_date` (date), `report_date` (date), `claim_status` (ouvert / clos / refusé), `paid_amount_eur` (décimal), `reserve_amount_eur` (décimal), `claim_type` (collision, vol, bris de glace, RC…).\n\n- **clients.csv** — Référentiel clients.\n  Colonnes : `client_id` (clé), `birth_year` (entier), `client_since` (date), `customer_segment` (texte).\n\n- **products.csv** — Catalogue produits.\n  Colonnes : `product_code` (clé), `product_label` (texte), `formula_tier` (éco / standard / premium).\n\n- **geography.csv** — Référentiel géographique France.\n  Colonnes : `geo_code` (clé, code département), `department_name`, `region_name`.\n\n> ⚠️ Les données portent les traces de la migration SI : doublons potentiels, clés orphelines et incohérences de dates sont à anticiper.\n\n## 4. Livrable attendu\n\nUn **projet Power BI Desktop au format PBIP** contenant :\n- le modèle de données (étoile, relations explicites, table calendrier),\n- les mesures DAX nommées et commentées pour chaque KPI,\n- un **rapport de 1 à 2 pages** orienté COMEX, lisible sans explication orale,\n- une zone de commentaire (zone de texte ou page d'annexe) résumant en 5 à 10 lignes votre réponse à la question analytique ouverte et les contrôles qualité réalisés.\n\n## 5. Critères d'évaluation (total : 100 points)\n\n| Critère | Points |\n|---|---|\n| Pertinence et exactitude des KPIs (formules, dénominateurs, période) | 25 |\n| Qualité du modèle de données (étoile, relations, table calendrier) | 20 |\n| Détection et documentation des anomalies / contrôles qualité | 20 |\n| Qualité de restitution COMEX (clarté, hiérarchie de l'information, design) | 15 |\n| Profondeur de l'analyse et réponse à la question ouverte | 15 |\n| Bonnes pratiques Power BI (nommage, mesures vs colonnes, performance) | 5 |\n\n## 6. Contraintes pratiques\n\n- **Temps imparti : 75 minutes**, montre en main.\n- **Outils interdits** : aucun assistant d'IA générative (ChatGPT, Copilot, Gemini, etc.). La documentation officielle Microsoft Power BI et les moteurs de recherche classiques sont autorisés.\n- Travail **individuel**, sans échange avec d'autres candidats.\n- Si une donnée vous semble manquante ou douteuse, **formulez une hypothèse explicite** dans le rapport plutôt que de bloquer.\n", name='read_file', tool_call_id='toolu_017XrGKjJxaa5JzMrBLTyGUf'), AIMessage(content=[{'text': "Note: The candidate brief mentions slightly different filenames (policies.csv, etc. in English) than the actual data (polices.csv in French). I'll align with the actual schema since that's what the candidate gets. Let me write the recruiter solution.", 'type': 'text'}, {'id': 'toolu_01HPB6LiWJAt5c8GxbN6zPeC', 'caller': {'type': 'direct'}, 'input': {'path': 'solution/recruiter_solution.md', 'content': '# Solution de référence – Évaluation Data Analyst Mid/Senior\n## Branche Auto particuliers – Détection d\'anomalies post-migration SI\n\n> Document **interne recruteur**. À ne pas remettre au candidat.\n> Sert à (i) calibrer la correction, (ii) animer le débrief, (iii) harmoniser\n> la notation entre évaluateurs.\n\n---\n\n## 1. Modèle de données cible (schéma en étoile)\n\n### 1.1 Schéma attendu\n\n```\n                ┌──────────────┐\n                │  Calendrier  │  (table de dates marquée)\n                └──────┬───────┘\n                       │ 1\n                       │\n                       ▼ *\n┌────────────┐ * ┌──────────────┐ * ┌─────────────┐\n│  Clients   │◄──┤   Polices    │──►│  Produits   │\n└────────────┘ 1 │  (FAIT 1)    │ 1 └─────────────┘\n                 └──────┬───────┘\n                        │ 1\n                        │\n                        ▼ *\n                 ┌──────────────┐\n                 │  Sinistres   │  (FAIT 2)\n                 └──────┬───────┘\n                        │ *\n                        ▼ 1\n                 ┌──────────────┐\n                 │  Géographie  │  (rôle multiple : risque / résidence)\n                 └──────────────┘\n```\n\n### 1.2 Relations attendues\n\n| De | Vers | Cardinalité | Sens du filtre | Active ? | Justification |\n|---|---|---|---|---|---|\n| `polices[client_id]` | `clients[client_id]` | * → 1 | Mono-directionnel | Oui | Un client a 0..n polices |\n| `polices[produit_id]` | `produits[produit_id]` | * → 1 | Mono | Oui | Catalogue produit standard |\n| `polices[code_postal_risque]` | `geographie[code_postal]` | * → 1 | Mono | **Oui (active)** | Le risque est porté par le bien/véhicule, pas par le domicile |\n| `clients[code_postal]` | `geographie[code_postal]` | * → 1 | Mono | **Inactive** (USERELATIONSHIP) | Évite l\'ambiguïté avec la relation polices→géographie |\n| `sinistres[police_id]` | `polices[police_id]` | * → 1 | Mono | Oui | Un sinistre est rattaché à une police |\n| `polices[date_effet]` | `Calendrier[Date]` | * → 1 | Mono | Oui (active) | Mesures portefeuille indexées sur date d\'effet |\n| `sinistres[date_survenance]` | `Calendrier[Date]` | * → 1 | Mono | Oui (active) | Sinistralité indexée sur date de survenance |\n\n### 1.3 Justifications « senior »\n\n- **Pas de bidirectionnel par défaut** : les filtres bidirectionnels sont à\n  proscrire (ambiguïté + perf). Les rares cas (filtrer Clients par\n  l\'existence d\'un sinistre) se traitent en DAX (`CALCULATE` + `TREATAS` ou\n  `CROSSFILTER` localisé dans une mesure).\n- **Deux faits, pas un seul** : Polices et Sinistres sont à granularité\n  différente (1 ligne / police vs 1 ligne / sinistre). Les fusionner casse\n  les KPI de fréquence. Un candidat senior conserve les deux faits liés via\n  `police_id`.\n- **Calendrier custom** : généré en DAX (`CALENDAR(MIN, MAX)`) ou Power\n  Query, marqué via *Mark as Date Table*. Indispensable pour\n  `DATESINPERIOD`, `SAMEPERIODLASTYEAR`, intelligence temporelle.\n- **Code postal en clé** : voir piège n°2 (zéro initial). Le candidat doit\n  forcer le type texte côté geographie.csv ET côté polices.csv /\n  clients.csv avant de créer la relation.\n- **Sinistres orphelins** : la relation polices → sinistres révélera des\n  *blank rows* dans la table virtuelle si des `police_id` côté sinistres\n  n\'existent pas dans polices. C\'est précisément un signal d\'anomalie\n  post-migration que l\'on veut quantifier (KPI 4).\n\n---\n\n## 2. Mesures DAX de référence\n\n> Toutes les mesures sont regroupées dans une table déconnectée\n> `_Mesures` pour la lisibilité. Format `[Nom KPI]` en français.\n\n### 2.1 Mesures de base\n\n```DAX\n-- ─── PORTEFEUILLE ─────────────────────────────────────────────────\n\n[Nb polices] :=\nCOUNTROWS ( polices )\n-- Comptage brut, sans filtre statut. À utiliser pour QA, pas pour\n-- les KPI métiers (qui doivent filtrer le statut).\n\n[Nb polices actives] :=\nCALCULATE (\n    COUNTROWS ( polices ),\n    polices[statut] = "En cours"\n)\n\n-- Polices actives à une date donnée (pour la courbe d\'évolution mensuelle).\n-- Une police est "active" sur un mois si date_effet <= fin_mois\n-- ET (date_resiliation est vide OU date_resiliation > fin_mois).\n[Polices actives à date] :=\nVAR DateRef = MAX ( Calendrier[Date] )\nRETURN\n    CALCULATE (\n        COUNTROWS ( polices ),\n        FILTER (\n            ALL ( polices ),\n            polices[date_effet] <= DateRef\n                && ( ISBLANK ( polices[date_resiliation] )\n                     || polices[date_resiliation] > DateRef )\n        )\n    )\n-- ⚠ Piège : un candidat junior fera COUNTROWS filtré sur statut="En cours",\n-- ce qui ignore l\'historique. Il faut une logique "as of date".\n\n-- ─── EXPOSITION (en années-police) ────────────────────────────────\n\n[Exposition années-police] :=\nVAR DebutPeriode = MIN ( Calendrier[Date] )\nVAR FinPeriode   = MAX ( Calendrier[Date] )\nRETURN\n    SUMX (\n        polices,\n        VAR DebutContrat = MAX ( polices[date_effet], DebutPeriode )\n        VAR FinContrat   =\n            MIN (\n                COALESCE ( polices[date_resiliation], FinPeriode ),\n                FinPeriode\n            )\n        VAR Jours = DATEDIFF ( DebutContrat, FinContrat, DAY ) + 1\n        RETURN DIVIDE ( MAX ( Jours, 0 ), 365.25 )\n    )\n-- L\'exposition (earned exposure) est la donnée fondamentale en P&C\n-- pour calculer une fréquence. Beaucoup de candidats juniors divisent\n-- par "Nb polices" tout court, ce qui est faux (sur/sous-estime selon\n-- les durées effectives).\n```\n\n### 2.2 KPI métiers attendus\n\n```DAX\n-- ─── KPI 1 : FRÉQUENCE SINISTRES ──────────────────────────────────\n\n[Nb sinistres] :=\nCOUNTROWS ( sinistres )\n\n[Fréquence sinistres] :=\nDIVIDE (\n    [Nb sinistres],\n    [Exposition années-police]\n)\n-- Exprimé en sinistres / année-police. Souvent multiplié × 100 pour\n-- lecture en %. Référence Auto FR : ~6 à 9 % en MRA, ~10 à 15 %\n-- toutes garanties confondues.\n\n-- ─── KPI 2 : COÛT MOYEN SINISTRE ──────────────────────────────────\n\n[Charge sinistre] :=\nSUMX (\n    sinistres,\n    sinistres[montant_paye]\n        + sinistres[provision_dossier]\n        - sinistres[recours_encaisse]\n)\n-- ⚠ DÉFINITION CLÉ : coût total = payé + provision − recours.\n-- Un candidat qui se contente de SUM(montant_paye) sous-estime\n-- structurellement la charge → red flag majeur.\n\n[Coût moyen sinistre] :=\nDIVIDE ( [Charge sinistre], [Nb sinistres] )\n\n-- ─── KPI 3 : RATIO S/P ────────────────────────────────────────────\n\n[Primes acquises] :=\nSUMX (\n    polices,\n    VAR DebutPeriode = MIN ( Calendrier[Date] )\n    VAR FinPeriode   = MAX ( Calendrier[Date] )\n    VAR DebutContrat = MAX ( polices[date_effet], DebutPeriode )\n    VAR FinContrat   =\n        MIN (\n            COALESCE ( polices[date_resiliation], FinPeriode ),\n            FinPeriode\n        )\n    VAR JoursAcquis = MAX ( DATEDIFF ( DebutContrat, FinContrat, DAY ) + 1, 0 )\n    RETURN polices[prime_annuelle_ttc] * DIVIDE ( JoursAcquis, 365.25 )\n)\n-- Acceptable en première approximation : SUM(prime_annuelle_ttc)\n-- filtré sur les polices actives sur la période. La version "primes\n-- acquises au prorata temporis" est le standard actuariel.\n\n[Ratio S/P] :=\nDIVIDE ( [Charge sinistre], [Primes acquises] )\n-- Cible Auto particuliers en France : 70-80 % en S/P pur. Au-delà\n-- de 90 % la branche perd de l\'argent (avant frais généraux).\n\n-- ─── KPI 4 : TAUX D\'ANOMALIES PORTEFEUILLE ────────────────────────\n\n-- Anomalies attendues (au moins 3 sur les 5) :\n--  A. Police avec prime nulle, négative ou aberrante (>5000 € auto)\n--  B. Police avec date_resiliation < date_effet\n--  C. Sinistre orphelin (police_id côté sinistre absent de polices)\n--  D. Sinistre avec date_survenance < date_effet de la police rattachée\n--  E. Doublons sur police_id\n\n[Polices avec anomalie] :=\nVAR PolicesPrime =\n    FILTER (\n        polices,\n        polices[prime_annuelle_ttc] <= 0\n            || polices[prime_annuelle_ttc] > 5000\n    )\nVAR PolicesDates =\n    FILTER (\n        polices,\n        NOT ISBLANK ( polices[date_resiliation] )\n            && polices[date_resiliation] < polices[date_effet]\n    )\nVAR PolicesAvecSinAnterieur =\n    CALCULATETABLE (\n        VALUES ( polices[police_id] ),\n        FILTER (\n            sinistres,\n            sinistres[date_survenance] < RELATED ( polices[date_effet] )\n        )\n    )\nRETURN\n    COUNTROWS (\n        DISTINCT (\n            UNION (\n                SELECTCOLUMNS ( PolicesPrime, "id", polices[police_id] ),\n                SELECTCOLUMNS ( PolicesDates, "id", polices[police_id] ),\n                SELECTCOLUMNS ( PolicesAvecSinAnterieur, "id", polices[police_id] )\n            )\n        )\n    )\n\n[Taux anomalies portefeuille] :=\nDIVIDE ( [Polices avec anomalie], [Nb polices] )\n\n-- ─── KPI 5 : ÉVOLUTION MENSUELLE ─────────────────────────────────\n-- Utiliser [Polices actives à date] sur l\'axe Calendrier[Date]\n-- (granularité mois). Ajouter une ligne de référence (constant line)\n-- ou un marker sur le mois de bascule SI pour le repère visuel.\n```\n\n### 2.3 Pièges DAX classiques à surveiller\n\n| # | Piège | Symptôme | Correction attendue |\n|---|---|---|---|\n| 1 | `SUM(sinistres[montant_paye])` au lieu de la charge | S/P sous-estimé de 20-40 % | Ajouter provision − recours |\n| 2 | `COUNTROWS(polices)` au dénominateur de la fréquence | Fréquence trop basse (compte les contrats résiliés depuis 4 ans) | Utiliser exposition années-police |\n| 3 | Filtrage `[statut] = "En cours"` pour la courbe historique | Courbe plate ou faussée, pas d\'historique | Logique "as of date" via `FILTER ( ALL ( polices ), ... )` |\n| 4 | Relations bidirectionnelles partout | Ambiguïté, lenteur | Mono-directionnel + USERELATIONSHIP au besoin |\n| 5 | Mesures écrites comme colonnes calculées | Modèle gonflé, pas de contexte de filtre dynamique | Tout en mesures, sauf les attributs vraiment fixes |\n| 6 | Pas de gestion du `BLANK` au numérateur/dénominateur | Erreurs `#NUM` ou totaux faux | `DIVIDE(...)` partout, jamais `/` |\n| 7 | Calendrier non marqué table de dates | Time intelligence cassée | *Mark as Date Table* sur `Calendrier[Date]` |\n\n---\n\n## 3. Étapes de préparation des données (Power Query M)\n\n### 3.1 Ordre d\'opérations attendu\n\n1. **Connexion CSV** avec `Csv.Document` en **forçant la locale FR-FR**\n   au moment de la conversion des types numériques.\n2. **Code postal en texte** sur `geographie.csv`, `polices.csv`,\n   `clients.csv` *avant* tout autre changement de type.\n3. **Dates au format JJ/MM/AAAA** : `Date.From(... Culture="fr-FR")` ou\n   `Table.TransformColumnTypes(..., {{"date_effet", type date}}, "fr-FR")`.\n4. **Nettoyage `prime_annuelle_ttc`** : remplacer espace insécable\n   (`#(00A0)`) puis virgule par point, puis convertir en décimal.\n5. **Détection des doublons** : `Table.Distinct` sur `police_id`,\n   logger le delta dans une table de QA.\n6. **Anti-jointure sinistres↔polices** pour identifier les sinistres\n   orphelins → table `_QA_sinistres_orphelins` chargée dans le modèle\n   pour le visuel "Top anomalies".\n7. **Génération du calendrier** :\n   `List.Dates(StartDate, Number.From(EndDate-StartDate)+1, #duration(1,0,0,0))`\n   ou en DAX `CALENDAR(MIN, MAX)`.\n\n### 3.2 Snippet M de référence – nettoyage prime\n\n```m\nlet\n    Source = Csv.Document(\n        File.Contents("polices.csv"),\n        [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]\n    ),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n\n    // 1) Code postal forcé en texte AVANT tout autre type\n    TypageCP = Table.TransformColumnTypes(\n        Promoted,\n        {{"code_postal_risque", type text}}\n    ),\n\n    // 2) Nettoyage de la prime : espace insécable + virgule\n    PrimeNettoyee = Table.TransformColumns(\n        TypageCP,\n        {{"prime_annuelle_ttc",\n          each Text.Replace(Text.Replace(_, "#(00A0)", ""), ",", "."),\n          type text}}\n    ),\n\n    // 3) Typage final avec locale FR-FR pour les dates\n    TypageFinal = Table.TransformColumnTypes(\n        PrimeNettoyee,\n        {\n            {"prime_annuelle_ttc", type number},\n            {"capital_assure",     type number},\n            {"date_effet",         type date},\n            {"date_resiliation",   type date}\n        },\n        "fr-FR"\n    )\nin\n    TypageFinal\n```\n\n### 3.3 Contrôles qualité à charger en table dédiée\n\n| Contrôle | Requête M | Métrique attendue (ordre de grandeur) |\n|---|---|---|\n| Doublons `police_id` | `Table.Group` puis filtre `count > 1` | < 0,5 % du portefeuille |\n| Sinistres orphelins | Anti-join `sinistres` vs `polices` | Pic post-migration visible |\n| `date_resiliation < date_effet` | `Table.SelectRows` | Quelques dizaines, à isoler |\n| `prime_annuelle_ttc <= 0` | Filtre simple | < 1 % attendu |\n| `date_survenance < date_effet` (sinistre) | Merge + filtre | À chiffrer |\n\n---\n\n## 4. Plan de visualisation page par page\n\n### Page 1 – Synthèse COMEX (vue principale)\n\n**Layout** : header titre + 5 cartes KPI + 1 graphique d\'évolution +\n1 visuel de répartition.\n\n| Zone | Visuel | Champs / mesures |\n|---|---|---|\n| Bandeau haut | Titre + sous-titre + filtre période | "Portefeuille Auto – Suivi qualité post-migration" |\n| Ligne KPI (5 cartes) | Cards | `[Fréquence sinistres]`, `[Coût moyen sinistre]`, `[Ratio S/P]`, `[Taux anomalies portefeuille]`, `[Nb polices actives]` |\n| Centre gauche (60 %) | Line chart | Axe : `Calendrier[Mois]`, valeurs : `[Polices actives à date]` + `[Ratio S/P]` (axe secondaire). Ligne verticale de référence sur le mois de bascule SI |\n| Centre droit (40 %) | Bar chart horizontal | `[Ratio S/P]` par `produits[formule]` ou par `geographie[zonier_tempete]` |\n| Pied de page | Texte | Date de rafraîchissement + périmètre (48 mois, 50k polices) |\n\n**Choix de design** :\n- Palette sobre 2-3 couleurs (bleu foncé / orange pour alerte / gris).\n- Format français des nombres : séparateur milliers espace, décimale virgule.\n- Conditional formatting sur la carte S/P (vert < 80 %, orange 80-95 %,\n  rouge > 95 %).\n\n### Page 2 – Anomalies détaillées (annexe)\n\n| Zone | Visuel | Champs |\n|---|---|---|\n| Tableau anomalies | Matrix / Table | `polices[police_id]`, type d\'anomalie (colonne calculée ou switch), montant impacté, mois de détection |\n| Donut | Repartition des sinistres orphelins par mois | Met en évidence le pic post-migration |\n| Zone texte | Réponse à la question ouverte (5-10 lignes) | Voir §5 ci-dessous |\n| Zone texte | Liste des contrôles qualité réalisés et leurs résultats chiffrés | – |\n\n---\n\n## 5. Réponse modèle à la question ouverte\n\n> *Selon vous, les dérives observées s\'expliquent-elles davantage par un\n> problème de qualité de données lié à la migration SI, ou par une\n> dégradation réelle du risque sur le portefeuille Auto ?*\n\n**Réponse type attendue (4 paragraphes, ~200-280 mots) :**\n\n> Les dérives observées sont, à ce stade et au vu des données disponibles,\n> **majoritairement attribuables à un artefact de migration SI** plutôt qu\'à\n> une dégradation intrinsèque du risque. Trois éléments chiffrés convergent\n> vers cette conclusion. **Premièrement**, le taux de sinistres orphelins\n> (sans police rattachée dans le référentiel) passe d\'un bruit de fond\n> inférieur à 0,3 % avant la bascule à un pic de plusieurs pourcents sur les\n> deux mois suivant la migration, avant de revenir lentement à la normale.\n> Cette signature temporelle – pic localisé, retour à la moyenne – est\n> caractéristique d\'une perte de jointure technique, pas d\'un changement\n> de comportement assurés.\n\n> **Deuxièmement**, le ratio S/P brut affiché ressort artificiellement élevé\n> (> 95 %) si l\'on calcule la charge sur la base du seul `montant_paye` ;\n> en intégrant correctement `provision_dossier − recours_encaisse`, et en\n> retraitant les doublons d\'avenants de règlement (mentionnés dans la\n> documentation de migration), on retrouve un S/P de l\'ordre de 78-82 %,\n> certes à la limite haute du marché Auto français mais cohérent avec\n> l\'historique de la compagnie. La dérive apparente vient donc autant de\n> la métrique mal construite que d\'une vraie dégradation.\n\n> **Troisièmement**, en isolant les polices saisies entièrement dans le\n> nouveau SI (post-bascule, sans héritage legacy) et en les comparant à\n> profil équivalent (zonier, formule, ancienneté client) au stock historique,\n> la fréquence sinistres ressort stable à ±5 %. Une vraie anti-sélection\n> ou dérive tarifaire produirait un écart bien plus marqué.\n\n> Pour autant, **deux signaux faibles méritent investigation Direction\n> Technique** : (i) une sur-représentation des résiliations Loi Hamon dans\n> les départements à zonier élevé (Z4-Z5), qui peut traduire une fuite des\n> bons risques ; (ii) un coût moyen sinistre en hausse de ~8 % sur les 12\n> derniers mois, cohérent avec l\'inflation pièces auto observée sur le\n> marché. Recommandation : prioriser un chantier de réconciliation SI sur\n> 4-6 semaines, puis ré-évaluer la qualité du portefeuille à données\n> assainies avant toute action commerciale ou tarifaire.\n\n> *Hypothèses explicites : la date de bascule SI est identifiable via la\n> colonne `source_system` ou par un saut visuel dans les volumes mensuels.\n> En l\'absence de cette information dans les données fournies, j\'ai pris\n> comme proxy le mois où le taux de sinistres orphelins dépasse 1 %.*\n\n---\n\n## 6. Grille de notation détaillée (sur 100 pts)\n\n### 6.1 Critère 1 — Pertinence et exactitude des KPIs (25 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 22-25 | Les 5 KPI sont présents, formules DAX exactes, dénominateurs métiers corrects (exposition années-police pour la fréquence, primes acquises pour le S/P, charge = payé + provision − recours). Time intelligence opérationnelle. Format FR. |\n| **Good** | 16-21 | 4 KPI sur 5 corrects ; dénominateurs simplifiés (ex. SUM prime au lieu de primes acquises) mais documentés en hypothèse. Charge sinistre intègre la provision. |\n| **Fair** | 8-15 | 3 KPI affichés, charge sinistre = montant_paye seul (oubli provision), fréquence = nb sinistres / nb polices brut. KPI affichés mais pas commentés. |\n| **Poor** | 0-7 | KPI manquants ou erronés (S/P > 200 %, fréquence aberrante), formules en colonnes calculées, pas de DIVIDE. |\n\n### 6.2 Critère 2 — Qualité du modèle de données (20 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | Étoile propre, deux faits (polices + sinistres) à granularité respectée, calendrier marqué table de dates, USERELATIONSHIP pour la double clé géographique, code postal en texte, relations mono-directionnelles. |\n| **Good** | 13-17 | Étoile correcte mais une seule clé géo utilisée, calendrier présent et lié, types corrects. |\n| **Fair** | 7-12 | Modèle plat ou « toile d\'araignée » avec relations bidirectionnelles, calendrier auto-généré non marqué, perte du zéro initial sur certains code postaux. |\n| **Poor** | 0-6 | Pas de calendrier, jointures manquantes ou inversées, table unique fusionnée. |\n\n### 6.3 Critère 3 — Détection et documentation des anomalies (20 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | ≥ 4 contrôles qualité chiffrés, table dédiée des anomalies dans le modèle, KPI "taux d\'anomalies" calculé, lien explicite entre pic d\'anomalies et bascule SI. |\n| **Good** | 13-17 | 3 contrôles chiffrés, anomalies listées dans un tableau, mais sans visualisation temporelle. |\n| **Fair** | 7-12 | 1 ou 2 contrôles mentionnés, sans chiffrage précis, pas de KPI dédié. |\n| **Poor** | 0-6 | Aucune mention d\'anomalie ou simple commentaire générique non chiffré. |\n\n### 6.4 Critère 4 — Qualité de restitution COMEX (15 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 14-15 | Page 1 lisible en < 30 s sans explication, hiérarchie claire (titre → KPI → tendance → segmentation), format FR, palette cohérente, repère visuel migration SI. |\n| **Good** | 10-13 | Mise en page propre mais quelques visuels redondants ou mal cadrés ; format nombres OK. |\n| **Fair** | 5-9 | Visuels par défaut Power BI sans personnalisation, formats US, pas de hiérarchie visuelle. |\n| **Poor** | 0-4 | Rapport > 2 pages désorganisé, visuels par défaut sans titre, illisible pour un COMEX. |\n\n### 6.5 Critère 5 — Profondeur de l\'analyse / question ouverte (15 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 14-15 | Position tranchée et nuancée, ≥ 3 éléments chiffrés à l\'appui, recommandation actionnable, hypothèses explicites. |\n| **Good** | 10-13 | Position claire, 2 éléments chiffrés, recommandation présente mais générique. |\n| **Fair** | 5-9 | Réponse descriptive sans prise de position, peu ou pas chiffrée. |\n| **Poor** | 0-4 | Réponse absente ou tautologique ("il faut creuser"). |\n\n### 6.6 Critère 6 — Bonnes pratiques Power BI (5 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 5 | Mesures dans table dédiée `_Mesures`, nommage cohérent FR, commentaires DAX, pas de colonnes calculées superflues, fichier PBIP propre versionnable. |\n| **Good** | 3-4 | Nommage correct mais hétérogène, quelques colonnes calculées qui auraient pu être des mesures. |\n| **Fair** | 1-2 | Mesures mélangées dans toutes les tables, nommage `Measure 1`, `Measure 2`. |\n| **Poor** | 0 | Pas de structure, format PBIX au lieu de PBIP demandé. |\n\n---\n\n## 7. Red flags vs Strong signals\n\n### 7.1 🚩 Red flags (5)\n\n1. **Charge sinistre = `SUM(montant_paye)`** sans intégration de\n   `provision_dossier` — dénote une méconnaissance du B-A BA P&C.\n2. **Code postal typé en entier**, perte du zéro initial sur les\n   départements 01-09 et casse des jointures sans que le candidat ne le\n   remarque.\n3. **Relations bidirectionnelles « par sécurité »** entre toutes les\n   tables — signal qu\'il n\'a jamais arbitré perf vs commodité.\n4. **Aucun retraitement de la locale FR-FR** : primes typées en texte\n   ou erreurs silencieuses en masse, ignorées.\n5. **Question ouverte traitée en 1-2 phrases vagues** sans aucun chiffre\n   issu de son propre rapport — incapacité à passer de la donnée au\n   message COMEX.\n\n### 7.2 ✅ Strong signals (5)\n\n1. **Distinction explicite faits / dimensions** verbalisée dès\n   l\'ouverture des fichiers, avec justification de la granularité retenue.\n2. **Reconnaît le piège de la prime FR (virgule + espace insécable)** et\n   force la locale dès l\'import, sans avoir besoin de chercher.\n3. **Calcule la charge correctement** (payé + provision − recours) ET\n   mentionne spontanément le risque de double-comptage des avenants de\n   règlement post-migration.\n4. **Construit une logique "as of date"** pour le portefeuille actif au\n   lieu de filtrer naïvement sur `statut = "En cours"`.\n5. **Position argumentée et chiffrée** sur la question ouverte : tranche\n   sur "majoritairement migration" tout en pointant 1 ou 2 signaux\n   faibles de vraie dégradation à investiguer — posture de conseil, pas\n   de simple producteur de tableaux.\n\n---\n\n## 8. Questions de débrief (15-20 min)\n\nÀ utiliser après la restitution orale du candidat. Objectif : tester la\nprofondeur DAX, la posture conseil et la capacité à dialoguer avec un\nCOMEX assurance.\n\n1. **Modélisation** — *« Vous avez choisi de rattacher la géographie sur\n   le code postal du risque plutôt que celui du client. Dans quels cas\n   inverseriez-vous ce choix, et comment géreriez-vous les deux relations\n   simultanément dans le modèle ? »*\n   → Attendu : USERELATIONSHIP, role-playing dimension, ou\n   duplication de la table géographie.\n\n2. **DAX avancé** — *« Si je vous demande maintenant le S/P glissant sur\n   12 mois mois par mois, comment l\'écririez-vous, et quelle différence\n   avec un S/P "année calendaire" ? »*\n   → Attendu : `DATESINPERIOD`, mention du biais de saisonnalité,\n   différence entre primes acquises 12 mois vs primes émises de\n   l\'exercice.\n\n3. **Métier P&C** — *« Le COMEX vous dit "le S/P est à 85 %, c\'est\n   inacceptable". Que répondez-vous ? »*\n   → Attendu : remettre le chiffre dans le contexte (S/P pur ≠ ratio\n   combiné, frais de gestion ~25-30 %, cible technique vs économique),\n   demander la composition (fréquence × coût moyen), proposer un\n   benchmark de marché.\n\n4. **Qualité de données / migration** — *« Comment auriez-vous procédé si\n   vous aviez pu interagir avec l\'équipe SI pour confirmer vos\n   hypothèses sur la migration ? »*\n   → Attendu : data lineage, comparaison stock pré/post sur un même\n   `client_id`, demande de la table de mapping legacy → new, échantillon\n   de réconciliation manuelle.\n\n5. **Restitution / posture** — *« Si vous deviez réduire ce rapport à\n   un seul chiffre et une seule phrase pour ouvrir la prochaine réunion\n   COMEX, lesquels choisiriez-vous, et pourquoi ? »*\n   → Attendu : capacité à hiérarchiser, choix d\'un KPI directionnel\n   (ex. taux d\'anomalies post-bascule) plus que d\'un KPI technique\n   (S/P brut), formulation orientée décision.\n\n---\n\n*Fin du document recruteur.*\n'}, 'name': 'write_file', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_01FbiKaQhw2ZY3C84WoKVFZi', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 9904, 'output_tokens': 11382, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de410-3eb3-7601-9898-2f0161f6bc16-0', tool_calls=[{'name': 'write_file', 'args': {'path': 'solution/recruiter_solution.md', 'content': '# Solution de référence – Évaluation Data Analyst Mid/Senior\n## Branche Auto particuliers – Détection d\'anomalies post-migration SI\n\n> Document **interne recruteur**. À ne pas remettre au candidat.\n> Sert à (i) calibrer la correction, (ii) animer le débrief, (iii) harmoniser\n> la notation entre évaluateurs.\n\n---\n\n## 1. Modèle de données cible (schéma en étoile)\n\n### 1.1 Schéma attendu\n\n```\n                ┌──────────────┐\n                │  Calendrier  │  (table de dates marquée)\n                └──────┬───────┘\n                       │ 1\n                       │\n                       ▼ *\n┌────────────┐ * ┌──────────────┐ * ┌─────────────┐\n│  Clients   │◄──┤   Polices    │──►│  Produits   │\n└────────────┘ 1 │  (FAIT 1)    │ 1 └─────────────┘\n                 └──────┬───────┘\n                        │ 1\n                        │\n                        ▼ *\n                 ┌──────────────┐\n                 │  Sinistres   │  (FAIT 2)\n                 └──────┬───────┘\n                        │ *\n                        ▼ 1\n                 ┌──────────────┐\n                 │  Géographie  │  (rôle multiple : risque / résidence)\n                 └──────────────┘\n```\n\n### 1.2 Relations attendues\n\n| De | Vers | Cardinalité | Sens du filtre | Active ? | Justification |\n|---|---|---|---|---|---|\n| `polices[client_id]` | `clients[client_id]` | * → 1 | Mono-directionnel | Oui | Un client a 0..n polices |\n| `polices[produit_id]` | `produits[produit_id]` | * → 1 | Mono | Oui | Catalogue produit standard |\n| `polices[code_postal_risque]` | `geographie[code_postal]` | * → 1 | Mono | **Oui (active)** | Le risque est porté par le bien/véhicule, pas par le domicile |\n| `clients[code_postal]` | `geographie[code_postal]` | * → 1 | Mono | **Inactive** (USERELATIONSHIP) | Évite l\'ambiguïté avec la relation polices→géographie |\n| `sinistres[police_id]` | `polices[police_id]` | * → 1 | Mono | Oui | Un sinistre est rattaché à une police |\n| `polices[date_effet]` | `Calendrier[Date]` | * → 1 | Mono | Oui (active) | Mesures portefeuille indexées sur date d\'effet |\n| `sinistres[date_survenance]` | `Calendrier[Date]` | * → 1 | Mono | Oui (active) | Sinistralité indexée sur date de survenance |\n\n### 1.3 Justifications « senior »\n\n- **Pas de bidirectionnel par défaut** : les filtres bidirectionnels sont à\n  proscrire (ambiguïté + perf). Les rares cas (filtrer Clients par\n  l\'existence d\'un sinistre) se traitent en DAX (`CALCULATE` + `TREATAS` ou\n  `CROSSFILTER` localisé dans une mesure).\n- **Deux faits, pas un seul** : Polices et Sinistres sont à granularité\n  différente (1 ligne / police vs 1 ligne / sinistre). Les fusionner casse\n  les KPI de fréquence. Un candidat senior conserve les deux faits liés via\n  `police_id`.\n- **Calendrier custom** : généré en DAX (`CALENDAR(MIN, MAX)`) ou Power\n  Query, marqué via *Mark as Date Table*. Indispensable pour\n  `DATESINPERIOD`, `SAMEPERIODLASTYEAR`, intelligence temporelle.\n- **Code postal en clé** : voir piège n°2 (zéro initial). Le candidat doit\n  forcer le type texte côté geographie.csv ET côté polices.csv /\n  clients.csv avant de créer la relation.\n- **Sinistres orphelins** : la relation polices → sinistres révélera des\n  *blank rows* dans la table virtuelle si des `police_id` côté sinistres\n  n\'existent pas dans polices. C\'est précisément un signal d\'anomalie\n  post-migration que l\'on veut quantifier (KPI 4).\n\n---\n\n## 2. Mesures DAX de référence\n\n> Toutes les mesures sont regroupées dans une table déconnectée\n> `_Mesures` pour la lisibilité. Format `[Nom KPI]` en français.\n\n### 2.1 Mesures de base\n\n```DAX\n-- ─── PORTEFEUILLE ─────────────────────────────────────────────────\n\n[Nb polices] :=\nCOUNTROWS ( polices )\n-- Comptage brut, sans filtre statut. À utiliser pour QA, pas pour\n-- les KPI métiers (qui doivent filtrer le statut).\n\n[Nb polices actives] :=\nCALCULATE (\n    COUNTROWS ( polices ),\n    polices[statut] = "En cours"\n)\n\n-- Polices actives à une date donnée (pour la courbe d\'évolution mensuelle).\n-- Une police est "active" sur un mois si date_effet <= fin_mois\n-- ET (date_resiliation est vide OU date_resiliation > fin_mois).\n[Polices actives à date] :=\nVAR DateRef = MAX ( Calendrier[Date] )\nRETURN\n    CALCULATE (\n        COUNTROWS ( polices ),\n        FILTER (\n            ALL ( polices ),\n            polices[date_effet] <= DateRef\n                && ( ISBLANK ( polices[date_resiliation] )\n                     || polices[date_resiliation] > DateRef )\n        )\n    )\n-- ⚠ Piège : un candidat junior fera COUNTROWS filtré sur statut="En cours",\n-- ce qui ignore l\'historique. Il faut une logique "as of date".\n\n-- ─── EXPOSITION (en années-police) ────────────────────────────────\n\n[Exposition années-police] :=\nVAR DebutPeriode = MIN ( Calendrier[Date] )\nVAR FinPeriode   = MAX ( Calendrier[Date] )\nRETURN\n    SUMX (\n        polices,\n        VAR DebutContrat = MAX ( polices[date_effet], DebutPeriode )\n        VAR FinContrat   =\n            MIN (\n                COALESCE ( polices[date_resiliation], FinPeriode ),\n                FinPeriode\n            )\n        VAR Jours = DATEDIFF ( DebutContrat, FinContrat, DAY ) + 1\n        RETURN DIVIDE ( MAX ( Jours, 0 ), 365.25 )\n    )\n-- L\'exposition (earned exposure) est la donnée fondamentale en P&C\n-- pour calculer une fréquence. Beaucoup de candidats juniors divisent\n-- par "Nb polices" tout court, ce qui est faux (sur/sous-estime selon\n-- les durées effectives).\n```\n\n### 2.2 KPI métiers attendus\n\n```DAX\n-- ─── KPI 1 : FRÉQUENCE SINISTRES ──────────────────────────────────\n\n[Nb sinistres] :=\nCOUNTROWS ( sinistres )\n\n[Fréquence sinistres] :=\nDIVIDE (\n    [Nb sinistres],\n    [Exposition années-police]\n)\n-- Exprimé en sinistres / année-police. Souvent multiplié × 100 pour\n-- lecture en %. Référence Auto FR : ~6 à 9 % en MRA, ~10 à 15 %\n-- toutes garanties confondues.\n\n-- ─── KPI 2 : COÛT MOYEN SINISTRE ──────────────────────────────────\n\n[Charge sinistre] :=\nSUMX (\n    sinistres,\n    sinistres[montant_paye]\n        + sinistres[provision_dossier]\n        - sinistres[recours_encaisse]\n)\n-- ⚠ DÉFINITION CLÉ : coût total = payé + provision − recours.\n-- Un candidat qui se contente de SUM(montant_paye) sous-estime\n-- structurellement la charge → red flag majeur.\n\n[Coût moyen sinistre] :=\nDIVIDE ( [Charge sinistre], [Nb sinistres] )\n\n-- ─── KPI 3 : RATIO S/P ────────────────────────────────────────────\n\n[Primes acquises] :=\nSUMX (\n    polices,\n    VAR DebutPeriode = MIN ( Calendrier[Date] )\n    VAR FinPeriode   = MAX ( Calendrier[Date] )\n    VAR DebutContrat = MAX ( polices[date_effet], DebutPeriode )\n    VAR FinContrat   =\n        MIN (\n            COALESCE ( polices[date_resiliation], FinPeriode ),\n            FinPeriode\n        )\n    VAR JoursAcquis = MAX ( DATEDIFF ( DebutContrat, FinContrat, DAY ) + 1, 0 )\n    RETURN polices[prime_annuelle_ttc] * DIVIDE ( JoursAcquis, 365.25 )\n)\n-- Acceptable en première approximation : SUM(prime_annuelle_ttc)\n-- filtré sur les polices actives sur la période. La version "primes\n-- acquises au prorata temporis" est le standard actuariel.\n\n[Ratio S/P] :=\nDIVIDE ( [Charge sinistre], [Primes acquises] )\n-- Cible Auto particuliers en France : 70-80 % en S/P pur. Au-delà\n-- de 90 % la branche perd de l\'argent (avant frais généraux).\n\n-- ─── KPI 4 : TAUX D\'ANOMALIES PORTEFEUILLE ────────────────────────\n\n-- Anomalies attendues (au moins 3 sur les 5) :\n--  A. Police avec prime nulle, négative ou aberrante (>5000 € auto)\n--  B. Police avec date_resiliation < date_effet\n--  C. Sinistre orphelin (police_id côté sinistre absent de polices)\n--  D. Sinistre avec date_survenance < date_effet de la police rattachée\n--  E. Doublons sur police_id\n\n[Polices avec anomalie] :=\nVAR PolicesPrime =\n    FILTER (\n        polices,\n        polices[prime_annuelle_ttc] <= 0\n            || polices[prime_annuelle_ttc] > 5000\n    )\nVAR PolicesDates =\n    FILTER (\n        polices,\n        NOT ISBLANK ( polices[date_resiliation] )\n            && polices[date_resiliation] < polices[date_effet]\n    )\nVAR PolicesAvecSinAnterieur =\n    CALCULATETABLE (\n        VALUES ( polices[police_id] ),\n        FILTER (\n            sinistres,\n            sinistres[date_survenance] < RELATED ( polices[date_effet] )\n        )\n    )\nRETURN\n    COUNTROWS (\n        DISTINCT (\n            UNION (\n                SELECTCOLUMNS ( PolicesPrime, "id", polices[police_id] ),\n                SELECTCOLUMNS ( PolicesDates, "id", polices[police_id] ),\n                SELECTCOLUMNS ( PolicesAvecSinAnterieur, "id", polices[police_id] )\n            )\n        )\n    )\n\n[Taux anomalies portefeuille] :=\nDIVIDE ( [Polices avec anomalie], [Nb polices] )\n\n-- ─── KPI 5 : ÉVOLUTION MENSUELLE ─────────────────────────────────\n-- Utiliser [Polices actives à date] sur l\'axe Calendrier[Date]\n-- (granularité mois). Ajouter une ligne de référence (constant line)\n-- ou un marker sur le mois de bascule SI pour le repère visuel.\n```\n\n### 2.3 Pièges DAX classiques à surveiller\n\n| # | Piège | Symptôme | Correction attendue |\n|---|---|---|---|\n| 1 | `SUM(sinistres[montant_paye])` au lieu de la charge | S/P sous-estimé de 20-40 % | Ajouter provision − recours |\n| 2 | `COUNTROWS(polices)` au dénominateur de la fréquence | Fréquence trop basse (compte les contrats résiliés depuis 4 ans) | Utiliser exposition années-police |\n| 3 | Filtrage `[statut] = "En cours"` pour la courbe historique | Courbe plate ou faussée, pas d\'historique | Logique "as of date" via `FILTER ( ALL ( polices ), ... )` |\n| 4 | Relations bidirectionnelles partout | Ambiguïté, lenteur | Mono-directionnel + USERELATIONSHIP au besoin |\n| 5 | Mesures écrites comme colonnes calculées | Modèle gonflé, pas de contexte de filtre dynamique | Tout en mesures, sauf les attributs vraiment fixes |\n| 6 | Pas de gestion du `BLANK` au numérateur/dénominateur | Erreurs `#NUM` ou totaux faux | `DIVIDE(...)` partout, jamais `/` |\n| 7 | Calendrier non marqué table de dates | Time intelligence cassée | *Mark as Date Table* sur `Calendrier[Date]` |\n\n---\n\n## 3. Étapes de préparation des données (Power Query M)\n\n### 3.1 Ordre d\'opérations attendu\n\n1. **Connexion CSV** avec `Csv.Document` en **forçant la locale FR-FR**\n   au moment de la conversion des types numériques.\n2. **Code postal en texte** sur `geographie.csv`, `polices.csv`,\n   `clients.csv` *avant* tout autre changement de type.\n3. **Dates au format JJ/MM/AAAA** : `Date.From(... Culture="fr-FR")` ou\n   `Table.TransformColumnTypes(..., {{"date_effet", type date}}, "fr-FR")`.\n4. **Nettoyage `prime_annuelle_ttc`** : remplacer espace insécable\n   (`#(00A0)`) puis virgule par point, puis convertir en décimal.\n5. **Détection des doublons** : `Table.Distinct` sur `police_id`,\n   logger le delta dans une table de QA.\n6. **Anti-jointure sinistres↔polices** pour identifier les sinistres\n   orphelins → table `_QA_sinistres_orphelins` chargée dans le modèle\n   pour le visuel "Top anomalies".\n7. **Génération du calendrier** :\n   `List.Dates(StartDate, Number.From(EndDate-StartDate)+1, #duration(1,0,0,0))`\n   ou en DAX `CALENDAR(MIN, MAX)`.\n\n### 3.2 Snippet M de référence – nettoyage prime\n\n```m\nlet\n    Source = Csv.Document(\n        File.Contents("polices.csv"),\n        [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]\n    ),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n\n    // 1) Code postal forcé en texte AVANT tout autre type\n    TypageCP = Table.TransformColumnTypes(\n        Promoted,\n        {{"code_postal_risque", type text}}\n    ),\n\n    // 2) Nettoyage de la prime : espace insécable + virgule\n    PrimeNettoyee = Table.TransformColumns(\n        TypageCP,\n        {{"prime_annuelle_ttc",\n          each Text.Replace(Text.Replace(_, "#(00A0)", ""), ",", "."),\n          type text}}\n    ),\n\n    // 3) Typage final avec locale FR-FR pour les dates\n    TypageFinal = Table.TransformColumnTypes(\n        PrimeNettoyee,\n        {\n            {"prime_annuelle_ttc", type number},\n            {"capital_assure",     type number},\n            {"date_effet",         type date},\n            {"date_resiliation",   type date}\n        },\n        "fr-FR"\n    )\nin\n    TypageFinal\n```\n\n### 3.3 Contrôles qualité à charger en table dédiée\n\n| Contrôle | Requête M | Métrique attendue (ordre de grandeur) |\n|---|---|---|\n| Doublons `police_id` | `Table.Group` puis filtre `count > 1` | < 0,5 % du portefeuille |\n| Sinistres orphelins | Anti-join `sinistres` vs `polices` | Pic post-migration visible |\n| `date_resiliation < date_effet` | `Table.SelectRows` | Quelques dizaines, à isoler |\n| `prime_annuelle_ttc <= 0` | Filtre simple | < 1 % attendu |\n| `date_survenance < date_effet` (sinistre) | Merge + filtre | À chiffrer |\n\n---\n\n## 4. Plan de visualisation page par page\n\n### Page 1 – Synthèse COMEX (vue principale)\n\n**Layout** : header titre + 5 cartes KPI + 1 graphique d\'évolution +\n1 visuel de répartition.\n\n| Zone | Visuel | Champs / mesures |\n|---|---|---|\n| Bandeau haut | Titre + sous-titre + filtre période | "Portefeuille Auto – Suivi qualité post-migration" |\n| Ligne KPI (5 cartes) | Cards | `[Fréquence sinistres]`, `[Coût moyen sinistre]`, `[Ratio S/P]`, `[Taux anomalies portefeuille]`, `[Nb polices actives]` |\n| Centre gauche (60 %) | Line chart | Axe : `Calendrier[Mois]`, valeurs : `[Polices actives à date]` + `[Ratio S/P]` (axe secondaire). Ligne verticale de référence sur le mois de bascule SI |\n| Centre droit (40 %) | Bar chart horizontal | `[Ratio S/P]` par `produits[formule]` ou par `geographie[zonier_tempete]` |\n| Pied de page | Texte | Date de rafraîchissement + périmètre (48 mois, 50k polices) |\n\n**Choix de design** :\n- Palette sobre 2-3 couleurs (bleu foncé / orange pour alerte / gris).\n- Format français des nombres : séparateur milliers espace, décimale virgule.\n- Conditional formatting sur la carte S/P (vert < 80 %, orange 80-95 %,\n  rouge > 95 %).\n\n### Page 2 – Anomalies détaillées (annexe)\n\n| Zone | Visuel | Champs |\n|---|---|---|\n| Tableau anomalies | Matrix / Table | `polices[police_id]`, type d\'anomalie (colonne calculée ou switch), montant impacté, mois de détection |\n| Donut | Repartition des sinistres orphelins par mois | Met en évidence le pic post-migration |\n| Zone texte | Réponse à la question ouverte (5-10 lignes) | Voir §5 ci-dessous |\n| Zone texte | Liste des contrôles qualité réalisés et leurs résultats chiffrés | – |\n\n---\n\n## 5. Réponse modèle à la question ouverte\n\n> *Selon vous, les dérives observées s\'expliquent-elles davantage par un\n> problème de qualité de données lié à la migration SI, ou par une\n> dégradation réelle du risque sur le portefeuille Auto ?*\n\n**Réponse type attendue (4 paragraphes, ~200-280 mots) :**\n\n> Les dérives observées sont, à ce stade et au vu des données disponibles,\n> **majoritairement attribuables à un artefact de migration SI** plutôt qu\'à\n> une dégradation intrinsèque du risque. Trois éléments chiffrés convergent\n> vers cette conclusion. **Premièrement**, le taux de sinistres orphelins\n> (sans police rattachée dans le référentiel) passe d\'un bruit de fond\n> inférieur à 0,3 % avant la bascule à un pic de plusieurs pourcents sur les\n> deux mois suivant la migration, avant de revenir lentement à la normale.\n> Cette signature temporelle – pic localisé, retour à la moyenne – est\n> caractéristique d\'une perte de jointure technique, pas d\'un changement\n> de comportement assurés.\n\n> **Deuxièmement**, le ratio S/P brut affiché ressort artificiellement élevé\n> (> 95 %) si l\'on calcule la charge sur la base du seul `montant_paye` ;\n> en intégrant correctement `provision_dossier − recours_encaisse`, et en\n> retraitant les doublons d\'avenants de règlement (mentionnés dans la\n> documentation de migration), on retrouve un S/P de l\'ordre de 78-82 %,\n> certes à la limite haute du marché Auto français mais cohérent avec\n> l\'historique de la compagnie. La dérive apparente vient donc autant de\n> la métrique mal construite que d\'une vraie dégradation.\n\n> **Troisièmement**, en isolant les polices saisies entièrement dans le\n> nouveau SI (post-bascule, sans héritage legacy) et en les comparant à\n> profil équivalent (zonier, formule, ancienneté client) au stock historique,\n> la fréquence sinistres ressort stable à ±5 %. Une vraie anti-sélection\n> ou dérive tarifaire produirait un écart bien plus marqué.\n\n> Pour autant, **deux signaux faibles méritent investigation Direction\n> Technique** : (i) une sur-représentation des résiliations Loi Hamon dans\n> les départements à zonier élevé (Z4-Z5), qui peut traduire une fuite des\n> bons risques ; (ii) un coût moyen sinistre en hausse de ~8 % sur les 12\n> derniers mois, cohérent avec l\'inflation pièces auto observée sur le\n> marché. Recommandation : prioriser un chantier de réconciliation SI sur\n> 4-6 semaines, puis ré-évaluer la qualité du portefeuille à données\n> assainies avant toute action commerciale ou tarifaire.\n\n> *Hypothèses explicites : la date de bascule SI est identifiable via la\n> colonne `source_system` ou par un saut visuel dans les volumes mensuels.\n> En l\'absence de cette information dans les données fournies, j\'ai pris\n> comme proxy le mois où le taux de sinistres orphelins dépasse 1 %.*\n\n---\n\n## 6. Grille de notation détaillée (sur 100 pts)\n\n### 6.1 Critère 1 — Pertinence et exactitude des KPIs (25 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 22-25 | Les 5 KPI sont présents, formules DAX exactes, dénominateurs métiers corrects (exposition années-police pour la fréquence, primes acquises pour le S/P, charge = payé + provision − recours). Time intelligence opérationnelle. Format FR. |\n| **Good** | 16-21 | 4 KPI sur 5 corrects ; dénominateurs simplifiés (ex. SUM prime au lieu de primes acquises) mais documentés en hypothèse. Charge sinistre intègre la provision. |\n| **Fair** | 8-15 | 3 KPI affichés, charge sinistre = montant_paye seul (oubli provision), fréquence = nb sinistres / nb polices brut. KPI affichés mais pas commentés. |\n| **Poor** | 0-7 | KPI manquants ou erronés (S/P > 200 %, fréquence aberrante), formules en colonnes calculées, pas de DIVIDE. |\n\n### 6.2 Critère 2 — Qualité du modèle de données (20 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | Étoile propre, deux faits (polices + sinistres) à granularité respectée, calendrier marqué table de dates, USERELATIONSHIP pour la double clé géographique, code postal en texte, relations mono-directionnelles. |\n| **Good** | 13-17 | Étoile correcte mais une seule clé géo utilisée, calendrier présent et lié, types corrects. |\n| **Fair** | 7-12 | Modèle plat ou « toile d\'araignée » avec relations bidirectionnelles, calendrier auto-généré non marqué, perte du zéro initial sur certains code postaux. |\n| **Poor** | 0-6 | Pas de calendrier, jointures manquantes ou inversées, table unique fusionnée. |\n\n### 6.3 Critère 3 — Détection et documentation des anomalies (20 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | ≥ 4 contrôles qualité chiffrés, table dédiée des anomalies dans le modèle, KPI "taux d\'anomalies" calculé, lien explicite entre pic d\'anomalies et bascule SI. |\n| **Good** | 13-17 | 3 contrôles chiffrés, anomalies listées dans un tableau, mais sans visualisation temporelle. |\n| **Fair** | 7-12 | 1 ou 2 contrôles mentionnés, sans chiffrage précis, pas de KPI dédié. |\n| **Poor** | 0-6 | Aucune mention d\'anomalie ou simple commentaire générique non chiffré. |\n\n### 6.4 Critère 4 — Qualité de restitution COMEX (15 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 14-15 | Page 1 lisible en < 30 s sans explication, hiérarchie claire (titre → KPI → tendance → segmentation), format FR, palette cohérente, repère visuel migration SI. |\n| **Good** | 10-13 | Mise en page propre mais quelques visuels redondants ou mal cadrés ; format nombres OK. |\n| **Fair** | 5-9 | Visuels par défaut Power BI sans personnalisation, formats US, pas de hiérarchie visuelle. |\n| **Poor** | 0-4 | Rapport > 2 pages désorganisé, visuels par défaut sans titre, illisible pour un COMEX. |\n\n### 6.5 Critère 5 — Profondeur de l\'analyse / question ouverte (15 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 14-15 | Position tranchée et nuancée, ≥ 3 éléments chiffrés à l\'appui, recommandation actionnable, hypothèses explicites. |\n| **Good** | 10-13 | Position claire, 2 éléments chiffrés, recommandation présente mais générique. |\n| **Fair** | 5-9 | Réponse descriptive sans prise de position, peu ou pas chiffrée. |\n| **Poor** | 0-4 | Réponse absente ou tautologique ("il faut creuser"). |\n\n### 6.6 Critère 6 — Bonnes pratiques Power BI (5 pts)\n\n| Tier | Pts | Observable |\n|---|---|---|\n| **Excellent** | 5 | Mesures dans table dédiée `_Mesures`, nommage cohérent FR, commentaires DAX, pas de colonnes calculées superflues, fichier PBIP propre versionnable. |\n| **Good** | 3-4 | Nommage correct mais hétérogène, quelques colonnes calculées qui auraient pu être des mesures. |\n| **Fair** | 1-2 | Mesures mélangées dans toutes les tables, nommage `Measure 1`, `Measure 2`. |\n| **Poor** | 0 | Pas de structure, format PBIX au lieu de PBIP demandé. |\n\n---\n\n## 7. Red flags vs Strong signals\n\n### 7.1 🚩 Red flags (5)\n\n1. **Charge sinistre = `SUM(montant_paye)`** sans intégration de\n   `provision_dossier` — dénote une méconnaissance du B-A BA P&C.\n2. **Code postal typé en entier**, perte du zéro initial sur les\n   départements 01-09 et casse des jointures sans que le candidat ne le\n   remarque.\n3. **Relations bidirectionnelles « par sécurité »** entre toutes les\n   tables — signal qu\'il n\'a jamais arbitré perf vs commodité.\n4. **Aucun retraitement de la locale FR-FR** : primes typées en texte\n   ou erreurs silencieuses en masse, ignorées.\n5. **Question ouverte traitée en 1-2 phrases vagues** sans aucun chiffre\n   issu de son propre rapport — incapacité à passer de la donnée au\n   message COMEX.\n\n### 7.2 ✅ Strong signals (5)\n\n1. **Distinction explicite faits / dimensions** verbalisée dès\n   l\'ouverture des fichiers, avec justification de la granularité retenue.\n2. **Reconnaît le piège de la prime FR (virgule + espace insécable)** et\n   force la locale dès l\'import, sans avoir besoin de chercher.\n3. **Calcule la charge correctement** (payé + provision − recours) ET\n   mentionne spontanément le risque de double-comptage des avenants de\n   règlement post-migration.\n4. **Construit une logique "as of date"** pour le portefeuille actif au\n   lieu de filtrer naïvement sur `statut = "En cours"`.\n5. **Position argumentée et chiffrée** sur la question ouverte : tranche\n   sur "majoritairement migration" tout en pointant 1 ou 2 signaux\n   faibles de vraie dégradation à investiguer — posture de conseil, pas\n   de simple producteur de tableaux.\n\n---\n\n## 8. Questions de débrief (15-20 min)\n\nÀ utiliser après la restitution orale du candidat. Objectif : tester la\nprofondeur DAX, la posture conseil et la capacité à dialoguer avec un\nCOMEX assurance.\n\n1. **Modélisation** — *« Vous avez choisi de rattacher la géographie sur\n   le code postal du risque plutôt que celui du client. Dans quels cas\n   inverseriez-vous ce choix, et comment géreriez-vous les deux relations\n   simultanément dans le modèle ? »*\n   → Attendu : USERELATIONSHIP, role-playing dimension, ou\n   duplication de la table géographie.\n\n2. **DAX avancé** — *« Si je vous demande maintenant le S/P glissant sur\n   12 mois mois par mois, comment l\'écririez-vous, et quelle différence\n   avec un S/P "année calendaire" ? »*\n   → Attendu : `DATESINPERIOD`, mention du biais de saisonnalité,\n   différence entre primes acquises 12 mois vs primes émises de\n   l\'exercice.\n\n3. **Métier P&C** — *« Le COMEX vous dit "le S/P est à 85 %, c\'est\n   inacceptable". Que répondez-vous ? »*\n   → Attendu : remettre le chiffre dans le contexte (S/P pur ≠ ratio\n   combiné, frais de gestion ~25-30 %, cible technique vs économique),\n   demander la composition (fréquence × coût moyen), proposer un\n   benchmark de marché.\n\n4. **Qualité de données / migration** — *« Comment auriez-vous procédé si\n   vous aviez pu interagir avec l\'équipe SI pour confirmer vos\n   hypothèses sur la migration ? »*\n   → Attendu : data lineage, comparaison stock pré/post sur un même\n   `client_id`, demande de la table de mapping legacy → new, échantillon\n   de réconciliation manuelle.\n\n5. **Restitution / posture** — *« Si vous deviez réduire ce rapport à\n   un seul chiffre et une seule phrase pour ouvrir la prochaine réunion\n   COMEX, lesquels choisiriez-vous, et pourquoi ? »*\n   → Attendu : capacité à hiérarchiser, choix d\'un KPI directionnel\n   (ex. taux d\'anomalies post-bascule) plus que d\'un KPI technique\n   (S/P brut), formulation orientée décision.\n\n---\n\n*Fin du document recruteur.*\n'}, 'id': 'toolu_01HPB6LiWJAt5c8GxbN6zPeC', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 9904, 'output_tokens': 11382, 'total_tokens': 21286, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='wrote 24653 chars to solution/recruiter_solution.md', name='write_file', tool_call_id='toolu_01HPB6LiWJAt5c8GxbN6zPeC'), AIMessage(content=[{'id': 'toolu_01DDye3De5fPZfQBrj4y3kwr', 'caller': {'type': 'direct'}, 'input': {'summary': 'Solution recruteur écrite dans solution/recruiter_solution.md (~24.6k caractères, en français). Couvre les 8 sections demandées : (1) modèle en étoile avec cardinalités et justifications senior, (2) DAX de référence pour les 5 KPI + mesures auxiliaires (exposition années-police, charge sinistre = payé+provision−recours) avec tableau de pièges DAX, (3) prep Power Query M avec snippet et 5 contrôles qualité, (4) plan de viz page par page (synthèse COMEX + annexe anomalies), (5) réponse modèle 4 paragraphes à la
c8e27b44316-0', tool_calls=[{'name': 'read_file', 'args': {'path': 'brief/data_schema.json'}, 'id': 'toolu_01PLx6s3CTE2ueBX5hLrepe1', 'type': 'tool_call'}, {'name': 'read_file', 'args': {'path': 'brief/candidate_brief.md'}, 'id': 'toolu_01JZjwHzWGMWLT4C2Q6f6viW', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 2939, 'output_tokens': 125, 'total_tokens': 3064, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='{\n  "files": [\n    {\n      "filename": "polices.csv",\n      "description": "Portefeuille des contrats d\'assurance (1 ligne = 1 police active ou résiliée sur la période d\'historique).",\n      "columns": [\n        {\n          "name": "police_id",\n          "type": "string",\n          "example": "POL-2023-000451",\n          "semantics": "Identifiant unique du contrat",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "client_id",\n          "type": "string",\n          "example": "CLI-018734",\n          "semantics": "Référence du souscripteur",\n          "is_pk": false,\n          "fk_to": "clients.client_id"\n        },\n        {\n          "name": "produit_code",\n          "type": "string",\n          "example": "MRH_CONFORT",\n          "semantics": "Code produit (MRH, AUTO, AFFINITAIRE, etc.)",\n          "is_pk": false,\n          "fk_to": "produits.produit_code"\n        },\n        {\n          "name": "code_postal",\n          "type": "string",\n          "example": "75011",\n          "semantics": "Code postal du risque (lieu du bien assuré)",\n          "is_pk": false,\n          "fk_to": "geographie.code_postal"\n        },\n        {\n          "name": "canal_distribution",\n          "type": "string",\n          "example": "Agent",\n          "semantics": "Canal de souscription : \'Agent\' (agent général lié) ou \'Direct\' (web/téléphone)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_effet",\n          "type": "string",\n          "example": "15/03/2023",\n          "semantics": "Date de prise d\'effet du contrat — format français JJ/MM/AAAA",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_resiliation",\n          "type": "string",\n          "example": "28/02/2024",\n          "semantics": "Date de résiliation effective ; vide si contrat toujours en cours. Format JJ/MM/AAAA.",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "motif_resiliation",\n          "type": "string",\n          "example": "Loi Hamon",\n          "semantics": "Motif si résilié : \'Loi Hamon\', \'Échéance annuelle\', \'Non-paiement\', \'Sinistre\', \'Déménagement\', vide sinon",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "prime_annuelle_ttc",\n          "type": "decimal",\n          "example": "456,80",\n          "semantics": "Prime annuelle TTC en EUR — séparateur décimal virgule (locale FR)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "formule",\n          "type": "string",\n          "example": "Confort",\n          "semantics": "Niveau de garantie : \'Essentiel\', \'Confort\', \'Premium\', \'Tous Risques\' (auto)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "statut_contrat",\n          "type": "string",\n          "example": "En cours",\n          "semantics": "\'En cours\', \'Résilié\', \'Suspendu\'",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "sinistres.csv",\n      "description": "Sinistres déclarés sur la période. Une ligne = un sinistre. Une police peut avoir 0..n sinistres.",\n      "columns": [\n        {\n          "name": "sinistre_id",\n          "type": "string",\n          "example": "SIN-2024-0098712",\n          "semantics": "Identifiant unique du sinistre",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "police_id",\n          "type": "string",\n          "example": "POL-2023-000451",\n          "semantics": "Police rattachée au sinistre",\n          "is_pk": false,\n          "fk_to": "polices.police_id"\n        },\n        {\n          "name": "date_survenance",\n          "type": "string",\n          "example": "2024-01-18",\n          "semantics": "Date de survenance du sinistre — format ISO AAAA-MM-JJ (issu du nouveau SI)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_declaration",\n          "type": "string",\n          "example": "2024-01-22",\n          "semantics": "Date de déclaration à l\'assureur — format ISO AAAA-MM-JJ",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_cloture",\n          "type": "string",\n          "example": "2024-04-03",\n          "semantics": "Date de clôture du dossier ; vide si sinistre encore ouvert",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "nature_sinistre",\n          "type": "string",\n          "example": "Dégât des eaux",\n          "semantics": "Catégorie : \'Dégât des eaux\', \'Incendie\', \'Vol\', \'Bris de glace\', \'Tempête\', \'Collision\', \'Catastrophe naturelle\', \'Autre\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "montant_charge",\n          "type": "decimal",\n          "example": "1850,50",\n          "semantics": "Charge totale du sinistre = règlements + provisions (vision actuarielle), en EUR. Inclut les sinistres en cours (provisionnés).",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "montant_recours",\n          "type": "decimal",\n          "example": "0,00",\n          "semantics": "Montant récupéré via recours / subrogation (à déduire de la charge nette)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "statut_sinistre",\n          "type": "string",\n          "example": "Clos",\n          "semantics": "\'Ouvert\', \'En cours d\'\'instruction\', \'Clos\', \'Sans suite\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "gestionnaire_id",\n          "type": "string",\n          "example": "GEST-042",\n          "semantics": "Identifiant du gestionnaire indemnisation en charge",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "clients.csv",\n      "description": "Référentiel souscripteurs (personnes physiques particuliers).",\n      "columns": [\n        {\n          "name": "client_id",\n          "type": "string",\n          "example": "CLI-018734",\n          "semantics": "Identifiant unique client",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "annee_naissance",\n          "type": "integer",\n          "example": "1978",\n          "semantics": "Année de naissance du souscripteur",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "genre",\n          "type": "string",\n          "example": "F",\n          "semantics": "\'F\', \'M\', \'NC\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "csp",\n          "type": "string",\n          "example": "Cadre",\n          "semantics": "Catégorie socio-professionnelle déclarée",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_entree_relation",\n          "type": "string",\n          "example": "12/06/2019",\n          "semantics": "Date d\'entrée en relation client — format JJ/MM/AAAA",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "code_postal_residence",\n          "type": "string",\n          "example": "92100",\n          "semantics": "Code postal de résidence du client (peut différer du lieu du risque)",\n          "is_pk": false,\n          "fk_to": "geographie.code_postal"\n        },\n        {\n          "name": "score_risque",\n          "type": "decimal",\n          "example": "0,42",\n          "semantics": "Score interne de risque (0 = faible, 1 = élevé). Calculé par le moteur actuariel.",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "produits.csv",\n      "description": "Catalogue des produits commercialisés.",\n      "columns": [\n        {\n          "name": "produit_code",\n          "type": "string",\n          "example": "MRH_CONFORT",\n          "semantics": "Code produit",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "produit_libelle",\n          "type": "string",\n          "example": "MRH Formule Confort",\n          "semantics": "Libellé commercial",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "branche",\n          "type": "string",\n          "example": "MRH",\n          "semantics": "Branche : \'MRH\', \'Auto\', \'Affinitaire\'",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "date_lancement",\n          "type": "string",\n          "example": "01/09/2023",\n          "semantics": "Date de mise au catalogue — format JJ/MM/AAAA",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "commission_agent_pct",\n          "type": "decimal",\n          "example": "12,5",\n          "semantics": "Taux de commission versé aux agents généraux, exprimé en POURCENTAGE (ex: 12,5 = 12,5%)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "frais_gestion_pct",\n          "type": "decimal",\n          "example": "0,08",\n          "semantics": "Frais de gestion appliqués, exprimés en TAUX DÉCIMAL (ex: 0,08 = 8%) — héritage de l\'ancien SI",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    },\n    {\n      "filename": "geographie.csv",\n      "description": "Référentiel géographique français (codes postaux).",\n      "columns": [\n        {\n          "name": "code_postal",\n          "type": "string",\n          "example": "75011",\n          "semantics": "Code postal français sur 5 caractères, conservé en texte (zéros initiaux pour la Corse, DOM, etc.)",\n          "is_pk": true,\n          "fk_to": null\n        },\n        {\n          "name": "commune",\n          "type": "string",\n          "example": "Paris 11e",\n          "semantics": "Nom de la commune principale",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "departement",\n          "type": "string",\n          "example": "75",\n          "semantics": "Code département (2 ou 3 caractères)",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "region",\n          "type": "string",\n          "example": "Île-de-France",\n          "semantics": "Région administrative",\n          "is_pk": false,\n          "fk_to": null\n        },\n        {\n          "name": "zonier_tempete",\n          "type": "integer",\n          "example": "3",\n          "semantics": "Zonier tempête interne (1 = faible exposition, 5 = très exposée — littoral atlantique notamment)",\n          "is_pk": false,\n          "fk_to": null\n        }\n      ]\n    }\n  ],\n  "traps": [\n    {\n      "file": "polices.csv / sinistres.csv",\n      "column": "date_effet, date_resiliation, date_entree_relation (FR) vs date_survenance, date_declaration, date_cloture (ISO)",\n      "trap": "Coexistence de deux formats de date dans le même modèle : format français JJ/MM/AAAA dans les fichiers issus de l\'outil de souscription, et format ISO AAAA-MM-JJ dans le fichier sinistres issu du nouveau SI de gestion. Power BI en locale \'French (France)\' interprétera correctement le premier mais peut générer des erreurs ou des inversions jour/mois sur certaines lignes du second selon le paramétrage régional du fichier.",\n      "why_realistic": "Suite à la migration récente du SI de gestion (cf. twist), il est très courant qu\'un assureur se retrouve avec des extracts hétérogènes : l\'outil legacy de souscription exporte en JJ/MM/AAAA, le nouveau outil de gestion sinistres en ISO. Le candidat doit détecter le mélange et typer explicitement chaque colonne dans Power Query."\n    },\n    {\n      "file": "produits.csv",\n      "column": "commission_agent_pct vs frais_gestion_pct",\n      "trap": "Deux colonnes de taux exprimées dans des unités différentes : commission_agent_pct est en POURCENTAGE (12,5 = 12,5%) alors que frais_gestion_pct est en TAUX DÉCIMAL (0,08 = 8%). Un calcul naïf de marge mélangeant les deux donnera des résultats faux d\'un facteur 100.",\n      "why_realistic": "Classique des référentiels produits qui agrègent des champs de plusieurs systèmes historiques. Un Mid-Senior doit lire les libellés/échantillons et harmoniser avant tout calcul de combined ratio ou de rentabilité."\n    },\n    {\n      "file": "sinistres.csv",\n      "column": "montant_charge",\n      "trap": "La \'charge\' inclut à la fois les règlements payés et les provisions sur sinistres encore ouverts (statut \'Ouvert\' ou \'En cours d\'\'instruction\'). Un calcul de S/P (sinistres-à-primes) ne déduisant pas le montant_recours, ou n\'isolant pas les sinistres clos, surestime la sinistralité réelle. De plus, les sinistres très récents sont sous-provisionnés (IBNR non modélisé) — le candidat doit le mentionner comme limite.",\n      "why_realistic": "Vision actuarielle standard en P&C : la charge = payé + provision dossier-dossier, et le S/P brut diffère du S/P net de recours. C\'est le piège de pilotage le plus fréquent et un Mid-Senior en assurance doit le repérer."\n    },\n    {\n      "file": "geographie.csv / polices.csv",\n      "column": "code_postal",\n      "trap": "Code postal stocké en texte avec zéro initial significatif (ex: \'01000\' Bourg-en-Bresse, \'06000\' Nice, codes Corse \'20xxx\' et DOM \'97xxx\'). Si Power BI infère le type \'Nombre entier\' à l\'import, les zéros initiaux sont perdus et la jointure avec geographie.csv casse pour ~3-5% du portefeuille.",\n      "why_realistic": "Erreur d\'import Power Query archi-classique sur données françaises. Très réaliste sur un portefeuille national avec exposition Corse / DOM."\n    }\n  ]\n}\n', name='read_file', tool_call_id='toolu_01PLx6s3CTE2ueBX5hLrepe1'), ToolMessage(content="# Étude de cas — Analyste Data Mid-Senior\n## Pilotage de la sinistralité MRH & tableau de bord indemnisation\n\n---\n\n## 1. Contexte métier\n\nVous rejoignez pour cet exercice une compagnie d'assurance dommages (P&C) de taille intermédiaire, basée à Paris, qui assure environ **500 collaborateurs** et distribue ses contrats à des particuliers français via deux canaux : un réseau d'**agents généraux liés** et un canal **direct en ligne**. Le portefeuille couvre l'**habitation (MRH)**, l'**auto particuliers** et des **garanties affinitaires** (mobile, vélo, voyage).\n\nL'exercice porte spécifiquement sur la **branche MRH (Multirisque Habitation)**, qui représente environ **120 000 polices en cours**. La direction technique constate une dérive du **ratio sinistres-à-primes (S/P)** depuis plusieurs trimestres et souhaite y voir clair. Un facteur de complexité s'ajoute : une **nouvelle formule MRH a été lancée il y a 9 à 12 mois**, et personne n'a encore consolidé son comportement réel par rapport aux formules historiques. La Direction Indemnisation a besoin d'un **tableau de bord opérationnel** pour piloter ses cadences de gestion et alerter en cas de dérive.\n\nVous disposez de **36 mois d'historique** de production et de sinistralité.\n\n---\n\n## 2. Mission\n\nVous devez livrer un **tableau de bord opérationnel indemnisation MRH** sous Power BI Desktop, à destination du responsable Indemnisation et de son N+1 (Directeur Technique).\n\n### 2.1. KPIs attendus (3 à 5)\n\n1. **Ratio S/P (Sinistres à Primes)** — somme des charges de sinistres (règlements + provisions dossier/dossier) sur la période, divisée par les primes acquises sur la même période, exprimé en %.\n2. **Fréquence de sinistralité** — nombre de sinistres déclarés sur la période, rapporté à l'exposition moyenne en années-polices (police × fraction d'année exposée).\n3. **Coût moyen d'un sinistre** — charge totale des sinistres clos ou en cours, divisée par le nombre de sinistres correspondants.\n4. **Délai moyen de règlement** — moyenne, en jours calendaires, entre la date de déclaration et la date du dernier règlement, sur les sinistres clos de la période.\n5. **Taux de sinistres ouverts > 90 jours** — part des sinistres encore ouverts à la date d'analyse dont l'ancienneté de déclaration dépasse 90 jours (indicateur de cadence de gestion).\n\n### 2.2. Visualisations requises (2 à 4)\n\n- Une **courbe d'évolution mensuelle** du S/P sur 36 mois, avec **comparaison ancienne formule vs. nouvelle formule** MRH.\n- Une **vue de décomposition** du S/P par **canal de distribution** (agents liés vs. direct en ligne) et par **zone géographique** (région ou département).\n- Un **tableau opérationnel** des sinistres en cours, triable par ancienneté, gestionnaire, montant provisionné.\n- Une **carte de France** (optionnelle bonus) de la fréquence par département.\n\n### 2.3. Exigence de modélisation\n\nMettre en place un **modèle en étoile** : table de faits sinistres, table de faits/pont polices-exposition, dimensions Police, Client, Produit (formule), Géographie, Date. Les relations doivent être actives, en cardinalité 1-* depuis les dimensions, et la table Date doit être marquée comme telle.\n\n### 2.4. Exigence de qualité de données\n\nIdentifier et documenter (dans une page dédiée du rapport ou un commentaire visible) au moins **un problème de qualité** dans les données fournies — par exemple sinistres sans police rattachée, dates incohérentes (survenance > déclaration), montants négatifs non justifiés, doublons. Préciser comment vous l'avez traité.\n\n### 2.5. Question analytique ouverte\n\n> **La nouvelle formule MRH lancée il y a 9-12 mois présente-t-elle une sinistralité comparable à l'ancienne, ou observe-t-on une dérive (anti-sélection, tarification insuffisante, sinistres plus coûteux) ? Quelle recommandation faites-vous au Directeur Technique ?**\n\nUne page de synthèse (1 visuel + 3-5 lignes de commentaire) est attendue.\n\n---\n\n## 3. Données fournies\n\nCinq fichiers CSV dans `/data/` :\n\n- **`polices.csv`** — une ligne par police MRH. Colonnes : `policy_id` (texte, PK), `client_id` (texte, FK), `product_code` (texte, FK formule), `channel` (texte : `AGENT` / `DIRECT`), `start_date`, `end_date` (dates), `annual_premium` (décimal, € HT), `postal_code` (texte).\n- **`sinistres.csv`** — une ligne par sinistre. Colonnes : `claim_id` (texte, PK), `policy_id` (FK), `loss_date`, `report_date`, `close_date` (dates, `close_date` nullable), `paid_amount` (décimal €), `reserve_amount` (décimal €), `peril` (texte : dégât des eaux, incendie, vol, bris de glace, RC, autre), `status` (texte : `OPEN` / `CLOSED`).\n- **`clients.csv`** — `client_id` (PK), `birth_year` (entier), `segment` (texte), `acquisition_date` (date).\n- **`produits.csv`** — `product_code` (PK), `product_label`, `formula_version` (texte : `V1_HISTO` / `V2_2024`), `launch_date` (date).\n- **`geographie.csv`** — `postal_code` (PK), `commune`, `departement`, `region`.\n\nLes jointures se font sur `policy_id`, `client_id`, `product_code`, `postal_code`.\n\n---\n\n## 4. Livrable attendu (Power BI Desktop)\n\nUn projet **PBIP** (dossier `.Report` + `.SemanticModel`) contenant :\n\n- Le modèle en étoile chargé depuis les CSV via Power Query.\n- Les **mesures DAX** des 5 KPIs, nommées clairement et regroupées dans une table de mesures.\n- Un rapport de **2 à 3 pages** : (1) vue d'ensemble S/P & cadences, (2) zoom nouvelle formule vs. historique, (3) qualité de données / annexe.\n- Une remise zippée du dossier PBIP.\n\n---\n\n## 5. Critères d'évaluation (100 pts)\n\n| Critère | Pts |\n|---|---|\n| Justesse des KPIs (formules, granularité, cohérence métier) | **30** |\n| Qualité du modèle (étoile, relations, table Date, mesures DAX propres) | **20** |\n| Pertinence des visualisations & lisibilité opérationnelle | **20** |\n| Réponse à la question ouverte (nouvelle formule) — analyse + reco | **15** |\n| Traitement de la qualité de données (détection + correction documentée) | **10** |\n| Soin général : nommage, mise en page, commentaires | **5** |\n\n---\n\n## 6. Contraintes pratiques\n\n- **Durée : 75 minutes**, montre en main.\n- **Power BI Desktop** uniquement, livrable **format PBIP**.\n- **Aucun outil d'IA générative** (ChatGPT, Copilot, Gemini, etc.) — la documentation officielle Microsoft et vos notes personnelles sont autorisées.\n- En cas de blocage technique, documentez votre raisonnement dans un commentaire visible : un raisonnement clair vaut mieux qu'un visuel inachevé.\n\nBon courage.\n", name='read_file', tool_call_id='toolu_01JZjwHzWGMWLT4C2Q6f6viW'), AIMessage(content=[{'text': 'Now I have a thorough understanding. Let me write the recruiter solution.', 'type': 'text'}, {'id': 'toolu_01Wxk6q81qWBewmPFg996bdy', 'caller': {'type': 'direct'}, 'input': {'path': 'solution/recruiter_solution.md', 'content': '# Corrigé recruteur — Étude de cas Analyste Data Mid-Senior\n## Pilotage de la sinistralité MRH & tableau de bord indemnisation\n\n**Document confidentiel — usage interne recrutement.**\nCe corrigé sert de référence pour évaluer un candidat Mid-Senior en 75 minutes sur Power BI Desktop / PBIP. Il est calibré sur le scénario MRH (120k polices, 36 mois, lancement nouvelle formule il y a 9-12 mois) défini dans `scenario.json` et le schéma fourni dans `brief/data_schema.json`.\n\n---\n\n## 1. Modèle de données cible (schéma en étoile)\n\n### 1.1. Vue d\'ensemble\n\nLe modèle attendu est un **schéma en étoile classique** avec deux tables de faits et quatre dimensions partagées, plus une dimension Date.\n\n```\n                     ┌──────────────┐\n                     │  DimDate     │\n                     │  (marquée)   │\n                     └──────┬───────┘\n                            │ 1\n              ┌─────────────┼─────────────┐\n              │ *           │ *           │\n       ┌──────▼──────┐  ┌───▼─────────┐\n       │ FactSinistres│  │ FactPolices │  (= table de faits "exposition")\n       └──────┬──────┘  └───┬─────────┘\n              │ *           │ *\n              └──────┬──────┘\n                     │ via police_id\n       ┌─────────────┼─────────────┬──────────────┐\n       │ 1           │ 1           │ 1            │ 1\n   ┌───▼──────┐ ┌────▼──────┐ ┌────▼──────┐ ┌─────▼─────┐\n   │ DimClient│ │ DimProduit│ │DimGeographie│ │DimPolice │\n   └──────────┘ └───────────┘ └────────────┘ └──────────┘\n```\n\n### 1.2. Détail des tables\n\n| Rôle | Table | Grain | PK | Source |\n|---|---|---|---|---|\n| Fait | `FactSinistres` | 1 ligne = 1 sinistre | `sinistre_id` | `sinistres.csv` |\n| Fait | `FactPolices` | 1 ligne = 1 police (et son exposition annualisée) | `police_id` | `polices.csv` |\n| Dimension | `DimPolice` | 1 ligne = 1 police (attributs descriptifs : formule, canal, statut, motif résil.) | `police_id` | `polices.csv` |\n| Dimension | `DimClient` | 1 ligne = 1 client | `client_id` | `clients.csv` |\n| Dimension | `DimProduit` | 1 ligne = 1 produit / formule | `produit_code` | `produits.csv` |\n| Dimension | `DimGeographie` | 1 ligne = 1 code postal | `code_postal` | `geographie.csv` |\n| Dimension | `DimDate` | 1 ligne = 1 jour, 36 mois + 6 mois de marge | `Date` | générée en DAX (`CALENDAR`) |\n| (Mesures) | `_Mesures` | table vide regroupant toutes les mesures DAX | – | créée à la main |\n\n> **Note recruteur** : Un candidat senior peut légitimement choisir de **fusionner `DimPolice` et `FactPolices`** (modèle dégénéré, 1 seule table polices à la fois fait et dim). C\'est acceptable si la fréquence et le S/P sont calculés correctement à partir d\'une exposition explicite. À discuter au debrief.\n\n### 1.3. Relations\n\n| De (côté *) | Vers (côté 1) | Cardinalité | Sens filtre | Active |\n|---|---|---|---|---|\n| `FactSinistres[police_id]` | `DimPolice[police_id]` | * → 1 | Single | ✅ |\n| `FactSinistres[date_survenance]` | `DimDate[Date]` | * → 1 | Single | ✅ (rôle « date de survenance ») |\n| `FactSinistres[date_declaration]` | `DimDate[Date]` | * → 1 | Single | ⚠️ INACTIVE (rôle déclaration, à activer via `USERELATIONSHIP`) |\n| `FactSinistres[date_cloture]` | `DimDate[Date]` | * → 1 | Single | ⚠️ INACTIVE |\n| `FactPolices[police_id]` | `DimPolice[police_id]` | 1 → 1 | Single | ✅ (modèle dégénéré possible) |\n| `FactPolices[date_effet]` | `DimDate[Date]` | * → 1 | Single | ✅ |\n| `DimPolice[client_id]` | `DimClient[client_id]` | * → 1 | Single | ✅ |\n| `DimPolice[produit_code]` | `DimProduit[produit_code]` | * → 1 | Single | ✅ |\n| `DimPolice[code_postal]` | `DimGeographie[code_postal]` | * → 1 | Single | ✅ |\n| `DimClient[code_postal_residence]` | `DimGeographie[code_postal]` | * → 1 | Single | ⚠️ INACTIVE (sinon ambiguïté avec lieu du risque) |\n\n### 1.4. Justifications attendues\n\n- **Étoile vs. flocon** : on garde la géographie comme une seule dimension plate. Pas de hiérarchie normalisée commune→département→région en tables séparées.\n- **`DimDate` marquée comme table de dates** : indispensable pour `TOTALYTD`, `SAMEPERIODLASTYEAR`, time-intelligence générique.\n- **Géographie rattachée au lieu du risque** (et non à la résidence du client) : la sinistralité MRH dépend du bien assuré, pas du domicile fiscal.\n- **Filtre simple (single) partout** : pas de bidirectionnel sauf justification explicite (et rien ici ne le justifie). Risque sinon de double comptage et de circuits ambigus.\n- **Deux tables de faits non reliées directement** : elles communiquent uniquement via `DimPolice`. C\'est conforme aux bonnes pratiques Kimball.\n\n---\n\n## 2. Mesures DAX de référence\n\nToutes les mesures sont à créer dans la table `_Mesures`. Format `#,##0 €` ou `0,0 %` selon le cas.\n\n### 2.1. Mesures de base — exposition et primes\n\n```dax\n-- Nombre de polices distinctes (pour le dénominateur fréquence)\nNb Polices =\nDISTINCTCOUNT ( FactPolices[police_id] )\n\n-- Exposition en années-polices : pour chaque police, la fraction d\'année\n-- réellement couverte sur la période filtrée par DimDate.\n-- Approximation acceptable Mid-Senior : (min(date_resiliation, fin_periode) - max(date_effet, debut_periode)) / 365.25\nAnnees Polices =\nVAR DebutPeriode = MIN ( DimDate[Date] )\nVAR FinPeriode   = MAX ( DimDate[Date] )\nRETURN\n    SUMX (\n        FactPolices,\n        VAR DebutExpo = MAX ( FactPolices[date_effet], DebutPeriode )\n        VAR FinExpo   =\n            MIN (\n                COALESCE ( FactPolices[date_resiliation], FinPeriode ),\n                FinPeriode\n            )\n        VAR Jours = DATEDIFF ( DebutExpo, FinExpo, DAY ) + 1\n        RETURN DIVIDE ( MAX ( Jours, 0 ), 365.25 )\n    )\n\n-- Primes acquises (earned premium) au prorata de l\'exposition.\n-- Approximation : prime annuelle TTC × fraction d\'année exposée sur la période.\n-- ⚠️ Piège : un candidat qui prend SUM(prime_annuelle_ttc) sans prorata\n-- compare des primes annuelles à des sinistres mensuels → S/P faussé.\nPrimes Acquises =\nVAR DebutPeriode = MIN ( DimDate[Date] )\nVAR FinPeriode   = MAX ( DimDate[Date] )\nRETURN\n    SUMX (\n        FactPolices,\n        VAR DebutExpo = MAX ( FactPolices[date_effet], DebutPeriode )\n        VAR FinExpo   =\n            MIN (\n                COALESCE ( FactPolices[date_resiliation], FinPeriode ),\n                FinPeriode\n            )\n        VAR FractAnnee = DIVIDE ( MAX ( DATEDIFF ( DebutExpo, FinExpo, DAY ) + 1, 0 ), 365.25 )\n        RETURN FactPolices[prime_annuelle_ttc] * FractAnnee\n    )\n```\n\n### 2.2. Mesures sinistres\n\n```dax\n-- Charge brute (vue actuarielle = payé + provision)\nCharge Brute =\nSUM ( FactSinistres[montant_charge] )\n\n-- Charge nette de recours (le S/P pertinent en P&C)\nCharge Nette =\nSUMX (\n    FactSinistres,\n    FactSinistres[montant_charge] - FactSinistres[montant_recours]\n)\n\n-- Nombre de sinistres déclarés sur la période (filtré par date de survenance par défaut)\nNb Sinistres =\nDISTINCTCOUNT ( FactSinistres[sinistre_id] )\n\n-- Nombre de sinistres CLOS uniquement (pour coût moyen fiable)\nNb Sinistres Clos =\nCALCULATE (\n    [Nb Sinistres],\n    FactSinistres[statut_sinistre] = "Clos"\n)\n```\n\n### 2.3. KPIs principaux\n\n```dax\n-- KPI 1 : Ratio S/P (sinistres à primes), net de recours.\n-- Formule métier : Charge nette / Primes acquises.\nS/P =\nDIVIDE ( [Charge Nette], [Primes Acquises] )\n\n-- Variante brute, à fournir en complément pour transparence\nS/P Brut =\nDIVIDE ( [Charge Brute], [Primes Acquises] )\n\n-- KPI 2 : Fréquence sinistres (en nb sinistres pour 100 années-polices)\n-- ⚠️ Piège : utiliser DISTINCTCOUNT(police_id) au dénominateur sous-estime\n-- les contrats résiliés en cours de période. Il FAUT l\'exposition annualisée.\nFrequence =\nDIVIDE ( [Nb Sinistres], [Annees Polices] )\n\n-- KPI 3 : Coût moyen sinistre (sur sinistres clos uniquement pour éviter biais provisions)\nCout Moyen Sinistre =\nDIVIDE (\n    CALCULATE ( [Charge Nette], FactSinistres[statut_sinistre] = "Clos" ),\n    [Nb Sinistres Clos]\n)\n\n-- KPI 4 : Délai moyen de règlement (en jours, sur sinistres clos)\nDelai Moyen Reglement =\nAVERAGEX (\n    FILTER (\n        FactSinistres,\n        FactSinistres[statut_sinistre] = "Clos"\n        && NOT ISBLANK ( FactSinistres[date_cloture] )\n    ),\n    DATEDIFF (\n        FactSinistres[date_declaration],\n        FactSinistres[date_cloture],\n        DAY\n    )\n)\n\n-- KPI 5 : Taux de sinistres ouverts > 90 jours (cadence de gestion)\n-- "Ouvert" = statut Ouvert ou En cours d\'instruction\nNb Sinistres Ouverts =\nCALCULATE (\n    [Nb Sinistres],\n    FactSinistres[statut_sinistre] IN { "Ouvert", "En cours d\'instruction" }\n)\n\nNb Sinistres Ouverts >90j =\nVAR DateRef = MAX ( DimDate[Date] )\nRETURN\n    CALCULATE (\n        [Nb Sinistres],\n        FactSinistres[statut_sinistre] IN { "Ouvert", "En cours d\'instruction" },\n        FILTER (\n            FactSinistres,\n            DATEDIFF ( FactSinistres[date_declaration], DateRef, DAY ) > 90\n        )\n    )\n\nTaux Sinistres Ouverts >90j =\nDIVIDE ( [Nb Sinistres Ouverts >90j], [Nb Sinistres Ouverts] )\n```\n\n### 2.4. Mesures de comparaison nouvelle formule vs. historique\n\n```dax\n-- Filtrage par version de formule via DimProduit\nS/P Nouvelle Formule =\nCALCULATE ( [S/P], DimProduit[date_lancement] >= DATE ( 2024, 1, 1 ) )\n\nS/P Formule Historique =\nCALCULATE ( [S/P], DimProduit[date_lancement] < DATE ( 2024, 1, 1 ) )\n\n-- Variation YoY pour la courbe d\'évolution\nS/P N-1 =\nCALCULATE ( [S/P], SAMEPERIODLASTYEAR ( DimDate[Date] ) )\n```\n\n### 2.5. Pièges DAX courants à surveiller\n\n| Piège | Symptôme | Bonne pratique |\n|---|---|---|\n| `SUM(prime_annuelle_ttc)` au dénominateur du S/P | S/P de l\'ordre de 5 % au lieu de 50-70 % | Toujours acquérir les primes au prorata d\'exposition. |\n| `DIVIDE` oublié, division par zéro | `Infinity` ou erreur visuel | `DIVIDE(num, denom)` avec gestion implicite du blank. |\n| Coût moyen sur tous sinistres confondus | Inclut provisions sur sinistres ouverts → biais haussier en fin de période | Filtrer `statut_sinistre = "Clos"`. |\n| Confusion date de survenance / déclaration / clôture | Cadences fausses, S/P attribué au mauvais mois | Une relation ACTIVE (survenance) + `USERELATIONSHIP` pour les autres. |\n| Filtre bidirectionnel `DimPolice ↔ FactSinistres` | Double comptage en cross-filter | Garder en single, utiliser `TREATAS` ou mesures dédiées si besoin. |\n| Intervalles d\'exposition non plafonnés à la période | `Annees Polices` peut dépasser le nombre réel de polices | Borner `DebutExpo`/`FinExpo` par `MIN/MAX(DimDate[Date])`. |\n\n---\n\n## 3. Étapes de préparation des données (Power Query M)\n\n### 3.1. Pipeline attendu, fichier par fichier\n\n#### `polices.csv`\n```m\nlet\n    Source = Csv.Document(File.Contents("...\\polices.csv"),\n        [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n\n    // ⚠️ Piège n°1 : code_postal en TEXTE, surtout pas en nombre\n    // (sinon perte des zéros initiaux : 01000, 06000, 20xxx Corse, 97xxx DOM)\n    Typed = Table.TransformColumnTypes(Promoted, {\n        {"police_id", type text},\n        {"client_id", type text},\n        {"produit_code", type text},\n        {"code_postal", type text},\n        {"canal_distribution", type text},\n        // ⚠️ Piège n°2 : dates en format français JJ/MM/AAAA → typage explicite avec locale "fr-FR"\n        {"date_effet", type date},\n        {"date_resiliation", type date},\n        {"motif_resiliation", type text},\n        // ⚠️ Piège n°3 : virgule décimale française → typage explicite avec locale "fr-FR"\n        {"prime_annuelle_ttc", type number},\n        {"formule", type text},\n        {"statut_contrat", type text}\n    }, "fr-FR"),\n\n    // Padding du code postal sur 5 caractères au cas où\n    PaddedCP = Table.TransformColumns(Typed, {\n        {"code_postal", each Text.PadStart(_, 5, "0"), type text}\n    })\nin\n    PaddedCP\n```\n\n#### `sinistres.csv` — **format de date différent** (twist scénario)\n```m\nlet\n    Source = Csv.Document(File.Contents("...\\sinistres.csv"), ...),\n    Promoted = Table.PromoteHeaders(Source),\n    // Ici les dates sont en format ISO AAAA-MM-JJ (issu du nouveau SI)\n    // → locale "en-US" ou pas de locale, Power BI gère bien l\'ISO nativement\n    Typed = Table.TransformColumnTypes(Promoted, {\n        {"sinistre_id", type text},\n        {"police_id", type text},\n        {"date_survenance", type date},\n        {"date_declaration", type date},\n        {"date_cloture", type date},\n        {"nature_sinistre", type text},\n        {"montant_charge", type number},\n        {"montant_recours", type number},\n        {"statut_sinistre", type text},\n        {"gestionnaire_id", type text}\n    }),\n\n    // Contrôle qualité : flagger les sinistres avec date_survenance > date_declaration\n    AddCoherence = Table.AddColumn(Typed, "_dq_date_ok",\n        each [date_survenance] <= [date_declaration], type logical)\nin\n    AddCoherence\n```\n\n#### `produits.csv` — **harmoniser les unités de taux** (twist)\n```m\n// ⚠️ Piège : commission_agent_pct est en POURCENTAGE (12,5 = 12,5%)\n//             frais_gestion_pct  est en TAUX DÉCIMAL (0,08 = 8%)\n// Choix : tout ramener en taux décimal côté modèle.\nAddNormalized = Table.AddColumn(Typed, "commission_agent_taux",\n    each [commission_agent_pct] / 100, type number)\n```\n\n#### `geographie.csv`\n- Code postal en `text`, padding 5 caractères, départements en text (à cause des « 2A », « 2B » de Corse).\n\n### 3.2. Contrôles qualité à effectuer (à documenter dans une page « Qualité données »)\n\n| Contrôle | Méthode | Action attendue |\n|---|---|---|\n| Sinistres orphelins (police_id absent de polices.csv) | `Table.Join` ou anti-join | Lister, exclure ou rattacher à une police « inconnue ». |\n| `date_survenance > date_declaration` | Colonne calculée logique | Flagger, exclure du S/P, mentionner volume. |\n| `date_cloture < date_declaration` | idem | idem |\n| `montant_charge < 0` ou `montant_recours > montant_charge` | filtre | À documenter, en général non, mais possible sur recours postérieurs. |\n| Codes postaux non présents dans `geographie.csv` | merge anti-join | Compléter ou rattacher à « Inconnu ». |\n| Doublons sur `sinistre_id` ou `police_id` | `Table.Distinct` + comptage | Doit être 0. |\n\n### 3.3. Table Date (à créer en DAX, plus simple que M ici)\n\n```dax\nDimDate =\nADDCOLUMNS (\n    CALENDAR ( DATE ( 2022, 1, 1 ), DATE ( 2025, 12, 31 ) ),\n    "Annee", YEAR ( [Date] ),\n    "Mois", FORMAT ( [Date], "MMM YYYY" ),\n    "MoisNum", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),\n    "Trimestre", "T" & FORMAT ( [Date], "Q YYYY" ),\n    "AnneeMois", FORMAT ( [Date], "YYYY-MM" )\n)\n```\nPuis **Marquer comme table de dates** sur la colonne `Date`.\n\n---\n\n## 4. Plan de visualisation page par page\n\nLe rapport tient en **3 pages** comme demandé dans le brief.\n\n### Page 1 — « Vue d\'ensemble — pilotage S/P MRH »\n*Audience : Directeur Technique, lecture rapide*\n\n- **Bandeau KPI cards (haut de page)** : S/P, Fréquence, Coût moyen, Délai moyen règlement, Taux ouverts > 90j. Avec variation vs. N-1.\n- **Courbe mensuelle S/P** sur 36 mois, avec ligne de cible (ex. 65 %) et bande N-1 en arrière-plan.\n- **Décomposition S/P par canal de distribution** (barres horizontales : Agent vs. Direct) + par région (top 5 / flop 5).\n- **Slicers** : période, branche (verrouillée sur MRH), formule, canal.\n\n### Page 2 — « Zoom nouvelle formule vs. historique »\n*Audience : Directeur Technique + actuariat*\n\n- **Courbe S/P comparée** : Nouvelle formule (ligne pleine) vs. Formule historique (ligne pointillée), depuis lancement.\n- **Petits multiples** : fréquence, coût moyen, prime moyenne, score de risque moyen, par formule.\n- **Distribution des sinistres par nature** (dégât des eaux, incendie, etc.) — barres empilées 100 % par formule.\n- **Tableau récapitulatif** avec test de significativité visuel (delta + flèche couleur).\n- **Zone de commentaire** (textbox) : 3-5 lignes de synthèse rédigée par le candidat répondant à la question ouverte.\n\n### Page 3 — « Tableau opérationnel indemnisation + qualité de données »\n*Audience : Responsable Indemnisation*\n\n- **Tableau des sinistres en cours** : sinistre_id, gestionnaire, nature, ancienneté en jours, charge provisionnée, statut. Triable, filtrable, mise en forme conditionnelle sur ancienneté > 90 jours.\n- **Carte de France** (bonus) : fréquence par département, zonier tempête en filtre.\n- **Encart qualité de données** en bas de page : volumétrie des anomalies détectées (orphelins, dates incohérentes, CP invalides) + traitement appliqué.\n\n---\n\n## 5. Réponse modèle à la question ouverte\n\n> *La nouvelle formule MRH lancée il y a 9-12 mois présente-t-elle une sinistralité comparable à l\'ancienne, ou observe-t-on une dérive ?*\n\n**Réponse type attendue (3-4 paragraphes) :**\n\nLa nouvelle formule MRH affiche, sur ses 9 à 12 premiers mois de commercialisation, un **ratio S/P sensiblement supérieur** à celui des formules historiques sur la même période d\'ancienneté contractuelle. L\'écart provient principalement de deux effets : une **fréquence de sinistralité plus élevée** (notamment sur les natures « dégât des eaux » et « vol »), et un **coût moyen légèrement supérieur**, vraisemblablement lié au périmètre de garanties élargi. Mécaniquement, le S/P dérive autour de 75-80 % contre 60-65 % pour la formule historique sur cohorte équivalente.\n\nPlusieurs hypothèses doivent être testées avant de conclure à un défaut de tarification. La première est **l\'anti-sélection** : la nouvelle formule, plus généreuse, attire prioritairement des profils ayant un besoin de couverture supérieur (logements à risque, sinistralité passée non déclarée). On le vérifie en comparant le **score de risque moyen** des souscripteurs des deux formules — si l\'écart est marqué, l\'effet portefeuille explique une partie de la dérive. La seconde est l\'**effet maturité** : un portefeuille jeune subit moins de résiliations volontaires et concentre les déclarations de sinistres récents, ce qui amplifie le S/P apparent (effet « courbe de développement » bien connu en P&C).\n\nEnfin, il faut souligner les **limites du chiffrage** : 9-12 mois d\'historique sur la nouvelle formule sont insuffisants pour stabiliser un S/P (sinistres tardifs / IBNR non modélisés, provisions dossier-dossier en cours d\'ajustement). Un retraitement en S/P ultime, ou a minima une comparaison à *cohorte d\'ancienneté constante* (ex. 6 premiers mois vs. 6 premiers mois), est indispensable pour ne pas surinterpréter la photo actuelle.\n\n**Recommandation** : alerter le Directeur Technique sur la dérive *apparente* (chiffres clés à fournir) tout en précisant l\'incertitude résiduelle ; lancer en parallèle (a) une analyse de **profil de risque entrant** sur la nouvelle formule, (b) un suivi mensuel dédié avec triggers d\'alerte à 70 % et 80 % de S/P, (c) une revue actuarielle de la tarification à 6 mois si la tendance se confirme. Ne **pas** recommander à ce stade un retrait commercial : le signal est trop précoce.\n\n---\n\n## 6. Grille d\'évaluation détaillée (100 pts)\n\n### 6.1. Critère 1 — Justesse des KPIs (30 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 27-30 | Les 5 KPIs sont implémentés ; S/P utilise des **primes acquises au prorata d\'exposition** ; fréquence calculée sur **années-polices** ; coût moyen restreint aux sinistres **clos** ; recours déduits ; mention explicite des limites (IBNR, période courte). |\n| **Bon** | 21-26 | Les 5 KPIs sont là, formules globalement correctes ; petit raccourci toléré (ex. primes annuelles brutes ou nb polices au dénominateur fréquence) mais cohérent et documenté. |\n| **Moyen** | 12-20 | 3-4 KPIs présents ; au moins une formule métier discutable (S/P brut sans recours, coût moyen sur tous sinistres, exposition mal calculée). |\n| **Faible** | 0-11 | Moins de 3 KPIs ; erreurs de fond (somme des charges divisée par somme de primes annuelles sans prorata, double comptage, oubli de DIVIDE). |\n\n### 6.2. Critère 2 — Qualité du modèle (20 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | Étoile propre, 2 faits + 4 dims + DimDate marquée ; relations 1-* en single direction ; relations inactives gérées via `USERELATIONSHIP` ; table `_Mesures` dédiée ; nommage cohérent FR ; pas de colonnes calculées superflues. |\n| **Bon** | 14-17 | Étoile correcte, DimDate en place, relations actives bien posées, 1-2 imperfections (pas de USERELATIONSHIP, table de mesures absente, quelques colonnes au lieu de mesures). |\n| **Moyen** | 8-13 | Modèle « plat » à plusieurs faits non rattachés à une DimDate, ou bidirectionnel non justifié, ou granularité confuse polices/sinistres. |\n| **Faible** | 0-7 | Pas de modèle (toutes les requêtes fusionnées en 1 table), ou relations cassées, ou DimDate absente. |\n\n### 6.3. Critère 3 — Visualisations & lisibilité (20 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | 3 pages cohérentes, hiérarchie visuelle claire, slicers pertinents, courbes lisibles, comparatif nouvelle/ancienne formule explicite, mise en forme conditionnelle sur le tableau opérationnel. |\n| **Bon** | 14-17 | 2-3 pages, KPIs visibles, 1-2 visuels essentiels présents mais quelques choix discutables (camembert mal calibré, slicer manquant). |\n| **Moyen** | 8-13 | Visuels présents mais peu lisibles, échelles incohérentes, pas de comparatif clair. |\n| **Faible** | 0-7 | Une seule page, visuels Power BI par défaut sans mise en forme, ou KPI non visibles. |\n\n### 6.4. Critère 4 — Question ouverte (15 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 13-15 | Réponse structurée constat / hypothèses (anti-sélection, maturité) / limites (IBNR, ancienneté courte) / recommandation actionnable et nuancée. |\n| **Bon** | 9-12 | Constat chiffré + 1-2 hypothèses + reco, mais sans mention des limites statistiques. |\n| **Moyen** | 5-8 | Simple description du constat, pas d\'hypothèses ni de reco. |\n| **Faible** | 0-4 | Pas de réponse ou réponse hors sol (« la nouvelle formule est meilleure car son S/P est de 80 % »). |\n\n### 6.5. Critère 5 — Qualité de données (10 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 9-10 | Au moins 2 problèmes détectés (formats de dates hétérogènes, codes postaux, taux mixés, dates incohérentes) + traitement documenté + volumétrie chiffrée. |\n| **Bon** | 6-8 | 1 problème détecté + traitement explicite. |\n| **Moyen** | 3-5 | Mention vague d\'un contrôle, sans correction explicite. |\n| **Faible** | 0-2 | Aucune trace de contrôle qualité. |\n\n### 6.6. Critère 6 — Soin général (5 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 5 | Nommage cohérent, mise en page soignée, commentaires DAX, titres explicites. |\n| **Bon** | 3-4 | Globalement soigné, 1-2 incohérences. |\n| **Moyen** | 1-2 | Visuels par défaut, noms `Measure 1`. |\n| **Faible** | 0 | Brouillon non livrable. |\n\n---\n\n## 7. Red flags & strong signals\n\n### 7.1. 🚩 5 Red flags (à challenger en debrief, voire éliminatoire)\n\n1. **S/P calculé en divisant la charge par la somme des `prime_annuelle_ttc`** sans prorata d\'exposition → trahit une méconnaissance de la notion de prime acquise, fondamentale en P&C.\n2. **Mélange des unités de taux** entre `commission_agent_pct` (en %) et `frais_gestion_pct` (en taux décimal) sans s\'en apercevoir → manque de rigueur sur la lecture des données et les ordres de grandeur.\n3. **Codes postaux importés en numérique** : perte des zéros initiaux, ~3-5 % du portefeuille hors jointure, sans que le candidat le détecte → faille classique non rattrapée.\n4. **Coût moyen calculé sur tous les sinistres** (ouverts + clos) : montre que le candidat n\'a pas conscience que la charge inclut les provisions et que les sinistres récents sont sous-évalués.\n5. **Conclusion catégorique sur la nouvelle formule** (« il faut la retirer ») sans mention de l\'horizon court ni de l\'IBNR → manque de réflexe statistique et risque opérationnel pour le métier.\n\n### 7.2. ✅ 5 Strong signals (à valoriser)\n\n1. **Mention spontanée de la cohorte / courbe de développement** quand on parle de la nouvelle formule : signe d\'une vraie culture P&C.\n2. **Création d\'une table `_Mesures` dédiée** + nommage cohérent en français + commentaires DAX → rigueur de senior.\n3. **Distinction explicite S/P brut vs. S/P net de recours** dans la livraison.\n4. **Détection proactive du double format de date** (FR vs. ISO) en commentaire ou en note Power Query.\n5. **Recommandation nuancée et actionnable** au Directeur Technique : alerter sans alarmer, plan d\'investigation, seuils de re-revue → posture de business partner et pas seulement de producteur de chiffres.\n\n---\n\n## 8. Questions de debrief (15-20 minutes après remise)\n\n1. **Justesse métier** — *« Pouvez-vous me détailler la formule exacte de votre S/P ? Pourquoi avez-vous choisi cette définition de prime au dénominateur, et quel impact aurait sur le résultat un S/P brut vs. net de recours ? »*\n   → vérifie la maîtrise de la prime acquise et des recours.\n\n2. **Modélisation** — *« Si demain on ajoute la branche Auto avec son propre fichier sinistres et primes, comment ferait évoluer votre modèle ? Quelles dimensions sont mutualisables, lesquelles devront être versionnées ? »*\n   → teste la capacité à anticiper la scalabilité du modèle.\n\n3. **Question ouverte** — *« Vous concluez que la nouvelle formule dérive. Sur quelles preuves chiffrées vous appuyez-vous, et qu\'est-ce qui pourrait infirmer cette conclusion dans 6 mois ? »*\n   → mesure l\'humilité statistique et la pensée probabiliste.\n\n4. **Qualité de données** — *« Vous avez détecté X anomalies. Si on doit livrer ce dashboard en production demain, quelles règles de gouvernance proposez-vous pour qu\'elles ne reviennent pas ? Qui les pilote ? »*\n   → évalue la dimension data governance, attendue à un niveau Mid-Senior.\n\n5. **Communication / posture** — *« Vous présentez ce dashboard au Directeur Technique lundi matin. Vous avez 5 minutes. Quel est votre message principal, et qu\'est-ce que vous ne montrez surtout pas ? »*\n   → teste la capacité à prioriser et à faire preuve de jugement, au-delà de l\'exécution technique.\n\n---\n\n*Fin du corrigé recruteur.*\n'}, 'name': 'write_file', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_017rQahBLxUhSeE6h9rgeWYJ', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 11099, 'output_tokens': 12127, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de3f9-db84-7b03-b8f0-10768d29b40d-0', tool_calls=[{'name': 'write_file', 'args': {'path': 'solution/recruiter_solution.md', 'content': '# Corrigé recruteur — Étude de cas Analyste Data Mid-Senior\n## Pilotage de la sinistralité MRH & tableau de bord indemnisation\n\n**Document confidentiel — usage interne recrutement.**\nCe corrigé sert de référence pour évaluer un candidat Mid-Senior en 75 minutes sur Power BI Desktop / PBIP. Il est calibré sur le scénario MRH (120k polices, 36 mois, lancement nouvelle formule il y a 9-12 mois) défini dans `scenario.json` et le schéma fourni dans `brief/data_schema.json`.\n\n---\n\n## 1. Modèle de données cible (schéma en étoile)\n\n### 1.1. Vue d\'ensemble\n\nLe modèle attendu est un **schéma en étoile classique** avec deux tables de faits et quatre dimensions partagées, plus une dimension Date.\n\n```\n                     ┌──────────────┐\n                     │  DimDate     │\n                     │  (marquée)   │\n                     └──────┬───────┘\n                            │ 1\n              ┌─────────────┼─────────────┐\n              │ *           │ *           │\n       ┌──────▼──────┐  ┌───▼─────────┐\n       │ FactSinistres│  │ FactPolices │  (= table de faits "exposition")\n       └──────┬──────┘  └───┬─────────┘\n              │ *           │ *\n              └──────┬──────┘\n                     │ via police_id\n       ┌─────────────┼─────────────┬──────────────┐\n       │ 1           │ 1           │ 1            │ 1\n   ┌───▼──────┐ ┌────▼──────┐ ┌────▼──────┐ ┌─────▼─────┐\n   │ DimClient│ │ DimProduit│ │DimGeographie│ │DimPolice │\n   └──────────┘ └───────────┘ └────────────┘ └──────────┘\n```\n\n### 1.2. Détail des tables\n\n| Rôle | Table | Grain | PK | Source |\n|---|---|---|---|---|\n| Fait | `FactSinistres` | 1 ligne = 1 sinistre | `sinistre_id` | `sinistres.csv` |\n| Fait | `FactPolices` | 1 ligne = 1 police (et son exposition annualisée) | `police_id` | `polices.csv` |\n| Dimension | `DimPolice` | 1 ligne = 1 police (attributs descriptifs : formule, canal, statut, motif résil.) | `police_id` | `polices.csv` |\n| Dimension | `DimClient` | 1 ligne = 1 client | `client_id` | `clients.csv` |\n| Dimension | `DimProduit` | 1 ligne = 1 produit / formule | `produit_code` | `produits.csv` |\n| Dimension | `DimGeographie` | 1 ligne = 1 code postal | `code_postal` | `geographie.csv` |\n| Dimension | `DimDate` | 1 ligne = 1 jour, 36 mois + 6 mois de marge | `Date` | générée en DAX (`CALENDAR`) |\n| (Mesures) | `_Mesures` | table vide regroupant toutes les mesures DAX | – | créée à la main |\n\n> **Note recruteur** : Un candidat senior peut légitimement choisir de **fusionner `DimPolice` et `FactPolices`** (modèle dégénéré, 1 seule table polices à la fois fait et dim). C\'est acceptable si la fréquence et le S/P sont calculés correctement à partir d\'une exposition explicite. À discuter au debrief.\n\n### 1.3. Relations\n\n| De (côté *) | Vers (côté 1) | Cardinalité | Sens filtre | Active |\n|---|---|---|---|---|\n| `FactSinistres[police_id]` | `DimPolice[police_id]` | * → 1 | Single | ✅ |\n| `FactSinistres[date_survenance]` | `DimDate[Date]` | * → 1 | Single | ✅ (rôle « date de survenance ») |\n| `FactSinistres[date_declaration]` | `DimDate[Date]` | * → 1 | Single | ⚠️ INACTIVE (rôle déclaration, à activer via `USERELATIONSHIP`) |\n| `FactSinistres[date_cloture]` | `DimDate[Date]` | * → 1 | Single | ⚠️ INACTIVE |\n| `FactPolices[police_id]` | `DimPolice[police_id]` | 1 → 1 | Single | ✅ (modèle dégénéré possible) |\n| `FactPolices[date_effet]` | `DimDate[Date]` | * → 1 | Single | ✅ |\n| `DimPolice[client_id]` | `DimClient[client_id]` | * → 1 | Single | ✅ |\n| `DimPolice[produit_code]` | `DimProduit[produit_code]` | * → 1 | Single | ✅ |\n| `DimPolice[code_postal]` | `DimGeographie[code_postal]` | * → 1 | Single | ✅ |\n| `DimClient[code_postal_residence]` | `DimGeographie[code_postal]` | * → 1 | Single | ⚠️ INACTIVE (sinon ambiguïté avec lieu du risque) |\n\n### 1.4. Justifications attendues\n\n- **Étoile vs. flocon** : on garde la géographie comme une seule dimension plate. Pas de hiérarchie normalisée commune→département→région en tables séparées.\n- **`DimDate` marquée comme table de dates** : indispensable pour `TOTALYTD`, `SAMEPERIODLASTYEAR`, time-intelligence générique.\n- **Géographie rattachée au lieu du risque** (et non à la résidence du client) : la sinistralité MRH dépend du bien assuré, pas du domicile fiscal.\n- **Filtre simple (single) partout** : pas de bidirectionnel sauf justification explicite (et rien ici ne le justifie). Risque sinon de double comptage et de circuits ambigus.\n- **Deux tables de faits non reliées directement** : elles communiquent uniquement via `DimPolice`. C\'est conforme aux bonnes pratiques Kimball.\n\n---\n\n## 2. Mesures DAX de référence\n\nToutes les mesures sont à créer dans la table `_Mesures`. Format `#,##0 €` ou `0,0 %` selon le cas.\n\n### 2.1. Mesures de base — exposition et primes\n\n```dax\n-- Nombre de polices distinctes (pour le dénominateur fréquence)\nNb Polices =\nDISTINCTCOUNT ( FactPolices[police_id] )\n\n-- Exposition en années-polices : pour chaque police, la fraction d\'année\n-- réellement couverte sur la période filtrée par DimDate.\n-- Approximation acceptable Mid-Senior : (min(date_resiliation, fin_periode) - max(date_effet, debut_periode)) / 365.25\nAnnees Polices =\nVAR DebutPeriode = MIN ( DimDate[Date] )\nVAR FinPeriode   = MAX ( DimDate[Date] )\nRETURN\n    SUMX (\n        FactPolices,\n        VAR DebutExpo = MAX ( FactPolices[date_effet], DebutPeriode )\n        VAR FinExpo   =\n            MIN (\n                COALESCE ( FactPolices[date_resiliation], FinPeriode ),\n                FinPeriode\n            )\n        VAR Jours = DATEDIFF ( DebutExpo, FinExpo, DAY ) + 1\n        RETURN DIVIDE ( MAX ( Jours, 0 ), 365.25 )\n    )\n\n-- Primes acquises (earned premium) au prorata de l\'exposition.\n-- Approximation : prime annuelle TTC × fraction d\'année exposée sur la période.\n-- ⚠️ Piège : un candidat qui prend SUM(prime_annuelle_ttc) sans prorata\n-- compare des primes annuelles à des sinistres mensuels → S/P faussé.\nPrimes Acquises =\nVAR DebutPeriode = MIN ( DimDate[Date] )\nVAR FinPeriode   = MAX ( DimDate[Date] )\nRETURN\n    SUMX (\n        FactPolices,\n        VAR DebutExpo = MAX ( FactPolices[date_effet], DebutPeriode )\n        VAR FinExpo   =\n            MIN (\n                COALESCE ( FactPolices[date_resiliation], FinPeriode ),\n                FinPeriode\n            )\n        VAR FractAnnee = DIVIDE ( MAX ( DATEDIFF ( DebutExpo, FinExpo, DAY ) + 1, 0 ), 365.25 )\n        RETURN FactPolices[prime_annuelle_ttc] * FractAnnee\n    )\n```\n\n### 2.2. Mesures sinistres\n\n```dax\n-- Charge brute (vue actuarielle = payé + provision)\nCharge Brute =\nSUM ( FactSinistres[montant_charge] )\n\n-- Charge nette de recours (le S/P pertinent en P&C)\nCharge Nette =\nSUMX (\n    FactSinistres,\n    FactSinistres[montant_charge] - FactSinistres[montant_recours]\n)\n\n-- Nombre de sinistres déclarés sur la période (filtré par date de survenance par défaut)\nNb Sinistres =\nDISTINCTCOUNT ( FactSinistres[sinistre_id] )\n\n-- Nombre de sinistres CLOS uniquement (pour coût moyen fiable)\nNb Sinistres Clos =\nCALCULATE (\n    [Nb Sinistres],\n    FactSinistres[statut_sinistre] = "Clos"\n)\n```\n\n### 2.3. KPIs principaux\n\n```dax\n-- KPI 1 : Ratio S/P (sinistres à primes), net de recours.\n-- Formule métier : Charge nette / Primes acquises.\nS/P =\nDIVIDE ( [Charge Nette], [Primes Acquises] )\n\n-- Variante brute, à fournir en complément pour transparence\nS/P Brut =\nDIVIDE ( [Charge Brute], [Primes Acquises] )\n\n-- KPI 2 : Fréquence sinistres (en nb sinistres pour 100 années-polices)\n-- ⚠️ Piège : utiliser DISTINCTCOUNT(police_id) au dénominateur sous-estime\n-- les contrats résiliés en cours de période. Il FAUT l\'exposition annualisée.\nFrequence =\nDIVIDE ( [Nb Sinistres], [Annees Polices] )\n\n-- KPI 3 : Coût moyen sinistre (sur sinistres clos uniquement pour éviter biais provisions)\nCout Moyen Sinistre =\nDIVIDE (\n    CALCULATE ( [Charge Nette], FactSinistres[statut_sinistre] = "Clos" ),\n    [Nb Sinistres Clos]\n)\n\n-- KPI 4 : Délai moyen de règlement (en jours, sur sinistres clos)\nDelai Moyen Reglement =\nAVERAGEX (\n    FILTER (\n        FactSinistres,\n        FactSinistres[statut_sinistre] = "Clos"\n        && NOT ISBLANK ( FactSinistres[date_cloture] )\n    ),\n    DATEDIFF (\n        FactSinistres[date_declaration],\n        FactSinistres[date_cloture],\n        DAY\n    )\n)\n\n-- KPI 5 : Taux de sinistres ouverts > 90 jours (cadence de gestion)\n-- "Ouvert" = statut Ouvert ou En cours d\'instruction\nNb Sinistres Ouverts =\nCALCULATE (\n    [Nb Sinistres],\n    FactSinistres[statut_sinistre] IN { "Ouvert", "En cours d\'instruction" }\n)\n\nNb Sinistres Ouverts >90j =\nVAR DateRef = MAX ( DimDate[Date] )\nRETURN\n    CALCULATE (\n        [Nb Sinistres],\n        FactSinistres[statut_sinistre] IN { "Ouvert", "En cours d\'instruction" },\n        FILTER (\n            FactSinistres,\n            DATEDIFF ( FactSinistres[date_declaration], DateRef, DAY ) > 90\n        )\n    )\n\nTaux Sinistres Ouverts >90j =\nDIVIDE ( [Nb Sinistres Ouverts >90j], [Nb Sinistres Ouverts] )\n```\n\n### 2.4. Mesures de comparaison nouvelle formule vs. historique\n\n```dax\n-- Filtrage par version de formule via DimProduit\nS/P Nouvelle Formule =\nCALCULATE ( [S/P], DimProduit[date_lancement] >= DATE ( 2024, 1, 1 ) )\n\nS/P Formule Historique =\nCALCULATE ( [S/P], DimProduit[date_lancement] < DATE ( 2024, 1, 1 ) )\n\n-- Variation YoY pour la courbe d\'évolution\nS/P N-1 =\nCALCULATE ( [S/P], SAMEPERIODLASTYEAR ( DimDate[Date] ) )\n```\n\n### 2.5. Pièges DAX courants à surveiller\n\n| Piège | Symptôme | Bonne pratique |\n|---|---|---|\n| `SUM(prime_annuelle_ttc)` au dénominateur du S/P | S/P de l\'ordre de 5 % au lieu de 50-70 % | Toujours acquérir les primes au prorata d\'exposition. |\n| `DIVIDE` oublié, division par zéro | `Infinity` ou erreur visuel | `DIVIDE(num, denom)` avec gestion implicite du blank. |\n| Coût moyen sur tous sinistres confondus | Inclut provisions sur sinistres ouverts → biais haussier en fin de période | Filtrer `statut_sinistre = "Clos"`. |\n| Confusion date de survenance / déclaration / clôture | Cadences fausses, S/P attribué au mauvais mois | Une relation ACTIVE (survenance) + `USERELATIONSHIP` pour les autres. |\n| Filtre bidirectionnel `DimPolice ↔ FactSinistres` | Double comptage en cross-filter | Garder en single, utiliser `TREATAS` ou mesures dédiées si besoin. |\n| Intervalles d\'exposition non plafonnés à la période | `Annees Polices` peut dépasser le nombre réel de polices | Borner `DebutExpo`/`FinExpo` par `MIN/MAX(DimDate[Date])`. |\n\n---\n\n## 3. Étapes de préparation des données (Power Query M)\n\n### 3.1. Pipeline attendu, fichier par fichier\n\n#### `polices.csv`\n```m\nlet\n    Source = Csv.Document(File.Contents("...\\polices.csv"),\n        [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n\n    // ⚠️ Piège n°1 : code_postal en TEXTE, surtout pas en nombre\n    // (sinon perte des zéros initiaux : 01000, 06000, 20xxx Corse, 97xxx DOM)\n    Typed = Table.TransformColumnTypes(Promoted, {\n        {"police_id", type text},\n        {"client_id", type text},\n        {"produit_code", type text},\n        {"code_postal", type text},\n        {"canal_distribution", type text},\n        // ⚠️ Piège n°2 : dates en format français JJ/MM/AAAA → typage explicite avec locale "fr-FR"\n        {"date_effet", type date},\n        {"date_resiliation", type date},\n        {"motif_resiliation", type text},\n        // ⚠️ Piège n°3 : virgule décimale française → typage explicite avec locale "fr-FR"\n        {"prime_annuelle_ttc", type number},\n        {"formule", type text},\n        {"statut_contrat", type text}\n    }, "fr-FR"),\n\n    // Padding du code postal sur 5 caractères au cas où\n    PaddedCP = Table.TransformColumns(Typed, {\n        {"code_postal", each Text.PadStart(_, 5, "0"), type text}\n    })\nin\n    PaddedCP\n```\n\n#### `sinistres.csv` — **format de date différent** (twist scénario)\n```m\nlet\n    Source = Csv.Document(File.Contents("...\\sinistres.csv"), ...),\n    Promoted = Table.PromoteHeaders(Source),\n    // Ici les dates sont en format ISO AAAA-MM-JJ (issu du nouveau SI)\n    // → locale "en-US" ou pas de locale, Power BI gère bien l\'ISO nativement\n    Typed = Table.TransformColumnTypes(Promoted, {\n        {"sinistre_id", type text},\n        {"police_id", type text},\n        {"date_survenance", type date},\n        {"date_declaration", type date},\n        {"date_cloture", type date},\n        {"nature_sinistre", type text},\n        {"montant_charge", type number},\n        {"montant_recours", type number},\n        {"statut_sinistre", type text},\n        {"gestionnaire_id", type text}\n    }),\n\n    // Contrôle qualité : flagger les sinistres avec date_survenance > date_declaration\n    AddCoherence = Table.AddColumn(Typed, "_dq_date_ok",\n        each [date_survenance] <= [date_declaration], type logical)\nin\n    AddCoherence\n```\n\n#### `produits.csv` — **harmoniser les unités de taux** (twist)\n```m\n// ⚠️ Piège : commission_agent_pct est en POURCENTAGE (12,5 = 12,5%)\n//             frais_gestion_pct  est en TAUX DÉCIMAL (0,08 = 8%)\n// Choix : tout ramener en taux décimal côté modèle.\nAddNormalized = Table.AddColumn(Typed, "commission_agent_taux",\n    each [commission_agent_pct] / 100, type number)\n```\n\n#### `geographie.csv`\n- Code postal en `text`, padding 5 caractères, départements en text (à cause des « 2A », « 2B » de Corse).\n\n### 3.2. Contrôles qualité à effectuer (à documenter dans une page « Qualité données »)\n\n| Contrôle | Méthode | Action attendue |\n|---|---|---|\n| Sinistres orphelins (police_id absent de polices.csv) | `Table.Join` ou anti-join | Lister, exclure ou rattacher à une police « inconnue ». |\n| `date_survenance > date_declaration` | Colonne calculée logique | Flagger, exclure du S/P, mentionner volume. |\n| `date_cloture < date_declaration` | idem | idem |\n| `montant_charge < 0` ou `montant_recours > montant_charge` | filtre | À documenter, en général non, mais possible sur recours postérieurs. |\n| Codes postaux non présents dans `geographie.csv` | merge anti-join | Compléter ou rattacher à « Inconnu ». |\n| Doublons sur `sinistre_id` ou `police_id` | `Table.Distinct` + comptage | Doit être 0. |\n\n### 3.3. Table Date (à créer en DAX, plus simple que M ici)\n\n```dax\nDimDate =\nADDCOLUMNS (\n    CALENDAR ( DATE ( 2022, 1, 1 ), DATE ( 2025, 12, 31 ) ),\n    "Annee", YEAR ( [Date] ),\n    "Mois", FORMAT ( [Date], "MMM YYYY" ),\n    "MoisNum", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),\n    "Trimestre", "T" & FORMAT ( [Date], "Q YYYY" ),\n    "AnneeMois", FORMAT ( [Date], "YYYY-MM" )\n)\n```\nPuis **Marquer comme table de dates** sur la colonne `Date`.\n\n---\n\n## 4. Plan de visualisation page par page\n\nLe rapport tient en **3 pages** comme demandé dans le brief.\n\n### Page 1 — « Vue d\'ensemble — pilotage S/P MRH »\n*Audience : Directeur Technique, lecture rapide*\n\n- **Bandeau KPI cards (haut de page)** : S/P, Fréquence, Coût moyen, Délai moyen règlement, Taux ouverts > 90j. Avec variation vs. N-1.\n- **Courbe mensuelle S/P** sur 36 mois, avec ligne de cible (ex. 65 %) et bande N-1 en arrière-plan.\n- **Décomposition S/P par canal de distribution** (barres horizontales : Agent vs. Direct) + par région (top 5 / flop 5).\n- **Slicers** : période, branche (verrouillée sur MRH), formule, canal.\n\n### Page 2 — « Zoom nouvelle formule vs. historique »\n*Audience : Directeur Technique + actuariat*\n\n- **Courbe S/P comparée** : Nouvelle formule (ligne pleine) vs. Formule historique (ligne pointillée), depuis lancement.\n- **Petits multiples** : fréquence, coût moyen, prime moyenne, score de risque moyen, par formule.\n- **Distribution des sinistres par nature** (dégât des eaux, incendie, etc.) — barres empilées 100 % par formule.\n- **Tableau récapitulatif** avec test de significativité visuel (delta + flèche couleur).\n- **Zone de commentaire** (textbox) : 3-5 lignes de synthèse rédigée par le candidat répondant à la question ouverte.\n\n### Page 3 — « Tableau opérationnel indemnisation + qualité de données »\n*Audience : Responsable Indemnisation*\n\n- **Tableau des sinistres en cours** : sinistre_id, gestionnaire, nature, ancienneté en jours, charge provisionnée, statut. Triable, filtrable, mise en forme conditionnelle sur ancienneté > 90 jours.\n- **Carte de France** (bonus) : fréquence par département, zonier tempête en filtre.\n- **Encart qualité de données** en bas de page : volumétrie des anomalies détectées (orphelins, dates incohérentes, CP invalides) + traitement appliqué.\n\n---\n\n## 5. Réponse modèle à la question ouverte\n\n> *La nouvelle formule MRH lancée il y a 9-12 mois présente-t-elle une sinistralité comparable à l\'ancienne, ou observe-t-on une dérive ?*\n\n**Réponse type attendue (3-4 paragraphes) :**\n\nLa nouvelle formule MRH affiche, sur ses 9 à 12 premiers mois de commercialisation, un **ratio S/P sensiblement supérieur** à celui des formules historiques sur la même période d\'ancienneté contractuelle. L\'écart provient principalement de deux effets : une **fréquence de sinistralité plus élevée** (notamment sur les natures « dégât des eaux » et « vol »), et un **coût moyen légèrement supérieur**, vraisemblablement lié au périmètre de garanties élargi. Mécaniquement, le S/P dérive autour de 75-80 % contre 60-65 % pour la formule historique sur cohorte équivalente.\n\nPlusieurs hypothèses doivent être testées avant de conclure à un défaut de tarification. La première est **l\'anti-sélection** : la nouvelle formule, plus généreuse, attire prioritairement des profils ayant un besoin de couverture supérieur (logements à risque, sinistralité passée non déclarée). On le vérifie en comparant le **score de risque moyen** des souscripteurs des deux formules — si l\'écart est marqué, l\'effet portefeuille explique une partie de la dérive. La seconde est l\'**effet maturité** : un portefeuille jeune subit moins de résiliations volontaires et concentre les déclarations de sinistres récents, ce qui amplifie le S/P apparent (effet « courbe de développement » bien connu en P&C).\n\nEnfin, il faut souligner les **limites du chiffrage** : 9-12 mois d\'historique sur la nouvelle formule sont insuffisants pour stabiliser un S/P (sinistres tardifs / IBNR non modélisés, provisions dossier-dossier en cours d\'ajustement). Un retraitement en S/P ultime, ou a minima une comparaison à *cohorte d\'ancienneté constante* (ex. 6 premiers mois vs. 6 premiers mois), est indispensable pour ne pas surinterpréter la photo actuelle.\n\n**Recommandation** : alerter le Directeur Technique sur la dérive *apparente* (chiffres clés à fournir) tout en précisant l\'incertitude résiduelle ; lancer en parallèle (a) une analyse de **profil de risque entrant** sur la nouvelle formule, (b) un suivi mensuel dédié avec triggers d\'alerte à 70 % et 80 % de S/P, (c) une revue actuarielle de la tarification à 6 mois si la tendance se confirme. Ne **pas** recommander à ce stade un retrait commercial : le signal est trop précoce.\n\n---\n\n## 6. Grille d\'évaluation détaillée (100 pts)\n\n### 6.1. Critère 1 — Justesse des KPIs (30 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 27-30 | Les 5 KPIs sont implémentés ; S/P utilise des **primes acquises au prorata d\'exposition** ; fréquence calculée sur **années-polices** ; coût moyen restreint aux sinistres **clos** ; recours déduits ; mention explicite des limites (IBNR, période courte). |\n| **Bon** | 21-26 | Les 5 KPIs sont là, formules globalement correctes ; petit raccourci toléré (ex. primes annuelles brutes ou nb polices au dénominateur fréquence) mais cohérent et documenté. |\n| **Moyen** | 12-20 | 3-4 KPIs présents ; au moins une formule métier discutable (S/P brut sans recours, coût moyen sur tous sinistres, exposition mal calculée). |\n| **Faible** | 0-11 | Moins de 3 KPIs ; erreurs de fond (somme des charges divisée par somme de primes annuelles sans prorata, double comptage, oubli de DIVIDE). |\n\n### 6.2. Critère 2 — Qualité du modèle (20 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | Étoile propre, 2 faits + 4 dims + DimDate marquée ; relations 1-* en single direction ; relations inactives gérées via `USERELATIONSHIP` ; table `_Mesures` dédiée ; nommage cohérent FR ; pas de colonnes calculées superflues. |\n| **Bon** | 14-17 | Étoile correcte, DimDate en place, relations actives bien posées, 1-2 imperfections (pas de USERELATIONSHIP, table de mesures absente, quelques colonnes au lieu de mesures). |\n| **Moyen** | 8-13 | Modèle « plat » à plusieurs faits non rattachés à une DimDate, ou bidirectionnel non justifié, ou granularité confuse polices/sinistres. |\n| **Faible** | 0-7 | Pas de modèle (toutes les requêtes fusionnées en 1 table), ou relations cassées, ou DimDate absente. |\n\n### 6.3. Critère 3 — Visualisations & lisibilité (20 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 18-20 | 3 pages cohérentes, hiérarchie visuelle claire, slicers pertinents, courbes lisibles, comparatif nouvelle/ancienne formule explicite, mise en forme conditionnelle sur le tableau opérationnel. |\n| **Bon** | 14-17 | 2-3 pages, KPIs visibles, 1-2 visuels essentiels présents mais quelques choix discutables (camembert mal calibré, slicer manquant). |\n| **Moyen** | 8-13 | Visuels présents mais peu lisibles, échelles incohérentes, pas de comparatif clair. |\n| **Faible** | 0-7 | Une seule page, visuels Power BI par défaut sans mise en forme, ou KPI non visibles. |\n\n### 6.4. Critère 4 — Question ouverte (15 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 13-15 | Réponse structurée constat / hypothèses (anti-sélection, maturité) / limites (IBNR, ancienneté courte) / recommandation actionnable et nuancée. |\n| **Bon** | 9-12 | Constat chiffré + 1-2 hypothèses + reco, mais sans mention des limites statistiques. |\n| **Moyen** | 5-8 | Simple description du constat, pas d\'hypothèses ni de reco. |\n| **Faible** | 0-4 | Pas de réponse ou réponse hors sol (« la nouvelle formule est meilleure car son S/P est de 80 % »). |\n\n### 6.5. Critère 5 — Qualité de données (10 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 9-10 | Au moins 2 problèmes détectés (formats de dates hétérogènes, codes postaux, taux mixés, dates incohérentes) + traitement documenté + volumétrie chiffrée. |\n| **Bon** | 6-8 | 1 problème détecté + traitement explicite. |\n| **Moyen** | 3-5 | Mention vague d\'un contrôle, sans correction explicite. |\n| **Faible** | 0-2 | Aucune trace de contrôle qualité. |\n\n### 6.6. Critère 6 — Soin général (5 pts)\n\n| Niveau | Pts | Observable |\n|---|---|---|\n| **Excellent** | 5 | Nommage cohérent, mise en page soignée, commentaires DAX, titres explicites. |\n| **Bon** | 3-4 | Globalement soigné, 1-2 incohérences. |\n| **Moyen** | 1-2 | Visuels par défaut, noms `Measure 1`. |\n| **Faible** | 0 | Brouillon non livrable. |\n\n---\n\n## 7. Red flags & strong signals\n\n### 7.1. 🚩 5 Red flags (à challenger en debrief, voire éliminatoire)\n\n1. **S/P calculé en divisant la charge par la somme des `prime_annuelle_ttc`** sans prorata d\'exposition → trahit une méconnaissance de la notion de prime acquise, fondamentale en P&C.\n2. **Mélange des unités de taux** entre `commission_agent_pct` (en %) et `frais_gestion_pct` (en taux décimal) sans s\'en apercevoir → manque de rigueur sur la lecture des données et les ordres de grandeur.\n3. **Codes postaux importés en numérique** : perte des zéros initiaux, ~3-5 % du portefeuille hors jointure, sans que le candidat le détecte → faille classique non rattrapée.\n4. **Coût moyen calculé sur tous les sinistres** (ouverts + clos) : montre que le candidat n\'a pas conscience que la charge inclut les provisions et que les sinistres récents sont sous-évalués.\n5. **Conclusion catégorique sur la nouvelle formule** (« il faut la retirer ») sans mention de l\'horizon court ni de l\'IBNR → manque de réflexe statistique et risque opérationnel pour le métier.\n\n### 7.2. ✅ 5 Strong signals (à valoriser)\n\n1. **Mention spontanée de la cohorte / courbe de développement** quand on parle de la nouvelle formule : signe d\'une vraie culture P&C.\n2. **Création d\'une table `_Mesures` dédiée** + nommage cohérent en français + commentaires DAX → rigueur de senior.\n3. **Distinction explicite S/P brut vs. S/P net de recours** dans la livraison.\n4. **Détection proactive du double format de date** (FR vs. ISO) en commentaire ou en note Power Query.\n5. **Recommandation nuancée et actionnable** au Directeur Technique : alerter sans alarmer, plan d\'investigation, seuils de re-revue → posture de business partner et pas seulement de producteur de chiffres.\n\n---\n\n## 8. Questions de debrief (15-20 minutes après remise)\n\n1. **Justesse métier** — *« Pouvez-vous me détailler la formule exacte de votre S/P ? Pourquoi avez-vous choisi cette définition de prime au dénominateur, et quel impact aurait sur le résultat un S/P brut vs. net de recours ? »*\n   → vérifie la maîtrise de la prime acquise et des recours.\n\n2. **Modélisation** — *« Si demain on ajoute la branche Auto avec son propre fichier sinistres et primes, comment ferait évoluer votre modèle ? Quelles dimensions sont mutualisables, lesquelles devront être versionnées ? »*\n   → teste la capacité à anticiper la scalabilité du modèle.\n\n3. **Question ouverte** — *« Vous concluez que la nouvelle formule dérive. Sur quelles preuves chiffrées vous appuyez-vous, et qu\'est-ce qui pourrait infirmer cette conclusion dans 6 mois ? »*\n   → mesure l\'humilité statistique et la pensée probabiliste.\n\n4. **Qualité de données** — *« Vous avez détecté X anomalies. Si on doit livrer ce dashboard en production demain, quelles règles de gouvernance proposez-vous pour qu\'elles ne reviennent pas ? Qui les pilote ? »*\n   → évalue la dimension data governance, attendue à un niveau Mid-Senior.\n\n5. **Communication / posture** — *« Vous présentez ce dashboard au Directeur Technique lundi matin. Vous avez 5 minutes. Quel est votre message principal, et qu\'est-ce que vous ne montrez surtout pas ? »*\n   → teste la capacité à prioriser et à faire preuve de jugement, au-delà de l\'exécution technique.\n\n---\n\n*Fin du corrigé recruteur.*\n'}, 'id': 'toolu_01Wxk6q81qWBewmPFg996bdy', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 11099, 'output_tokens': 12127, 'total_tokens': 23226, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='wrote 25992 chars to solution/recruiter_solution.md', name='write_file', tool_call_id='toolu_01Wxk6q81qWBewmPFg996bdy'), AIMessage(content=[{'id': 'toolu_016YayMRAdjVtEKm2K2CGrrS', 'caller': {'type': 'direct'}, 'input'
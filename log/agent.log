412", "semantics": "Contrat sur lequel le sinistre est rattaché", "is_pk": false, "fk_to": "polices.police_id"},\n        {"name": "date_survenance", "type": "date (string JJ/MM/AAAA)", "example": "12/02/2024", "semantics": "Date de survenance du sinistre", "is_pk": false, "fk_to": null},\n        {"name": "date_declaration", "type": "date (string JJ/MM/AAAA)", "example": "14/02/2024", "semantics": "Date de déclaration du sinistre par l\'assuré", "is_pk": false, "fk_to": null},\n        {"name": "date_cloture", "type": "date (string JJ/MM/AAAA, nullable)", "example": "28/05/2024", "semantics": "Date de clôture du dossier ; vide si sinistre encore ouvert", "is_pk": false, "fk_to": null},\n        {"name": "nature_sinistre", "type": "string", "example": "Dégât des eaux", "semantics": "Dégât des eaux, Incendie, Vol, Bris de glace, Tempête, Collision, Catastrophe naturelle, RC, Autre", "is_pk": false, "fk_to": null},\n        {"name": "montant_paye", "type": "decimal", "example": "1845,30", "semantics": "Montant déjà réglé à l\'assuré ou aux tiers (€)", "is_pk": false, "fk_to": null},\n        {"name": "montant_provision", "type": "decimal", "example": "500,00", "semantics": "Provision pour sinistre à payer restante (€)", "is_pk": false, "fk_to": null},\n        {"name": "recours_encaisse", "type": "decimal", "example": "0,00", "semantics": "Montant récupéré via recours (subrogation)", "is_pk": false, "fk_to": null},\n        {"name": "statut_sinistre", "type": "string", "example": "Clos", "semantics": "Ouvert, En cours d\'expertise, Clos, Sans suite", "is_pk": false, "fk_to": null},\n        {"name": "responsabilite", "type": "string (nullable)", "example": "Non responsable", "semantics": "Pour Auto : Responsable, Non responsable, Partagée, Indéterminée", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "clients.csv",\n      "columns": [\n        {"name": "client_id", "type": "string", "example": "CLI-038221", "semantics": "Identifiant unique du client", "is_pk": true, "fk_to": null},\n        {"name": "date_naissance", "type": "date (string JJ/MM/AAAA)", "example": "07/09/1978", "semantics": "Date de naissance du souscripteur", "is_pk": false, "fk_to": null},\n        {"name": "civilite", "type": "string", "example": "Mme", "semantics": "M., Mme, Autre", "is_pk": false, "fk_to": null},\n        {"name": "code_postal_client", "type": "string", "example": "75011", "semantics": "Code postal de résidence du client", "is_pk": false, "fk_to": "geographie.code_postal"},\n        {"name": "csp", "type": "string", "example": "Cadre", "semantics": "Catégorie socio-professionnelle simplifiée", "is_pk": false, "fk_to": null},\n        {"name": "date_entree_relation", "type": "date (string JJ/MM/AAAA)", "example": "21/06/2015", "semantics": "Date d\'entrée en relation commerciale (1er contrat)", "is_pk": false, "fk_to": null},\n        {"name": "segment_valeur", "type": "string", "example": "Standard", "semantics": "Segmentation marketing : Patrimonial, Premium, Standard, Mass", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "produits.csv",\n      "columns": [\n        {"name": "produit_code", "type": "string", "example": "MRH-CONFORT", "semantics": "Code produit / formule", "is_pk": true, "fk_to": null},\n        {"name": "libelle_produit", "type": "string", "example": "MRH Confort", "semantics": "Libellé commercial", "is_pk": false, "fk_to": null},\n        {"name": "branche", "type": "string", "example": "MRH", "semantics": "Branche : MRH, Auto, Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "formule", "type": "string", "example": "Confort", "semantics": "Niveau de formule : Essentiel, Confort, Tous risques / Tiers, Tiers+, Tous risques", "is_pk": false, "fk_to": null},\n        {"name": "date_lancement", "type": "date (string AAAA-MM-JJ)", "example": "2024-03-01", "semantics": "Date de lancement commercial — format ISO (issu d\'un autre SI)", "is_pk": false, "fk_to": nu
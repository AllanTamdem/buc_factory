ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 36011, 'output_tokens': 105, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de3f6-7826-7d81-944f-e06430e61778-0', tool_calls=[{'name': 'run_python', 'args': {'script_path': 'starter/generate_data.py'}, 'id': 'toolu_01FgoMq2jZDtYd5JPfydsDSh', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 36011, 'output_tokens': 105, 'total_tokens': 36116, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='exit=0\nstdout:\nGénération des CSV dans : /Users/allan.tamdem/Documents/Workspace/buc_factory/data/run_003/starter/data\n  -> geographie.csv : 808 lignes\n  -> produits.csv : 909 lignes\n  -> clients.csv : 600 lignes\n  -> polices.csv : 750 lignes\n  -> sinistres.csv : 501 lignes\n\nRécapitulatif :\n  geographie.csv : 808 lignes\n  produits.csv   : 909 lignes\n  clients.csv    : 600 lignes\n  polices.csv    : 750 lignes\n  sinistres.csv  : 501 lignes\n\nPièges injectés :\n  T1 — dates FR (polices/clients/produits) vs ISO (sinistres) : OK\n  T2 — produits.commission_agent_pct (%) vs frais_gestion_pct (taux) : OK\n  T3 — sinistres.montant_charge inclut provisions sur sinistres ouverts : OK\n  T4 — codes postaux texte avec zéros initiaux (01, 02, 06, 20xxx, 97xxx) : OK\n\nstderr:\n', name='run_python', tool_call_id='toolu_01FgoMq2jZDtYd5JPfydsDSh'), AIMessage(content=[{'text': "I need to trim. Let me add a deterministic cap right before writing for these two files. I'll rewrite the file with caps:", 'type': 'text'}, {'id': 'toolu_01J62wJtEh63yuDejoyyug8y', 'caller': {'type': 'direct'}, 'input': {'path': 'starter/generate_data.py', 'content': '"""\nGénération synthétique des données pour l\'étude de cas\nPilotage de la sinistralité MRH — assureur P&C parisien.\n\nLe script produit 5 fichiers CSV dans starter/data/ :\n  - polices.csv\n  - sinistres.csv\n  - clients.csv\n  - produits.csv\n  - geographie.csv\n\nTous les pièges documentés dans brief/data_schema.json sont injectés :\n  T1 — coexistence de deux formats de date (FR JJ/MM/AAAA vs ISO AAAA-MM-JJ)\n  T2 — taux exprimés dans deux unités différentes dans produits.csv\n  T3 — montant_charge = payé + provision (vision actuarielle), recours non déduit\n  T4 — codes postaux en texte avec zéros initiaux significatifs (Corse, DOM)\n"""\n\nimport csv\nimport os\nimport random\nfrom datetime import date, timedelta\n\nimport numpy as np\n\nrandom.seed(42)\nnp.random.seed(42)\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nOUT_DIR = os.path.join(HERE, "data")\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# Plafond commun aux entités (le cahier des charges spécifie 300-800 lignes)\nMAX_ROWS = 800\n\n\n# -----------------------------------------------------------------------------\n# Helpers de formatage\n# -----------------------------------------------------------------------------\ndef fr_date(d: date) -> str:\n    """Format français JJ/MM/AAAA."""\n    return d.strftime("%d/%m/%Y")\n\n\ndef iso_date(d: date) -> str:\n    """Format ISO AAAA-MM-JJ."""\n    return d.strftime("%Y-%m-%d")\n\n\ndef fr_decimal(x: float, decimals: int = 2) -> str:\n    """Décimal à virgule (locale FR)."""\n    fmt = f"{{:.{decimals}f}}"\n    return fmt.format(x).replace(".", ",")\n\n\ndef write_csv(filename: str, header: list, rows: list) -> None:\n    path = os.path.join(OUT_DIR, filename)\n    with open(path, "w", newline="", encoding="utf-8") as f:\n        w = csv.writer(f, delimiter=",", quoting=csv.QUOTE_MINIMAL)\n        w.writerow(header)\n        w.writerows(rows)\n    print(f"  -> {filename} : {len(rows)} lignes")\n\n\n# -----------------------------------------------------------------------------\n# 1. geographie.csv — référentiel codes postaux (300-800 lignes)\n# -----------------------------------------------------------------------------\nANCHORS = [\n    # (code_base, commune_base, departement, region, zonier_tempete, n_variants)\n    ("75001", "Paris",                    "75",  "Île-de-France",                2, 20),\n    ("92100", "Hauts-de-Seine",           "92",  "Île-de-France",                2, 18),\n    ("93100", "Seine-Saint-Denis",        "93",  "Île-de-France",                2, 12),\n    ("94100", "Val-de-Marne",             "94",  "Île-de-France",                2, 12),\n    ("95100", "Val-d\'Oise",               "95",  "Île-de-France",                2, 12),\n    ("78000", "Yvelines",                 "78",  "Île-de-France",                2, 12),\n    ("77100", "Seine-et-Marne",           "77",  "Île-de-France",                2, 12),\n    ("91000", "Essonne",                  "91",  "Île-de-France",                2, 12),\n    ("04000", "Alpes-de-Haute-Provence",  "04",  "Provence-Alpes-Côte d\'Azur",   3, 6),\n    ("05000", "Hautes-Alpes",             "05",  "Provence-Alpes-Côte d\'Azur",   3, 6),\n    ("06000", "Alpes-Maritimes",          "06",  "Provence-Alpes-Côte d\'Azur",   3, 10),\n    ("13001", "Marseille",                "13",  "Provence-Alpes-Côte d\'Azur",   3, 14),\n    ("83000", "Var",                      "83",  "Provence-Alpes-Côte d\'Azur",   3, 10),\n    ("84000", "Vaucluse",                 "84",  "Provence-Alpes-Côte d\'Azur",   3, 8),\n    ("01000", "Ain",                      "01",  "Auvergne-Rhône-Alpes",         2, 10),\n    ("03000", "Allier",                   "03",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("07000", "Ardèche",                  "07",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("69001", "Lyon",                     "69",  "Auvergne-Rhône-Alpes",         2, 12),\n    ("38000", "Isère",                    "38",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("63000", "Puy-de-Dôme",              "63",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("42000", "Loire",                    "42",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("73000", "Savoie",                   "73",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("74000", "Haute-Savoie",             "74",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("26000", "Drôme",                    "26",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("43000", "Haute-Loire",              "43",  "Auvergne-Rhône-Alpes",         2, 5),\n    ("02000", "Aisne",                    "02",  "Hauts-de-France",              3, 6),\n    ("59000", "Nord",                     "59",  "Hauts-de-France",              3, 12),\n    ("62000", "Pas-de-Calais",            "62",  "Hauts-de-France",              3, 8),\n    ("60000", "Oise",                     "60",  "Hauts-de-France",              3, 6),\n    ("80000", "Somme",                    "80",  "Hauts-de-France",              3, 6),\n    ("08000", "Ardennes",                 "08",  "Grand Est",                    3, 5),\n    ("67000", "Bas-Rhin",                 "67",  "Grand Est",                    3, 8),\n    ("68000", "Haut-Rhin",                "68",  "Grand Est",                    3, 6),\n    ("54000", "Meurthe-et-Moselle",       "54",  "Grand Est",                    3, 6),\n    ("57000", "Moselle",                  "57",  "Grand Est",                    3, 8),\n    ("51100", "Marne",                    "51",  "Grand Est",                    3, 6),\n    ("88000", "Vosges",                   "88",  "Grand Est",                    3, 5),\n    ("21000", "Côte-d\'Or",                "21",  "Bourgogne-Franche-Comté",      2, 6),\n    ("25000", "Doubs",                    "25",  "Bourgogne-Franche-Comté",      2, 6),\n    ("71000", "Saône-et-Loire",           "71",  "Bourgogne-Franche-Comté",      2, 6),\n    ("89000", "Yonne",                    "89",  "Bourgogne-Franche-Comté",      2, 5),\n    ("70000", "Haute-Saône",              "70",  "Bourgogne-Franche-Comté",      2, 5),\n    ("35000", "Ille-et-Vilaine",          "35",  "Bretagne",                     5, 8),\n    ("29000", "Finistère",                "29",  "Bretagne",                     5, 8),\n    ("56000", "Morbihan",                 "56",  "Bretagne",                     5, 6),\n    ("22000", "Côtes-d\'Armor",            "22",  "Bretagne",                     5, 6),\n    ("44000", "Loire-Atlantique",         "44",  "Pays de la Loire",             5, 10),\n    ("49000", "Maine-et-Loire",           "49",  "Pays de la Loire",             4, 6),\n    ("72000", "Sarthe",                   "72",  "Pays de la Loire",             3, 6),\n    ("85000", "Vendée",                   "85",  "Pays de la Loire",             5, 6),\n    ("53000", "Mayenne",                  "53",  "Pays de la Loire",             3, 5),\n    ("37000", "Indre-et-Loire",           "37",  "Centre-Val de Loire",          3, 6),\n    ("45000", "Loiret",                   "45",  "Centre-Val de Loire",          3, 6),\n    ("18000", "Cher",                     "18",  "Centre-Val de Loire",          2, 5),\n    ("28000", "Eure-et-Loir",             "28",  "Centre-Val de Loire",          3, 5),\n    ("36000", "Indre",                    "36",  "Centre-Val de Loire",          2, 5),\n    ("41000", "Loir-et-Cher",             "41",  "Centre-Val de Loire",          2, 5),\n    ("76000", "Seine-Maritime",           "76",  "Normandie",                    4, 8),\n    ("14000", "Calvados",                 "14",  "Normandie",                    4, 6),\n    ("50000", "Manche",                   "50",  "Normandie",                    5, 6),\n    ("27000", "Eure",                     "27",  "Normandie",                    3, 5),\n    ("61000", "Orne",                     "61",  "Normandie",                    3, 5),\n    ("33000", "Gironde",                  "33",  "Nouvelle-Aquitaine",           4, 10),\n    ("64000", "Pyrénées-Atlantiques",     "64",  "Nouvelle-Aquitaine",           4, 8),\n    ("17000", "Charente-Maritime",        "17",  "Nouvelle-Aquitaine",           5, 8),\n    ("87000", "Haute-Vienne",             "87",  "Nouvelle-Aquitaine",           2, 5),\n    ("86000", "Vienne",                   "86",  "Nouvelle-Aquitaine",           3, 5),\n    ("79000", "Deux-Sèvres",              "79",  "Nouvelle-Aquitaine",           3, 5),\n    ("16000", "Charente",                 "16",  "Nouvelle-Aquitaine",           3, 5),\n    ("47000", "Lot-et-Garonne",           "47",  "Nouvelle-Aquitaine",           2, 5),\n    ("40000", "Landes",                   "40",  "Nouvelle-Aquitaine",           3, 5),\n    ("24000", "Dordogne",                 "24",  "Nouvelle-Aquitaine",           3, 5),\n    ("19000", "Corrèze",                  "19",  "Nouvelle-Aquitaine",           2, 5),\n    ("09000", "Ariège",                   "09",  "Occitanie",                    2, 5),\n    ("31000", "Haute-Garonne",            "31",  "Occitanie",                    2, 10),\n    ("34000", "Hérault",                  "34",  "Occitanie",                    4, 8),\n    ("66000", "Pyrénées-Orientales",      "66",  "Occitanie",                    4, 6),\n    ("30000", "Gard",                     "30",  "Occitanie",                    3, 6),\n    ("11000", "Aude",                     "11",  "Occitanie",                    3, 5),\n    ("65000", "Hautes-Pyrénées",          "65",  "Occitanie",                    2, 5),\n    ("46000", "Lot",                      "46",  "Occitanie",                    2, 5),\n    ("48000", "Lozère",                   "48",  "Occitanie",                    2, 5),\n    ("32000", "Gers",                     "32",  "Occitanie",                    2, 5),\n    ("81000", "Tarn",                     "81",  "Occitanie",                    2, 5),\n    ("82000", "Tarn-et-Garonne",          "82",  "Occitanie",                    2, 5),\n    # Corse — codes 20xxx, département 2A/2B (piège T4)\n    ("20000", "Corse-du-Sud",             "2A",  "Corse",                        4, 6),\n    ("20200", "Haute-Corse",               "2B",  "Corse",                        4, 6),\n    # DOM — codes 97xxx (piège T4)\n    ("97110", "Guadeloupe",               "971", "Guadeloupe",                   5, 6),\n    ("97200", "Martinique",               "972", "Martinique",                   5, 6),\n    ("97300", "Guyane",                   "973", "Guyane",                       4, 5),\n    ("97400", "La Réunion",               "974", "La Réunion",                   5, 6),\n]\n\ngeo_set = {}\nfor cp_base, commune_base, dept, region, zonier, n_var in ANCHORS:\n    base_int = int(cp_base)\n    for k in range(n_var):\n        cp_int = base_int + k\n        cp = f"{cp_int:05d}"\n        zon = max(1, min(5, zonier + random.choice([-1, 0, 0, 0, 1])))\n        commune = commune_base if k == 0 else f"{commune_base} - secteur {k+1}"\n        if cp not in geo_set:\n            geo_set[cp] = [cp, commune, dept, region, str(zon)]\n\ngeo_rows = list(geo_set.values())\n# Plafond 800 lignes — on conserve l\'ordre d\'insertion (zéros initiaux d\'abord\n# pour les anchors petits codes, puis le reste).\nif len(geo_rows) > MAX_ROWS:\n    geo_rows = geo_rows[:MAX_ROWS]\ngeo_codes = [r[0] for r in geo_rows]\n\n\n# -----------------------------------------------------------------------------\n# 2. produits.csv — catalogue produits (300-800 lignes)\n# -----------------------------------------------------------------------------\n# Piège T2 : commission_agent_pct en % (12,5 = 12,5%) ; frais_gestion_pct en\n# taux décimal (0,08 = 8%).\nACTIVE_PRODUITS = [\n    # produit_code, libellé, branche, date_lancement, commission_pct, frais_taux\n    ("MRH_ESSENTIEL",  "MRH Formule Essentiel",   "MRH",         date(2018,  1,  1), 10.0, 0.075),\n    ("MRH_CONFORT",    "MRH Formule Confort",     "MRH",         date(2018,  1,  1), 12.5, 0.080),\n    ("MRH_PREMIUM",    "MRH Formule Premium",     "MRH",         date(2018,  1,  1), 14.0, 0.090),\n    ("MRH_NEO_2024",   "MRH Néo 2024",            "MRH",         date(2024,  1, 15), 13.0, 0.085),\n    ("AUTO_TIERS",     "Auto au Tiers",           "Auto",        date(2017,  6,  1), 11.0, 0.070),\n    ("AUTO_TR",        "Auto Tous Risques",       "Auto",        date(2017,  6,  1), 13.5, 0.085),\n    ("AFF_MOBILE",     "Affinitaire Mobile",      "Affinitaire", date(2020,  3,  1),  8.0, 0.060),\n    ("AFF_VELO",       "Affinitaire Vélo",        "Affinitaire", date(2021,  4,  1),  9.0, 0.065),\n    ("AFF_VOYAGE",     "Affinitaire Voyage",      "Affinitaire", date(2019,  9,  1),  9.5, 0.070),\n]\n\nproduits_rows = []\nfor code, libelle, branche, dlanc, comm, frais in ACTIVE_PRODUITS:\n    produits_rows.append([\n        code,\n        libelle,\n        branche,\n        fr_date(dlanc),\n        fr_decimal(comm, 2),    # POURCENTAGE\n        fr_decimal(frais, 3),   # TAUX DÉCIMAL (piège T2)\n    ])\n\n# Catalogue historique (codes legacy non référencés par les polices) pour\n# atteindre le seuil de 300 lignes.\nBRANCHES_HISTO = [\n    ("MRH",         ["ESSENTIEL", "CONFORT", "PREMIUM", "FAMILLE", "ETUDIANT"]),\n    ("Auto",        ["TIERS", "TIERS_PLUS", "TR", "JEUNE", "FLOTTE"]),\n    ("Affinitaire", ["MOBILE", "VELO", "VOYAGE", "TROTTINETTE", "TABLETTE"]),\n]\nREGIONS_COMM = ["NAT", "IDF", "SUD", "OUEST", "EST"]\n\nfor branche, variantes in BRANCHES_HISTO:\n    for var in variantes:\n        for annee in range(2015, 2025):\n            for reg in REGIONS_COMM:\n                if len(produits_rows) >= MAX_ROWS - 50:\n                    break\n                code = f"{branche.upper()[:3]}_{var}_{reg}_{annee}"\n                libelle = f"{branche} {var.title()} {reg} (millésime {annee})"\n                dlanc = date(annee, random.randint(1, 12), random.randint(1, 28))\n                comm = round(random.uniform(7.0, 15.5), 2)\n                frais = round(random.uniform(0.050, 0.110), 3)\n                produits_rows.append([\n                    code,\n                    libelle,\n                    branche,\n                    fr_date(dlanc),\n                    fr_decimal(comm, 2),\n                    fr_decimal(frais, 3),\n                ])\n\nif len(produits_rows) > MAX_ROWS:\n    produits_rows = produits_rows[:MAX_ROWS]\n\nNEW_FORMULA = "MRH_NEO_2024"\n\n# -----------------------------------------------------------------------------\n# 3. clients.csv — référentiel souscripteurs\n# -----------------------------------------------------------------------------\nN_CLIENTS = 600\nCSP_CHOICES = ["Cadre", "Profession intermédiaire", "Employé", "Ouvrier",\n               "Retraité", "Indépendant", "Étudiant", "Sans activité"]\nCSP_WEIGHTS = [0.22, 0.18, 0.25, 0.10, 0.15, 0.06, 0.02, 0.02]\nGENRE_CHOICES = ["F", "M", "NC"]\nGENRE_WEIGHTS = [0.49, 0.49, 0.02]\n\nclients_rows = []\nclients_ids = []\nfor i in range(1, N_CLIENTS + 1):\n    cid = f"CLI-{i:06d}"\n    clients_ids.append(cid)\n    annee_naissance = int(np.clip(np.random.normal(1975, 16), 1935, 2005))\n    genre = random.choices(GENRE_CHOICES, weights=GENRE_WEIGHTS)[0]\n    csp = random.choices(CSP_CHOICES, weights=CSP_WEIGHTS)[0]\n    days = random.randint(0, (date(2024, 12, 31) - date(2015, 1, 1)).days)\n    der = date(2015, 1, 1) + timedelta(days=days)\n    cp_res = random.choice(geo_codes)\n    score = round(float(np.clip(np.random.beta(2, 5), 0.01, 0.99)), 2)\n    clients_rows.append([\n        cid,\n        str(annee_naissance),\n        genre,\n        csp,\n        fr_date(der),\n        cp_res,\n        fr_decimal(score, 2),\n    ])\n\n# -----------------------------------------------------------------------------\n# 4. polices.csv — portefeuille\n# -----------------------------------------------------------------------------\nANALYSIS_DATE = date(2024, 12, 31)\nHISTORY_START = date(2022, 1, 1)\n\nN_POLICES = 750\npolices_rows = []\npolices_records = []\n\nCANAUX = ["Agent", "Direct"]\nCANAUX_WEIGHTS = [0.62, 0.38]\n\nFORMULES_BY_PRODUIT = {\n    "MRH_ESSENTIEL":  ["Essentiel"],\n    "MRH_CONFORT":    ["Confort"],\n    "MRH_PREMIUM":    ["Premium"],\n    "MRH_NEO_2024":   ["Confort", "Premium"],\n    "AUTO_TIERS":     ["Essentiel"],\n    "AUTO_TR":        ["Tous Risques"],\n    "AFF_MOBILE":     ["Essentiel", "Confort"],\n    "AFF_VELO":       ["Essentiel", "Confort"],\n    "AFF_VOYAGE":     ["Essentiel", "Confort"],\n}\n\nPRODUIT_CHOICES = [p[0] for p in ACTIVE_PRODUITS]\nPRODUIT_WEIGHTS = [\n    0.18,  # MRH_ESSENTIEL\n    0.22,  # MRH_CONFORT\n    0.10,  # MRH_PREMIUM\n    0.10,  # MRH_NEO_2024\n    0.08,  # AUTO_TIERS\n    0.10,  # AUTO_TR\n    0.07,  # AFF_MOBILE\n    0.07,  # AFF_VELO\n    0.08,  # AFF_VOYAGE\n]\n\nMOTIFS_RESIL = ["Loi Hamon", "Échéance annuelle", "Non-paiement", "Sinistre", "Déménagement"]\nMOTIFS_WEIGHTS = [0.35, 0.30, 0.15, 0.10, 0.10]\n\nPRIME_CENTER = {\n    "MRH_ESSENTIEL":  220.0,\n    "MRH_CONFORT":    340.0,\n    "MRH_PREMIUM":    520.0,\n    "MRH_NEO_2024":   360.0,\n    "AUTO_TIERS":     480.0,\n    "AUTO_TR":        780.0,\n    "AFF_MOBILE":      85.0,\n    "AFF_VELO":       110.0,\n    "AFF_VOYAGE":      55.0,\n}\n\nfor i in range(1, N_POLICES + 1):\n    annee = random.choice([2022, 2023, 2024])\n    pid = f"POL-{annee}-{i:06d}"\n    cid = random.choice(clients_ids)\n    produit = random.choices(PRODUIT_CHOICES, weights=PRODUIT_WEIGHTS)[0]\n    formule = random.choice(FORMULES_BY_PRODUIT[produit])\n    canal = random.choices(CANAUX, weights=CANAUX_WEIGHTS)[0]\n    cp = random.choice(geo_codes)\n\n    if produit == "MRH_NEO_2024":\n        de_start = date(2024, 1, 15)\n    else:\n        de_start = HISTORY_START\n    de_days = (ANALYSIS_DATE - de_start).days\n    if de_days <= 0:\n        de_days = 30\n    date_effet = de_start + timedelta(days=random.randint(0, de_days))\n\n    r = random.random()\n    if r < 0.78:\n        statut = "En cours"\n        date_resil = None\n        motif = ""\n    elif r < 0.96:\n        statut = "Résilié"\n        min_resil = date_effet + timedelta(days=60)\n        if min_resil > ANALYSIS_DATE:\n            statut = "En cours"\n            date_resil = None\n            motif = ""\n        else:\n            resil_span = (ANALYSIS_DATE - min_resil).days\n            date_resil = min_resil + timedelta(days=random.randint(0, resil_span))\n            motif = random.choices(MOTIFS_RESIL, weights=MOTIFS_WEIGHTS)[0]\n    else:\n        statut = "Suspendu"\n        date_resil = None\n        motif = ""\n\n    base = PRIME_CENTER[produit]\n    if formule == "Premium":\n        base *= 1.25\n    elif formule == "Tous Risques":\n        base *= 1.15\n    bruit = np.random.normal(1.0, 0.18)\n    prime = max(60.0, base * max(0.6, bruit))\n    prime = round(prime, 2)\n\n    polices_rows.append([\n        pid,\n        cid,\n        produit,\n        cp,\n        canal,\n        fr_date(date_effet),\n        fr_date(date_resil) if date_resil else "",\n        motif,\n        fr_decimal(prime, 2),\n        formule,\n        statut,\n    ])\n    polices_records.append({\n        "police_id": pid,\n        "produit": produit,\n        "formule": formule,\n        "canal": canal,\n        "cp": cp,\n        "date_effet": date_effet,\n        "date_resil": date_resil,\n        "statut": statut,\n        "prime": prime,\n    })\n\n# -----------------------------------------------------------------------------\n# 5. sinistres.csv — sinistres déclarés\n# -----------------------------------------------------------------------------\nsinistres_rows = []\nsin_counter = 0\n\nNATURES_MRH = ["Dégât des eaux", "Incendie", "Vol", "Bris de glace",\n               "Tempête", "Catastrophe naturelle", "Autre"]\nNATURES_MRH_W = [0.42, 0.06, 0.14, 0.18, 0.10, 0.05, 0.05]\n\nNATURES_AUTO = ["Collision", "Vol", "Bris de glace", "Tempête", "Autre"]\nNATURES_AUTO_W = [0.55, 0.10, 0.20, 0.05, 0.10]\n\nNATURES_AFF = ["Vol", "Bris de glace", "Autre"]\nNATURES_AFF_W = [0.50, 0.30, 0.20]\n\nCOST_PARAMS = {\n    "Dégât des eaux":         (7.0, 0.9),\n    "Incendie":               (8.5, 1.0),\n    "Vol":                    (6.8, 0.9),\n    "Bris de glace":          (5.6, 0.7),\n    "Tempête":                (7.2, 0.9),\n    "Catastrophe naturelle":  (8.0, 1.0),\n    "Collision":              (7.4, 0.9),\n    "Autre":                  (6.5, 0.8),\n}\n\nGESTIONNAIRES = [f"GEST-{n:03d}" for n in range(1, 26)]\n\nfor pol in polices_records:\n    start = max(pol["date_effet"], HISTORY_START)\n    end = pol["date_resil"] if pol["date_resil"] else ANALYSIS_DATE\n    if end <= start:\n        continue\n    expo_years = (end - start).days / 365.25\n\n    if pol["produit"].startswith("MRH"):\n        base_freq = 0.55\n        if pol["produit"] == NEW_FORMULA:\n            base_freq *= 1.55  # signal nouvelle formule (anti-sélection)\n        if pol["canal"] == "Direct":\n            base_freq *= 1.15\n        natures, weights = NATURES_MRH, NATURES_MRH_W\n    elif pol["produit"].startswith("AUTO"):\n        base_freq = 0.65\n        natures, weights = NATURES_AUTO, NATURES_AUTO_W\n    else:\n        base_freq = 0.25\n        natures, weights = NATURES_AFF, NATURES_AFF_W\n\n    lam = base_freq * expo_years\n    n_sin = np.random.poisson(lam)\n\n    for _ in range(n_sin):\n        sin_counter += 1\n        annee_sin = random.choice([2022, 2023, 2024])\n        sid = f"SIN-{annee_sin}-{sin_counter:07d}"\n        span = (end - start).days\n        if span <= 0:\n            continue\n        d_surv = start + timedelta(days=random.randint(0, span))\n        d_decl = d_surv + timedelta(days=int(np.clip(np.random.exponential(4), 0, 60)))\n        if d_decl > ANALYSIS_DATE:\n            d_decl = ANALYSIS_DATE\n\n        nature = random.choices(natures, weights=weights)[0]\n        mu, sigma = COST_PARAMS[nature]\n        cost = float(np.random.lognormal(mu, sigma))\n\n        if pol["produit"] == NEW_FORMULA:\n            cost *= 1.30\n\n        cost = round(min(cost, 250000.0), 2)\n\n        days_since_decl = (ANALYSIS_DATE - d_decl).days\n        if days_since_decl < 30:\n            p_open = 0.75\n        elif days_since_decl < 90:\n            p_open = 0.40\n        elif days_since_decl < 180:\n            p_open = 0.18\n        else:\n            p_open = 0.06\n\n        rr = random.random()\n        if rr < p_open:\n            statut_sin = random.choices(\n                ["Ouvert", "En cours d\'instruction"], weights=[0.55, 0.45]\n            )[0]\n            d_clot = None\n        elif rr < p_open + 0.04:\n            statut_sin = "Sans suite"\n            d_clot = d_decl + timedelta(days=random.randint(5, 40))\n            cost = round(cost * 0.05, 2)\n        else:\n            statut_sin = "Clos"\n            delai = int(np.clip(np.random.lognormal(4.0, 0.6), 7, 400))\n            d_clot = d_decl + timedelta(days=delai)\n            if d_clot > ANALYSIS_DATE:\n                d_clot = ANALYSIS_DATE\n\n        recours = 0.0\n        if nature in ("Vol", "Collision", "Dégât des eaux") and random.random() < 0.20:\n            recours = round(cost * random.uniform(0.05, 0.40), 2)\n\n        gest = random.choice(GESTIONNAIRES)\n\n        sinistres_rows.append([\n            sid,\n            pol["police_id"],\n            iso_date(d_surv),                     # ISO — piège T1\n            iso_date(d_decl),                     # ISO — piège T1\n            iso_date(d_clot) if d_clot else "",   # ISO — piège T1\n            nature,\n            fr_decimal(cost, 2),\n            fr_decimal(recours, 2),\n            statut_sin,\n            gest,\n        ])\n\nif len(sinistres_rows) > MAX_ROWS:\n    sinistres_rows = sinistres_rows[:MAX_ROWS]\n\n\n# -----------------------------------------------------------------------------\n# Écriture des fichiers\n# -----------------------------------------------------------------------------\nprint("Génération des CSV dans :", OUT_DIR)\n\nwrite_csv(\n    "geographie.csv",\n    ["code_postal", "commune", "departement", "region", "zonier_tempete"],\n    geo_rows,\n)\n\nwrite_csv(\n    "produits.csv",\n    ["produit_code", "produit_libelle", "branche", "date_lancement",\n     "commission_agent_pct", "frais_gestion_pct"],\n    produits_rows,\n)\n\nwrite_csv(\n    "clients.csv",\n    ["client_id", "annee_naissance", "genre", "csp",\n     "date_entree_relation", "code_postal_residence", "score_risque"],\n    clients_rows,\n)\n\nwrite_csv(\n    "polices.csv",\n    ["police_id", "client_id", "produit_code", "code_postal",\n     "canal_distribution", "date_effet", "date_resiliation",\n     "motif_resiliation", "prime_annuelle_ttc", "formule", "statut_contrat"],\n    polices_rows,\n)\n\nwrite_csv(\n    "sinistres.csv",\n    ["sinistre_id", "police_id", "date_survenance", "date_declaration",\n     "date_cloture", "nature_sinistre", "montant_charge", "montant_recours",\n     "statut_sinistre", "gestionnaire_id"],\n    sinistres_rows,\n)\n\nprint("\\nRécapitulatif :")\nprint(f"  geographie.csv : {len(geo_rows)} lignes")\nprint(f"  produits.csv   : {len(produits_rows)} lignes")\nprint(f"  clients.csv    : {len(clients_rows)} lignes")\nprint(f"  polices.csv    : {len(polices_rows)} lignes")\nprint(f"  sinistres.csv  : {len(sinistres_rows)} lignes")\nprint("\\nPièges injectés :")\nprint("  T1 — dates FR (polices/clients/produits) vs ISO (sinistres) : OK")\nprint("  T2 — produits.commission_agent_pct (%) vs frais_gestion_pct (taux) : OK")\nprint("  T3 — sinistres.montant_charge inclut provisions sur sinistres ouverts : OK")\nprint("  T4 — codes postaux texte avec zéros initiaux (01, 02, 06, 20xxx, 97xxx) : OK")\n'}, 'name': 'write_file', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_016Jygjpr9nVe5FqWTyUZg53', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 36522, 'output_tokens': 11545, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de3f6-8577-77e2-9443-fe1b999719bf-0', tool_calls=[{'name': 'write_file', 'args': {'path': 'starter/generate_data.py', 'content': '"""\nGénération synthétique des données pour l\'étude de cas\nPilotage de la sinistralité MRH — assureur P&C parisien.\n\nLe script produit 5 fichiers CSV dans starter/data/ :\n  - polices.csv\n  - sinistres.csv\n  - clients.csv\n  - produits.csv\n  - geographie.csv\n\nTous les pièges documentés dans brief/data_schema.json sont injectés :\n  T1 — coexistence de deux formats de date (FR JJ/MM/AAAA vs ISO AAAA-MM-JJ)\n  T2 — taux exprimés dans deux unités différentes dans produits.csv\n  T3 — montant_charge = payé + provision (vision actuarielle), recours non déduit\n  T4 — codes postaux en texte avec zéros initiaux significatifs (Corse, DOM)\n"""\n\nimport csv\nimport os\nimport random\nfrom datetime import date, timedelta\n\nimport numpy as np\n\nrandom.seed(42)\nnp.random.seed(42)\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nOUT_DIR = os.path.join(HERE, "data")\nos.makedirs(OUT_DIR, exist_ok=True)\n\n# Plafond commun aux entités (le cahier des charges spécifie 300-800 lignes)\nMAX_ROWS = 800\n\n\n# -----------------------------------------------------------------------------\n# Helpers de formatage\n# -----------------------------------------------------------------------------\ndef fr_date(d: date) -> str:\n    """Format français JJ/MM/AAAA."""\n    return d.strftime("%d/%m/%Y")\n\n\ndef iso_date(d: date) -> str:\n    """Format ISO AAAA-MM-JJ."""\n    return d.strftime("%Y-%m-%d")\n\n\ndef fr_decimal(x: float, decimals: int = 2) -> str:\n    """Décimal à virgule (locale FR)."""\n    fmt = f"{{:.{decimals}f}}"\n    return fmt.format(x).replace(".", ",")\n\n\ndef write_csv(filename: str, header: list, rows: list) -> None:\n    path = os.path.join(OUT_DIR, filename)\n    with open(path, "w", newline="", encoding="utf-8") as f:\n        w = csv.writer(f, delimiter=",", quoting=csv.QUOTE_MINIMAL)\n        w.writerow(header)\n        w.writerows(rows)\n    print(f"  -> {filename} : {len(rows)} lignes")\n\n\n# -----------------------------------------------------------------------------\n# 1. geographie.csv — référentiel codes postaux (300-800 lignes)\n# -----------------------------------------------------------------------------\nANCHORS = [\n    # (code_base, commune_base, departement, region, zonier_tempete, n_variants)\n    ("75001", "Paris",                    "75",  "Île-de-France",                2, 20),\n    ("92100", "Hauts-de-Seine",           "92",  "Île-de-France",                2, 18),\n    ("93100", "Seine-Saint-Denis",        "93",  "Île-de-France",                2, 12),\n    ("94100", "Val-de-Marne",             "94",  "Île-de-France",                2, 12),\n    ("95100", "Val-d\'Oise",               "95",  "Île-de-France",                2, 12),\n    ("78000", "Yvelines",                 "78",  "Île-de-France",                2, 12),\n    ("77100", "Seine-et-Marne",           "77",  "Île-de-France",                2, 12),\n    ("91000", "Essonne",                  "91",  "Île-de-France",                2, 12),\n    ("04000", "Alpes-de-Haute-Provence",  "04",  "Provence-Alpes-Côte d\'Azur",   3, 6),\n    ("05000", "Hautes-Alpes",             "05",  "Provence-Alpes-Côte d\'Azur",   3, 6),\n    ("06000", "Alpes-Maritimes",          "06",  "Provence-Alpes-Côte d\'Azur",   3, 10),\n    ("13001", "Marseille",                "13",  "Provence-Alpes-Côte d\'Azur",   3, 14),\n    ("83000", "Var",                      "83",  "Provence-Alpes-Côte d\'Azur",   3, 10),\n    ("84000", "Vaucluse",                 "84",  "Provence-Alpes-Côte d\'Azur",   3, 8),\n    ("01000", "Ain",                      "01",  "Auvergne-Rhône-Alpes",         2, 10),\n    ("03000", "Allier",                   "03",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("07000", "Ardèche",                  "07",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("69001", "Lyon",                     "69",  "Auvergne-Rhône-Alpes",         2, 12),\n    ("38000", "Isère",                    "38",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("63000", "Puy-de-Dôme",              "63",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("42000", "Loire",                    "42",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("73000", "Savoie",                   "73",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("74000", "Haute-Savoie",             "74",  "Auvergne-Rhône-Alpes",         2, 8),\n    ("26000", "Drôme",                    "26",  "Auvergne-Rhône-Alpes",         2, 6),\n    ("43000", "Haute-Loire",              "43",  "Auvergne-Rhône-Alpes",         2, 5),\n    ("02000", "Aisne",                    "02",  "Hauts-de-France",              3, 6),\n    ("59000", "Nord",                     "59",  "Hauts-de-France",              3, 12),\n    ("62000", "Pas-de-Calais",            "62",  "Hauts-de-France",              3, 8),\n    ("60000", "Oise",                     "60",  "Hauts-de-France",              3, 6),\n    ("80000", "Somme",                    "80",  "Hauts-de-France",              3, 6),\n    ("08000", "Ardennes",                 "08",  "Grand Est",                    3, 5),\n    ("67000", "Bas-Rhin",                 "67",  "Grand Est",                    3, 8),\n    ("68000", "Haut-Rhin",                "68",  "Grand Est",                    3, 6),\n    ("54000", "Meurthe-et-Moselle",       "54",  "Grand Est",                    3, 6),\n    ("57000", "Moselle",                  "57",  "Grand Est",                    3, 8),\n    ("51100", "Marne",                    "51",  "Grand Est",                    3, 6),\n    ("88000", "Vosges",                   "88",  "Grand Est",                    3, 5),\n    ("21000", "Côte-d\'Or",                "21",  "Bourgogne-Franche-Comté",      2, 6),\n    ("25000", "Doubs",                    "25",  "Bourgogne-Franche-Comté",      2, 6),\n    ("71000", "Saône-et-Loire",           "71",  "Bourgogne-F
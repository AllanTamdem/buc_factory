, "example": "Agent", "semantics": "Canal d\'acquisition initial : Agent / Direct web / Comparateur / Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "email_optin", "type": "string", "example": "Oui", "semantics": "Consentement marketing (Oui / Non)", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "geographie.csv",\n      "columns": [\n        {"name": "code_postal", "type": "string", "example": "75011", "semantics": "Code postal français (5 caractères, conserver le zéro initial)", "is_pk": true, "fk_to": null},\n        {"name": "commune", "type": "string", "example": "Paris 11e", "semantics": "Libellé de la commune principale rattachée au code postal", "is_pk": false, "fk_to": null},\n        {"name": "departement", "type": "string", "example": "75", "semantics": "Code département INSEE (2 ou 3 caractères, ex. 75, 2A, 974)", "is_pk": false, "fk_to": null},\n        {"name": "region", "type": "string", "example": "Île-de-France", "semantics": "Région administrative", "is_pk": false, "fk_to": null},\n        {"name": "zonier_tempete", "type": "string", "example": "Z3", "semantics": "Zonier interne risque tempête / événement climatique (Z1 faible à Z5 fort)", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "produits.csv",\n      "columns": [\n        {"name": "produit_id", "type": "string", "example": "PRD-MRH-CONF", "semantics": "Identifiant produit", "is_pk": true, "fk_to": null},\n        {"name": "branche", "type": "string", "example": "MRH", "semantics": "Branche : MRH / Auto / Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "formule", "type": "string", "example": "Confort", "semantics": "Niveau de garantie (Essentiel / Confort / Premium)", "is_pk": false, "fk_to": null},\n        {"name": "date_lancement", "type": "date", "example": "01/01/2015", "semantics": "Date de lancement commercial de la formule", "is_pk": false, "fk_to": null},\n        {"name": "franchise_eur", "type": "decimal", "example": "150.00", "semantics": "Franchise contractuelle en euros", "is_pk": false, "fk_to": null},\n        {"name": "actif", "type": "string", "example": "Oui", "semantics": "Produit encore commercialisé (Oui / Non)", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "polices.csv",\n      "columns": [\n        {"name": "police_id", "type": "string", "example": "POL00045821", "semantics": "Identifiant unique du contrat (police)", "is_pk": true, "fk_to": null},\n        {"name": "client_id", "type": "string", "example": "CLI000123", "semantics": "Client souscripteur", "is_pk": false, "fk_to": "clients.client_id"},\n        {"name": "produit_id", "type": "string", "example": "PRD-MRH-CONF", "semantics": "Produit / formule souscrit", "is_pk": false, "fk_to": "produits.produit_id"},\n        {"name": "code_postal_risque", "type": "string", "example": "75011", "semantics": "Code postal du bien ou véhicule assuré", "is_pk": false, "fk_to": "geographie.code_postal"},\n        {"name": "date_effet", "type": "date", "example": "15/06/2022", "semantics": "Date d\'effet du contrat (JJ/MM/AAAA)", "is_pk": false, "fk_to": null},\n        {"name": "date_resiliation", "type": "date", "example": "14/06/2024", "semantics": "Date de résiliation effective (vide si contrat en cours)", "is_pk": false, "fk_to": null},\n        {"name": "motif_resiliation", "type": "string", "example": "Loi Hamon", "semantics": "Motif si résilié : Loi Hamon / Châtel / Non-paiement / Sinistre / Déménagement / Autre", "is_pk": false, "fk_to": null},\n        {"name": "prime_annuelle_ttc", "type": "decimal", "example": "486,50", "semantics": "Prime annuelle TTC en euros (séparateur décimal virgule, format français)", "is_pk": false, "fk_to": null},\n        {"name": "capital_assure", "type": "decimal", "example": "150000.00", "semantics": "Capital assuré ou valeur du véhicule en euros", "is_pk": false, "fk_to": null},\n        {"name": "canal_souscription", "type": "string", "example": "Agent", "semantics": "Canal de souscription : Agent / Direct web / Comparateur / Affinitaire", "is_pk": false, "fk_to": null},\n        {"name": "statut", "type": "string", "example": "En cours", "semantics": "Statut courant du contrat : En cours / Résilié / Suspendu", "is_pk": false, "fk_to": null}\n      ]\n    },\n    {\n      "filename": "sinistres.csv",\n      "columns": [\n        {"name": "sinistre_id", "type": "string", "example": "SIN0000234567", "semantics": "Identifiant unique du sinistre", "is_pk": true, "fk_to": null},\n        {"name": "police_id", "type": "string", "example": "POL00045821", "semantics": "Contrat sur lequel le sinistre est rattaché", "is_pk": false, "fk_to": "polices.police_id"},\n        {"name": "date_survenance", "type": "date", "example": "03/11/2023", "semantics": "Date de survenance du sinistre (JJ/MM/AAAA)", "is_pk": false, "fk_to": null},\n        {"name": "date_declaration", "type": "date", "example": "06/11/2023", "semantics": "Date de déclaration par l\'assuré", "is_pk": false, "fk_to": null},\n        {"name": "date_cloture", "type": "date", "example": "22/02/2024", "semantics": "Date de clôture du dossier (vide si encore ouvert)", "is_pk": false, "fk_to": null},\n        {"name": "nature_sinistre", "type": "string", "example": "Dégât des eaux", "semantics": "Typologie : Dégât des eaux / Incendie / Vol / Bris de glace / Collision / Tempête / Autre", "is_pk": false, "fk_to": null},\n        {"name": "montant_paye", "type": "decimal", "example": "1245.00", "semantics": "Montant total déjà réglé à l\'assuré ou au tiers en euros", "is_pk": false, "fk_to": null},\n        {"name": "provision_dossier", "type": "decimal", "example": "800.00", "semantics": "Provision restant à payer (réserve dossier/dossier ouvert) en euros", "is_pk": false, "fk_to": null},\n        {"name": "recours_encaisse", "type": "decimal", "example": "0.00", "semantics": "Montant des recours / subrogations encaissés en euros (à déduire du coût)", "is_pk": false, "fk_to": null},\n        {"name": "statut_dossier", "type": "string", "example": "Clos", "semantics": "Statut : Ouvert / En cours / Clos / Sans suite", "is_pk": false, "fk_to": null},\n        {"name": "responsabilite", "type": "string", "example": "100%", "semantics": "Taux de responsabilité de l\'assuré (auto principalement)", "is_pk": false, "fk_to": null}\n      ]\n    }\n  ],\n  "traps": [\n    {\n      "file": "polices.csv",\n      "column": "prime_annuelle_ttc",\n      "trap": "Le montant est stocké au format français avec virgule décimale (ex. \'486,50\') et quelques lignes incluent un séparateur de milliers espace insécable (ex. \'1 250,00\'). À l\'import par défaut, Power BI typera la colonne en texte ou produira des erreurs de conversion silencieuses ; un candidat senior doit forcer la locale \'Français (France)\' dans Power Query ou nettoyer la colonne avant typage.",\n      "why_realistic": "Les exports depuis les SI de gestion français (ex. outils internes ou extractions Excel FR) renvoient quasi systématiquement la virgule décimale et parfois l\'espace milliers, alors que la plupart des connecteurs assument une locale en-US."\n    },\n    {\n      "file": "geographie.csv",\n      "column": "code_postal",\n      "trap": "Le code postal est numérique en apparence mais doit rester en texte : les codes commençant par 0 (départements 01-09, ex. \'01000\' Bourg-en-Bresse, \'06000\' Nice) perdent leur zéro initial si la colonne est typée en entier, ce qui casse la jointure avec polices.code_postal_risque et clients.code_postal.",\n      "why_realistic": "C\'est l\'un des pièges les plus classiques sur des données françaises (codes postaux, SIREN, numéros de département corses 2A/2B) — un analyste senior doit le repérer immédiatement et forcer le type texte dès l\'import."\n    },\n    {\n      "file": "sinistres.csv",\n      "column": "montant_paye",\n      "trap": "Le coût total d\'un sinistre n\'est PAS égal à montant_paye seul : il faut calculer charge_sinistre = montant_paye + provision_dossier - recours_encaisse. Par ailleurs, une partie des dossiers ont statut_dossier = \'Clos\' avec provision_dossier > 0 (provisions non soldées suite à migration SI) et certains montant_paye sont en doublon car des avenants de règlement sont enregistrés comme nouvelles lignes plutôt qu\'agrégés.",\n      "why_realistic": "En P&C, la charge sinistre = payé + provision (- recours) est une définition métier fondamentale ; oublier la provision sous-estime massivement le S/P. Les incohérences post-migration SI sont également un cas vécu fréquent en assurance."\n    }\n  ]\n}\n', name='read_file', tool_call_id='toolu_01YAMdjuQ6oMZwPQomNbz4ZT'), ToolMessage(content="# Évaluation technique – Data Analyst Mid/Senior\n## Brief candidat – Power BI Desktop\n\n**Durée : 75 minutes — Outil imposé : Power BI Desktop — Livrable : projet PBIP**\n\n---\n\n## 1. Contexte business\n\nVous rejoignez pour cette évaluation une compagnie d'assurance **IARD (dommages aux biens et responsabilités)** de taille intermédiaire, basée à Paris, qui sert exclusivement une clientèle de **particuliers en France**. L'entreprise compte environ 500 collaborateurs et commercialise trois familles de produits : **Multirisque Habitation (MRH)**, **Auto particuliers** et **garanties affinitaires** (mobile, vélo, voyage). La distribution se fait via un **réseau d'agents liés** et un **canal direct en ligne**.\n\nLe périmètre de la mission porte spécifiquement sur la **branche Auto particuliers**, qui représente le moteur de la rentabilité technique mais qui inquiète aujourd'hui la direction. La compagnie a en effet **migré récemment son système d'information de gestion** (bascule de l'ancien outil de production vers une nouvelle plateforme). Depuis cette bascule, le COMEX constate des indicateurs « bizarres » : ratios qui dérivent, lignes de portefeuille qui semblent dupliquées ou orphelines, sinistres déclarés sans police clairement rattachée. La Direction Technique soupçonne autant un **vrai problème de qualité du portefeuille** (anti-sélection, sur-représentation de certains profils risqués) qu'un **artefact de migration** mal maîtrisé.\n\nVous disposez d'un **historique de 48 mois** et d'un portefeuille d'environ **50 000 polices Auto**.\n\n## 2. Mission\n\nVous êtes mandaté pour produire un **rapport COMEX synthétique (1 à 2 pages)** dans Power BI, dont l'objectif est de **détecter les anomalies et qualifier la qualité du portefeuille Auto** post-migration.\n\n### 2.1 KPIs attendus (3 à 5, à afficher et à interpréter)\n\n1. **Fréquence sinistres** : nombre de sinistres survenus sur la période, rapporté au nombre de polices-années exposées.\n2. **Coût moyen sinistre** : montant total des sinistres (réglé + provisionné) divisé par le nombre de sinistres.\n3. **Ratio S/P (sinistres sur primes)** : charge sinistres totale rapportée aux primes acquises sur la même période.\n4. **Taux d'anomalies portefeuille** : part des polices présentant au moins une anomalie de données (sinistre orphelin, doublon client, date d'effet incohérente, prime nulle ou négative…) sur le total du portefeuille.\n5. **Évolution mensuelle du portefeuille actif** : nombre de polices en cours par mois, avec mise en évidence visuelle de la date de bascule SI.\n\n### 2.2 Visualisations exigées (2 à 4)\n\n- Une **courbe d'évolution mensuelle** (portefeuille actif et/ou S/P) couvrant les 48 mois, avec un repère visuel de la migration SI.\n- Un **visuel de répartition** (barres ou treemap) du portefeuille ou de la sinistralité par segment pertinent (zone géographique, ancienneté, canal de distribution, formule).\n- Un **tableau ou matrice « top anomalies »** listant les cas suspects à investiguer (police, type d'anomalie, montant impacté).\n\n### 2.3 Exigence de modélisation (1)\n\nConstruire un **modèle en étoile** propre dans Power BI : table de faits (sinistres et/ou polices) reliée aux dimensions (clients, produits, géographie, calendrier). La table calendrier doit être **marquée comme table de dates** et permettre les analyses temporelles.\n\n### 2.4 Exigence qualité de données (1)\n\nDocumenter explicitement **au moins trois contrôles de qualité** réalisés sur les données (ex. doublons sur identifiant police, sinistres sans police rattachée, dates d'effet postérieures à la date de survenance, primes hors borne) et chiffrer leur impact.\n\n### 2.5 Question analytique ouverte (1)\n\n> *Selon vous, les dérives observées s'expliquent-elles davantage par un **problème de qualité de données lié à la migration SI**, ou par une **dégradation réelle du risque** sur le portefeuille Auto ? Justifiez avec deux ou trois éléments chiffrés issus de votre analyse.*\n\n## 3. Données fournies (CSV)\n\nTous les fichiers sont en UTF-8, séparateur virgule, en-tête en première ligne.\n\n- **policies.csv** — Référentiel des polices Auto.\n  Colonnes : `policy_id` (clé, texte), `client_id` (FK), `product_code` (FK), `geo_code` (FK), `channel` (texte : agent / direct), `start_date` (date), `end_date` (date, nullable), `annual_premium_eur` (décimal), `vehicle_category` (texte), `source_system` (texte : legacy / new).\n\n- **claims.csv** — Sinistres déclarés.\n  Colonnes : `claim_id` (clé), `policy_id` (FK), `loss_date` (date), `report_date` (date), `claim_status` (ouvert / clos / refusé), `paid_amount_eur` (décimal), `reserve_amount_eur` (décimal), `claim_type` (collision, vol, bris de glace, RC…).\n\n- **clients.csv** — Référentiel clients.\n  Colonnes : `client_id` (clé), `birth_year` (entier), `client_since` (date), `customer_segment` (texte).\n\n- **products.csv** — Catalogue produits.\n  Colonnes : `product_code` (clé), `product_label` (texte), `formula_tier` (éco / standard / premium).\n\n- **geography.csv** — Référentiel géographique France.\n  Colonnes : `geo_code` (clé, code département), `department_name`, `region_name`.\n\n> ⚠️ Les données portent les traces de la migration SI : doublons potentiels, clés orphelines et incohérences de dates sont à anticiper.\n\n## 4. Livrable attendu\n\nUn **projet Power BI Desktop au format PBIP** contenant :\n- le modèle de données (étoile, relations explicites, table calendrier),\n- les mesures DAX nommées et commentées pour chaque KPI,\n- un **rapport de 1 à 2 pages** orienté COMEX, lisible sans explication orale,\n- une zone de commentaire (zone de texte ou page d'annexe) résumant en 5 à 10 lignes votre réponse à la question analytique ouverte et les contrôles qualité réalisés.\n\n## 5. Critères d'évaluation (total : 100 points)\n\n| Critère | Points |\n|---|---|\n| Pertinence et exactitude des KPIs (formules, dénominateurs, période) | 25 |\n| Qualité du modèle de données (étoile, relations, table calendrier) | 20 |\n| Détection et documentation des anomalies / contrôles qualité | 20 |\n| Qualité de restitution COMEX (clarté, hiérarchie de l'information, design) | 15 |\n| Profondeur de l'analyse et réponse à la question ouverte | 15 |\n| Bonnes pratiques Power BI (nommage, mesures vs colonnes, performance) | 5 |\n\n## 6. Contraintes pratiques\n\n- **Temps imparti : 75 minutes**, montre en main.\n- **Outils interdits** : aucun assistant d'IA générative (ChatGPT, Copilot, Gemini, etc.). La documentation officielle Microsoft Power BI et les moteurs de recherche classiques sont autorisés.\n- Travail **individuel**, sans échange avec d'autres candidats.\n- Si une donnée vous semble manquante ou douteuse, **formulez une hypothèse explicite** dans le rapport plutôt que de bloquer.\n", name='read_file', tool_call_id='toolu_01JaJzzhVQTn1XigbNGrhCWg'), AIMessage(content=[{'text': "Now I have the full context. The schema (data_schema.json) is the source of truth. I'll write a generator that produces the 5 CSVs with French formats and injects all 3 traps.", 'type': 'text'}, {'id': 'toolu_01S16nbCzSfH4CZy9UM5epMc', 'caller': {'type': 'direct'}, 'input': {'path': 'starter/generate_data.py', 'content': '"""\nGénération des données synthétiques pour l\'évaluation Data Analyst Mid/Senior\nDomaine : compagnie d\'assurance IARD française (particuliers).\n\nTables produites dans starter/data/ :\n  - geographie.csv\n  - clients.csv\n  - produits.csv\n  - polices.csv\n  - sinistres.csv\n\nPièges injectés (cf. brief/data_schema.json) :\n  1. polices.prime_annuelle_ttc : virgule décimale française + espace milliers\n  2. geographie.code_postal : zéros initiaux (départements 01-09) + Corse 2A/2B\n  3. sinistres.montant_paye : charge = payé + provision - recours, provisions\n     non soldées sur dossiers Clos, doublons d\'avenants de règlement.\n"""\n\nimport os\nimport csv\nimport random\nfrom datetime import date, timedelta\n\nimport numpy as np\n\nrandom.seed(42)\nnp.random.seed(42)\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nOUT_DIR = os.path.join(HERE, "data")\nos.makedirs(OUT_DIR, exist_ok=True)\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\ndef fmt_date_fr(d):\n    """Formate une date au format JJ/MM/AAAA, ou \'\' si None."""\n    if d is None:\n        return ""\n    return d.strftime("%d/%m/%Y")\n\n\ndef fmt_eur_fr(value, thousands_sep=False):\n    """Format euro français : virgule décimale, optionnellement espace milliers."""\n    s = f"{value:.2f}"\n    int_part, dec_part = s.split(".")\n    if thousands_sep and len(int_part) > 3:\n        # espace insécable U+00A0 comme séparateur de milliers\n        groups = []\n        while len(int_part) > 3:\n            groups.insert(0, int_part[-3:])\n            int_part = int_part[:-3]\n        groups.insert(0, int_part)\n        int_part = "\\u00A0".join(groups)\n    return f"{int_part},{dec_part}"\n\n\ndef random_date(start, end):\n    delta = (end - start).days\n    return start + timedelta(days=random.randint(0, delta))\n\n\n# ---------------------------------------------------------------------------\n# 1) geographie.csv\n# ---------------------------------------------------------------------------\n# Codes postaux variés couvrant des départements à zéro initial, Corse, DOM,\n# et des grosses agglomérations. Pile : ~50-60 lignes (référentiel restreint).\nGEO_ROWS = [\n    # (code_postal, commune, departement, region, zonier_tempete)\n    ("01000", "Bourg-en-Bresse", "01", "Auvergne-Rhône-Alpes", "Z2"),\n    ("02100", "Saint-Quentin", "02", "Hauts-de-France", "Z3"),\n    ("03000", "Moulins", "03", "Auvergne-Rhône-Alpes", "Z2"),\n    ("04000", "Digne-les-Bains", "04", "Provence-Alpes-Côte d\'Azur", "Z2"),\n    ("05000", "Gap", "05", "Provence-Alpes-Côte d\'Azur", "Z2"),\n    ("06000", "Nice", "06", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("06400", "Cannes", "06", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("07000", "Privas", "07", "Auvergne-Rhône-Alpes", "Z2"),\n    ("08000", "Charleville-Mézières", "08", "Grand Est", "Z3"),\n    ("09000", "Foix", "09", "Occitanie", "Z2"),\n    ("13001", "Marseille 1er", "13", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("13008", "Marseille 8e", "13", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("14000", "Caen", "14", "Normandie", "Z4"),\n    ("17000", "La Rochelle", "17", "Nouvelle-Aquitaine", "Z5"),\n    ("20000", "Ajaccio", "2A", "Corse", "Z3"),\n    ("20200", "Bastia", "2B", "Corse", "Z3"),\n    ("21000", "Dijon", "21", "Bourgogne-Franche-Comté", "Z2"),\n    ("29200", "Brest", "29", "Bretagne", "Z5"),\n    ("31000", "Toulouse", "31", "Occitanie", "Z2"),\n    ("33000", "Bordeaux", "33", "Nouvelle-Aquitaine", "Z4"),\n    ("34000", "Montpellier", "34", "Occitanie", "Z3"),\n    ("35000", "Rennes", "35", "Bretagne", "Z4"),\n    ("37000", "Tours", "37", "Centre-Val de Loire", "Z2"),\n    ("38000", "Grenoble", "38", "Auvergne-Rhône-Alpes", "Z2"),\n    ("44000", "Nantes", "44", "Pays de la Loire", "Z4"),\n    ("49000", "Angers", "49", "Pays de la Loire", "Z3"),\n    ("51100", "Reims", "51", "Grand Est", "Z3"),\n    ("54000", "Nancy", "54", "Grand Est", "Z3"),\n    ("57000", "Metz", "57", "Grand Est", "Z3"),\n    ("59000", "Lille", "59", "Hauts-de-France", "Z4"),\n    ("59800", "Lille (Vieux-Lille)", "59", "Hauts-de-France", "Z4"),\n    ("62100", "Calais", "62", "Hauts-de-France", "Z5"),\n    ("63000", "Clermont-Ferrand", "63", "Auvergne-Rhône-Alpes", "Z2"),\n    ("64000", "Pau", "64", "Nouvelle-Aquitaine", "Z3"),\n    ("67000", "Strasbourg", "67", "Grand Est", "Z3"),\n    ("68000", "Colmar", "68", "Grand Est", "Z3"),\n    ("69001", "Lyon 1er", "69", "Auvergne-Rhône-Alpes", "Z2"),\n    ("69003", "Lyon 3e", "69", "Auvergne-Rhône-Alpes", "Z2"),\n    ("69008", "Lyon 8e", "69", "Auvergne-Rhône-Alpes", "Z2"),\n    ("75001", "Paris 1er", "75", "Île-de-France", "Z2"),\n    ("75008", "Paris 8e", "75", "Île-de-France", "Z2"),\n    ("75011", "Paris 11e", "75", "Île-de-France", "Z2"),\n    ("75015", "Paris 15e", "75", "Île-de-France", "Z2"),\n    ("75019", "Paris 19e", "75", "Île-de-France", "Z2"),\n    ("75020", "Paris 20e", "75", "Île-de-France", "Z2"),\n    ("76000", "Rouen", "76", "Normandie", "Z4"),\n    ("78000", "Versailles", "78", "Île-de-France", "Z2"),\n    ("80000", "Amiens", "80", "Hauts-de-France", "Z3"),\n    ("83000", "Toulon", "83", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("84000", "Avignon", "84", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("87000", "Limoges", "87", "Nouvelle-Aquitaine", "Z2"),\n    ("91000", "Évry-Courcouronnes", "91", "Île-de-France", "Z2"),\n    ("92100", "Boulogne-Billancourt", "92", "Île-de-France", "Z2"),\n    ("92300", "Levallois-Perret", "92", "Île-de-France", "Z2"),\n    ("93100", "Montreuil", "93", "Île-de-France", "Z2"),\n    ("93200", "Saint-Denis", "93", "Île-de-France", "Z2"),\n    ("94000", "Créteil", "94", "Île-de-France", "Z2"),\n    ("95000", "Cergy", "95", "Île-de-France", "Z2"),\n    ("97200", "Fort-de-France", "972", "Martinique", "Z5"),\n    ("97400", "Saint-Denis (Réunion)", "974", "La Réunion", "Z5"),\n]\n\nwith open(os.path.join(OUT_DIR, "geographie.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["code_postal", "commune", "departement", "region", "zonier_tempete"])\n    for row in GEO_ROWS:\n        w.writerow(row)\n\nALL_CP = [r[0] for r in GEO_ROWS]\nprint(f"geographie.csv : {len(GEO_ROWS)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 2) produits.csv\n# ---------------------------------------------------------------------------\n# Petit catalogue : 3 branches x 3 formules + 1 produit retiré + 1 affinitaire.\nPRODUITS = [\n    ("PRD-MRH-ESS",  "MRH",         "Essentiel", date(2014, 1, 1),  300.00, "Oui"),\n    ("PRD-MRH-CONF", "MRH",         "Confort",   date(2015, 1, 1),  150.00, "Oui"),\n    ("PRD-MRH-PREM", "MRH",         "Premium",   date(2018, 6, 1),  100.00, "Oui"),\n    ("PRD-AUTO-ESS", "Auto",        "Essentiel", date(2014, 1, 1),  500.00, "Oui"),\n    ("PRD-AUTO-CONF","Auto",        "Confort",   date(2015, 1, 1),  300.00, "Oui"),\n    ("PRD-AUTO-PREM","Auto",        "Premium",   date(2019, 3, 1),  150.00, "Oui"),\n    ("PRD-AUTO-LEG", "Auto",        "Confort",   date(2010, 1, 1),  400.00, "Non"),  # produit retiré\n    ("PRD-AFF-MOB",  "Affinitaire", "Essentiel", date(2020, 9, 1),   75.00, "Oui"),\n    ("PRD-AFF-VEL",  "Affinitaire", "Confort",   date(2021, 4, 1),  100.00, "Oui"),\n    ("PRD-AFF-VOY",  "Affinitaire", "Essentiel", date(2022, 5, 1),   50.00, "Oui"),\n]\n\nwith open(os.path.join(OUT_DIR, "produits.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["produit_id", "branche", "formule", "date_lancement",\n                "franchise_eur", "actif"])\n    for pid, br, formule, dlanc, fr_eur, actif in PRODUITS:\n        w.writerow([pid, br, formule, fmt_date_fr(dlanc),\n                    f"{fr_eur:.2f}", actif])\n\nPROD_IDS = [p[0] for p in PRODUITS]\nPROD_AUTO = [p[0] for p in PRODUITS if p[1] == "Auto"]\nprint(f"produits.csv : {len(PRODUITS)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 3) clients.csv\n# ---------------------------------------------------------------------------\nN_CLIENTS = 600\nCSP_CHOICES = ["Cadre", "Employé", "Profession intermédiaire", "Ouvrier",\n               "Indépendant", "Retraité", "Étudiant", "Sans emploi"]\nCSP_WEIGHTS = [0.22, 0.28, 0.15, 0.10, 0.08, 0.12, 0.03, 0.02]\nCANAUX = ["Agent", "Direct web", "Comparateur", "Affinitaire"]\nCANAL_WEIGHTS = [0.55, 0.25, 0.15, 0.05]\nGENRES = ["F", "M", "NC"]\nGENRE_WEIGHTS = [0.48, 0.49, 0.03]\n\nclients = []\nfor i in range(1, N_CLIENTS + 1):\n    cid = f"CLI{i:06d}"\n    # Naissance : entre 1945 et 2005\n    naissance = date(random.randint(1945, 2005),\n                     random.randint(1, 12),\n                     random.randint(1, 28))\n    genre = random.choices(GENRES, GENRE_WEIGHTS)[0]\n    cp = random.choice(ALL_CP)\n    # Entrée en relation entre 2010 et 2024\n    entree = random_date(date(2010, 1, 1), date(2024, 6, 30))\n    csp = random.choices(CSP_CHOICES, CSP_WEIGHTS)[0]\n    canal = random.choices(CANAUX, CANAL_WEIGHTS)[0]\n    optin = random.choices(["Oui", "Non"], [0.62, 0.38])[0]\n    clients.append((cid, naissance, genre, cp, entree, csp, canal, optin))\n\nwith open(os.path.join(OUT_DIR, "clients.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["client_id", "date_naissance", "genre", "code_postal",\n                "date_entree_relation", "csp", "canal_acquisition", "email_optin"])\n    for cid, naissance, genre, cp, entree, csp, canal, optin in clients:\n        w.writerow([cid, fmt_date_fr(naissance), genre, cp,\n                    fmt_date_fr(entree), csp, canal, optin])\n\nCLIENT_IDS = [c[0] for c in clients]\nprint(f"clients.csv : {len(clients)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 4) polices.csv\n# ---------------------------------------------------------------------------\nN_POLICES = 750\nMOTIFS = ["Loi Hamon", "Châtel", "Non-paiement", "Sinistre", "Déménagement", "Autre"]\nMOTIF_WEIGHTS = [0.32, 0.18, 0.20, 0.10, 0.12, 0.08]\n\npolices = []\nfor i in range(1, N_POLICES + 1):\n    pol_id = f"POL{i:08d}"\n    client_id = random.choice(CLIENT_IDS)\n    # Biais Auto (mission centrée Auto) ~70%, MRH 22%, Affinitaire 8%\n    r = random.random()\n    if r < 0.70:\n        produit_id = random.choice(PROD_AUTO)\n    elif r < 0.92:\n        produit_id = random.choice([p for p in PROD_IDS if p.startswith("PRD-MRH")])\n    else:\n        produit_id = random.choice([p for p in PROD_IDS if p.startswith("PRD-AFF")])\n\n    cp_risque = random.choice(ALL_CP)\n    date_effet = random_date(date(2021, 1, 1), date(2025, 3, 31))\n\n    # ~30% de polices résiliées\n    resilie = random.random() < 0.30\n    if resilie:\n        # Résiliation entre 1 mois et 36 mois après date d\'effet,\n        # mais avant aujourd\'hui (31/03/2025 référence)\n        max_ref = date(2025, 3, 31)\n        earliest = date_effet + timedelta(days=30)\n        if earliest >= max_ref:\n            date_resil = None\n            motif = ""\n            statut = "En cours"\n        else:\n            date_resil = random_date(earliest, max_ref)\n            motif = random.choices(MOTIFS, MOTIF_WEIGHTS)[0]\n            statut = "Résilié"\n    else:\n        date_resil = None\n        motif = ""\n        statut = "En cours" if random.random() < 0.97 else "Suspendu"\n\n    # Prime annuelle TTC : variable selon branche\n    if produit_id.startswith("PRD-AUTO"):\n        prime = round(np.random.normal(680, 180), 2)\n    elif produit_id.startswith("PRD-MRH"):\n        prime = round(np.random.normal(420, 120), 2)\n    else:\n        prime = round(np.random.normal(95, 25), 2)\n    prime = max(50.0, prime)\n\n    # Capital assuré\n    if produit_id.startswith("PRD-AUTO"):\n        capital = round(max(2000, np.random.normal(18000, 7000)), 2)\n    elif produit_id.startswith("PRD-MRH"):\n        capital = round(max(20000, np.random.normal(180000, 80000)), 2)\n    else:\n        capital = round(max(200, np.random.normal(900, 400)), 2)\n\n    canal_sous = random.choices(CANAUX, CANAL_WEIGHTS)[0]\n\n    polices.append({\n        "police_id": pol_id,\n        "client_id": client_id,\n        "produit_id": produit_id,\n        "code_postal_risque": cp_risque,\n        "date_effet": date_effet,\n        "date_resiliation": date_resil,\n        "motif_resiliation": motif,\n        "prime_annuelle_ttc": prime,\n        "capital_assure": capital,\n        "canal_souscription": canal_sous,\n        "statut": statut,\n    })\n\n# --- Trap polices.prime_annuelle_ttc : format français ---\n# Toutes les primes utilisent virgule décimale.\n# ~8% des lignes ont en plus un séparateur de milliers (espace insécable).\n# Quelques lignes ont prime nulle/négative (anomalie qualité documentée).\npolices_idx_thousands = set(random.sample(range(N_POLICES), int(N_POLICES * 0.08)))\n# Anomalie : ~1% de primes nulles/négatives (artefact migration SI)\npolices_idx_anomalie_prime = set(random.sample(range(N_POLICES), int(N_POLICES * 0.01)))\nfor idx in polices_idx_anomalie_prime:\n    polices[idx]["prime_annuelle_ttc"] = random.choice([0.0, -50.0, -120.0])\n\nwith open(os.path.join(OUT_DIR, "polices.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["police_id", "client_id", "produit_id", "code_postal_risque",\n                "date_effet", "date_resiliation", "motif_resiliation",\n                "prime_annuelle_ttc", "capital_assure", "canal_souscription",\n                "statut"])\n    for idx, p in enumerate(polices):\n        thousands = idx in polices_idx_thousands and p["prime_annuelle_ttc"] >= 1000\n        prime_str = fmt_eur_fr(p["prime_annuelle_ttc"], thousands_sep=thousands)\n        w.writerow([\n            p["police_id"], p["client_id"], p["produit_id"],\n            p["code_postal_risque"], fmt_date_fr(p["date_effet"]),\n            fmt_date_fr(p["date_resiliation"]), p["motif_resiliation"],\n            prime_str, f"{p[\'capital_assure\']:.2f}",\n            p["canal_souscription"], p["statut"],\n        ])\n\nPOLICE_IDS = [p["police_id"] for p in polices]\nprint(f"polices.csv : {len(polices)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 5) sinistres.csv\n# ---------------------------------------------------------------------------\n# Pour reproduire le piège métier "charge = payé + provision - recours" :\n#   - certains dossiers Clos gardent une provision_dossier > 0 (post-migration)\n#   - certains montants payés sont dupliqués (avenants enregistrés en 2 lignes)\nNATURES_AUTO = ["Collision", "Vol", "Bris de glace", "Tempête", "Autre"]\nNATURES_AUTO_W = [0.50, 0.10, 0.25, 0.08, 0.07]\nNATURES_MRH = ["Dégât des eaux", "Incendie", "Vol", "Tempête", "Autre"]\nNATURES_MRH_W = [0.50, 0.10, 0.18, 0.15, 0.07]\nNATURES_AFF = ["Vol", "Bris de glace", "Autre"]\nNATURES_AFF_W = [0.55, 0.30, 0.15]\n\n# On veut ~1 sinistre pour 1.5 polices en moyenne -> autour de 500 sinistres.\n# Quelques polices auront 2-3 sinistres, beaucoup 0 ou 1.\nsinistres = []\nsin_counter = 1\nfor p in polices:\n    # Probabilité d\'avoir au moins un sinistre : Auto 35%, MRH 18%, Aff 10%\n    if p["produit_id"].startswith("PRD-AUTO"):\n        lam = 0.55\n        natures, weights = NATURES_AUTO, NATURES_AUTO_W\n    elif p["produit_id"].startswith("PRD-MRH"):\n        lam = 0.25\n        natures, weights = NATURES_MRH, NATURES_MRH_W\n    else:\n        lam = 0.10\n        natures, weights = NATURES_AFF, NATURES_AFF_W\n    n_sin = np.random.poisson(lam)\n    for _ in range(n_sin):\n        sin_id = f"SIN{sin_counter:010d}"\n        sin_counter += 1\n        # Date de survenance entre date d\'effet et min(date_resil, today)\n        end_bound = p["date_resiliation"] or date(2025, 3, 31)\n        if end_bound <= p["date_effet"]:\n            end_bound = p["date_effet"] + timedelta(days=30)\n        date_surv = random_date(p["date_effet"], end_bound)\n        # Déclaration : 0 à 25 jours après survenance\n        date_decl = date_surv + timedelta(days=random.randint(0, 25))\n\n        nature = random.choices(natures, weights)[0]\n\n        # Montants : log-normal selon nature\n        if nature in ("Incendie", "Tempête"):\n            base = np.random.lognormal(mean=8.5, sigma=0.9)\n        elif nature in ("Vol", "Collision"):\n            base = np.random.lognormal(mean=7.5, sigma=0.8)\n        elif nature == "Bris de glace":\n            base = np.random.lognormal(mean=5.8, sigma=0.5)\n        else:\n            base = np.random.lognormal(mean=6.5, sigma=0.7)\n        base = round(min(base, 80000), 2)\n\n        # Statut\n        r = random.random()\n        if r < 0.65:\n            statut = "Clos"\n        elif r < 0.85:\n            statut = "En cours"\n        elif r < 0.95:\n            statut = "Ouvert"\n        else:\n            statut = "Sans suite"\n\n        # Répartition payé / provision selon statut\n        if statut == "Clos":\n            paye = round(base * random.uniform(0.85, 1.0), 2)\n            # Trap : ~12% des dossiers Clos ont une provision > 0 résiduelle\n            if random.random() < 0.12:\n                provision = round(base * random.uniform(0.05, 0.25), 2)\n            else:\n                provision = 0.0\n        elif statut == "En cours":\n            paye = round(base * random.uniform(0.30, 0.70), 2)\n            provision = round(base - paye, 2)\n        elif statut == "Ouvert":\n            paye = 0.0\n            provision = round(base, 2)\n        else:  # Sans suite\n            paye = 0.0\n            provision = 0.0\n\n        # Recours encaissé : ~15% des sinistres avec recours non nul (auto surtout)\n        if nature in ("Collision", "Vol") and random.random() < 0.18:\n            recours = round(base * random.uniform(0.10, 0.40), 2)\n        else:\n            recours = 0.0\n\n        # Date clôture\n        if statut == "Clos":\n            date_clot = date_decl + timedelta(days=random.randint(20, 240))\n            if date_clot > date(2025, 3, 31):\n                date_clot = date(2025, 3, 31)\n        elif statut == "Sans suite":\n            date_clot = date_decl + timedelta(days=random.randint(5, 60))\n        else:\n            date_clot = None\n\n        # Responsabilité (auto)\n        if p["produit_id"].startswith("PRD-AUTO") and nature in ("Collision",):\n            responsabilite = random.choice(["0%", "25%", "50%", "75%", "100%"])\n        else:\n            responsabilite = ""\n\n        sinistres.append({\n            "sinistre_id": sin_id,\n            "police_id": p["police_id"],\n            "date_survenance": date_surv,\n            "date_declaration": date_decl,\n            "date_cloture": date_clot,\n            "nature_sinistre": nature,\n            "montant_paye": paye,\n            "provision_dossier": provision,\n            "recours_encaisse": recours,\n            "statut_dossier": statut,\n            "responsabilite": responsabilite,\n        })\n\n# --- Trap : doublons d\'avenants de règlement ---\n# ~3% des sinistres avec montant_paye > 0 sont dupliqués sous un nouveau sinistre_id\n# mais avec même police_id et même date_survenance (avenants enregistrés\n# comme nouvelles lignes plutôt qu\'agrégés post-migration SI).\ncandidates = [i for i, s in enumerate(sinistres) if s["montant_paye"] > 0]\nn_dup = max(1, int(len(candidates) * 0.03))\nfor idx in random.sample(candidates, n_dup):\n    src = sinistres[idx]\n    dup = dict(src)\n    dup["sinistre_id"] = f"SIN{sin_counter:010d}"\n    sin_counter += 1\n    # Avenant : montant partiel, déclaré quelques jours plus tard\n    dup["montant_paye"] = round(src["montant_paye"] * random.uniform(0.15, 0.45), 2)\n    dup["provision_dossier"] = 0.0\n    dup["recours_encaisse"] = 0.0\n    dup["statut_dossier"] = "Clos"\n    dup["date_declaration"] = src["date_declaration"] + timedelta(days=random.randint(30, 120))\n    if src["date_cloture"]:\n        dup["date_cloture"] = src["date_cloture"] + timedelta(days=random.randint(5, 60))\n        if dup["date_cloture"] > date(2025, 3, 31):\n            dup["date_cloture"] = date(2025, 3, 31)\n    sinistres.append(dup)\n\n# --- Anomalies de qualité supplémentaires (cohérentes avec la mission) ---\n# 1) ~1% de sinistres avec date_declaration < date_survenance (incohérence)\nn_inco = max(1, int(len(sinistres) * 0.01))\nfor idx in random.sample(range(len(sinistres)), n_inco):\n    s = sinistres[idx]\n    s["date_declaration"] = s["date_survenance"] - timedelta(days=random.randint(1, 5))\n\nwith open(os.path.join(OUT_DIR, "sinistres.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["sinistre_id", "police_id", "date_survenance", "date_declaration",\n                "date_cloture", "nature_sinistre", "montant_paye",\n                "provision_dossier", "recours_encaisse", "statut_dossier",\n                "responsabilite"])\n    for s in sinistres:\n        w.writerow([\n            s["sinistre_id"], s["police_id"],\n            fmt_date_fr(s["date_survenance"]), fmt_date_fr(s["date_declaration"]),\n            fmt_date_fr(s["date_cloture"]), s["nature_sinistre"],\n            f"{s[\'montant_paye\']:.2f}", f"{s[\'provision_dossier\']:.2f}",\n            f"{s[\'recours_encaisse\']:.2f}", s["statut_dossier"],\n            s["responsabilite"],\n        ])\n\nprint(f"sinistres.csv : {len(sinistres)} lignes")\nprint(f"\\n✅ Fichiers générés dans : {OUT_DIR}")\n'}, 'name': 'write_file', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_01FY1zd2xLvBagV9BhcwQ6G5', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 9353, 'output_tokens': 10106, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de40c-f7bb-7fc0-88b8-6ad86d92994f-0', tool_calls=[{'name': 'write_file', 'args': {'path': 'starter/generate_data.py', 'content': '"""\nGénération des données synthétiques pour l\'évaluation Data Analyst Mid/Senior\nDomaine : compagnie d\'assurance IARD française (particuliers).\n\nTables produites dans starter/data/ :\n  - geographie.csv\n  - clients.csv\n  - produits.csv\n  - polices.csv\n  - sinistres.csv\n\nPièges injectés (cf. brief/data_schema.json) :\n  1. polices.prime_annuelle_ttc : virgule décimale française + espace milliers\n  2. geographie.code_postal : zéros initiaux (départements 01-09) + Corse 2A/2B\n  3. sinistres.montant_paye : charge = payé + provision - recours, provisions\n     non soldées sur dossiers Clos, doublons d\'avenants de règlement.\n"""\n\nimport os\nimport csv\nimport random\nfrom datetime import date, timedelta\n\nimport numpy as np\n\nrandom.seed(42)\nnp.random.seed(42)\n\nHERE = os.path.dirname(os.path.abspath(__file__))\nOUT_DIR = os.path.join(HERE, "data")\nos.makedirs(OUT_DIR, exist_ok=True)\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\ndef fmt_date_fr(d):\n    """Formate une date au format JJ/MM/AAAA, ou \'\' si None."""\n    if d is None:\n        return ""\n    return d.strftime("%d/%m/%Y")\n\n\ndef fmt_eur_fr(value, thousands_sep=False):\n    """Format euro français : virgule décimale, optionnellement espace milliers."""\n    s = f"{value:.2f}"\n    int_part, dec_part = s.split(".")\n    if thousands_sep and len(int_part) > 3:\n        # espace insécable U+00A0 comme séparateur de milliers\n        groups = []\n        while len(int_part) > 3:\n            groups.insert(0, int_part[-3:])\n            int_part = int_part[:-3]\n        groups.insert(0, int_part)\n        int_part = "\\u00A0".join(groups)\n    return f"{int_part},{dec_part}"\n\n\ndef random_date(start, end):\n    delta = (end - start).days\n    return start + timedelta(days=random.randint(0, delta))\n\n\n# ---------------------------------------------------------------------------\n# 1) geographie.csv\n# ---------------------------------------------------------------------------\n# Codes postaux variés couvrant des départements à zéro initial, Corse, DOM,\n# et des grosses agglomérations. Pile : ~50-60 lignes (référentiel restreint).\nGEO_ROWS = [\n    # (code_postal, commune, departement, region, zonier_tempete)\n    ("01000", "Bourg-en-Bresse", "01", "Auvergne-Rhône-Alpes", "Z2"),\n    ("02100", "Saint-Quentin", "02", "Hauts-de-France", "Z3"),\n    ("03000", "Moulins", "03", "Auvergne-Rhône-Alpes", "Z2"),\n    ("04000", "Digne-les-Bains", "04", "Provence-Alpes-Côte d\'Azur", "Z2"),\n    ("05000", "Gap", "05", "Provence-Alpes-Côte d\'Azur", "Z2"),\n    ("06000", "Nice", "06", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("06400", "Cannes", "06", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("07000", "Privas", "07", "Auvergne-Rhône-Alpes", "Z2"),\n    ("08000", "Charleville-Mézières", "08", "Grand Est", "Z3"),\n    ("09000", "Foix", "09", "Occitanie", "Z2"),\n    ("13001", "Marseille 1er", "13", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("13008", "Marseille 8e", "13", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("14000", "Caen", "14", "Normandie", "Z4"),\n    ("17000", "La Rochelle", "17", "Nouvelle-Aquitaine", "Z5"),\n    ("20000", "Ajaccio", "2A", "Corse", "Z3"),\n    ("20200", "Bastia", "2B", "Corse", "Z3"),\n    ("21000", "Dijon", "21", "Bourgogne-Franche-Comté", "Z2"),\n    ("29200", "Brest", "29", "Bretagne", "Z5"),\n    ("31000", "Toulouse", "31", "Occitanie", "Z2"),\n    ("33000", "Bordeaux", "33", "Nouvelle-Aquitaine", "Z4"),\n    ("34000", "Montpellier", "34", "Occitanie", "Z3"),\n    ("35000", "Rennes", "35", "Bretagne", "Z4"),\n    ("37000", "Tours", "37", "Centre-Val de Loire", "Z2"),\n    ("38000", "Grenoble", "38", "Auvergne-Rhône-Alpes", "Z2"),\n    ("44000", "Nantes", "44", "Pays de la Loire", "Z4"),\n    ("49000", "Angers", "49", "Pays de la Loire", "Z3"),\n    ("51100", "Reims", "51", "Grand Est", "Z3"),\n    ("54000", "Nancy", "54", "Grand Est", "Z3"),\n    ("57000", "Metz", "57", "Grand Est", "Z3"),\n    ("59000", "Lille", "59", "Hauts-de-France", "Z4"),\n    ("59800", "Lille (Vieux-Lille)", "59", "Hauts-de-France", "Z4"),\n    ("62100", "Calais", "62", "Hauts-de-France", "Z5"),\n    ("63000", "Clermont-Ferrand", "63", "Auvergne-Rhône-Alpes", "Z2"),\n    ("64000", "Pau", "64", "Nouvelle-Aquitaine", "Z3"),\n    ("67000", "Strasbourg", "67", "Grand Est", "Z3"),\n    ("68000", "Colmar", "68", "Grand Est", "Z3"),\n    ("69001", "Lyon 1er", "69", "Auvergne-Rhône-Alpes", "Z2"),\n    ("69003", "Lyon 3e", "69", "Auvergne-Rhône-Alpes", "Z2"),\n    ("69008", "Lyon 8e", "69", "Auvergne-Rhône-Alpes", "Z2"),\n    ("75001", "Paris 1er", "75", "Île-de-France", "Z2"),\n    ("75008", "Paris 8e", "75", "Île-de-France", "Z2"),\n    ("75011", "Paris 11e", "75", "Île-de-France", "Z2"),\n    ("75015", "Paris 15e", "75", "Île-de-France", "Z2"),\n    ("75019", "Paris 19e", "75", "Île-de-France", "Z2"),\n    ("75020", "Paris 20e", "75", "Île-de-France", "Z2"),\n    ("76000", "Rouen", "76", "Normandie", "Z4"),\n    ("78000", "Versailles", "78", "Île-de-France", "Z2"),\n    ("80000", "Amiens", "80", "Hauts-de-France", "Z3"),\n    ("83000", "Toulon", "83", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("84000", "Avignon", "84", "Provence-Alpes-Côte d\'Azur", "Z3"),\n    ("87000", "Limoges", "87", "Nouvelle-Aquitaine", "Z2"),\n    ("91000", "Évry-Courcouronnes", "91", "Île-de-France", "Z2"),\n    ("92100", "Boulogne-Billancourt", "92", "Île-de-France", "Z2"),\n    ("92300", "Levallois-Perret", "92", "Île-de-France", "Z2"),\n    ("93100", "Montreuil", "93", "Île-de-France", "Z2"),\n    ("93200", "Saint-Denis", "93", "Île-de-France", "Z2"),\n    ("94000", "Créteil", "94", "Île-de-France", "Z2"),\n    ("95000", "Cergy", "95", "Île-de-France", "Z2"),\n    ("97200", "Fort-de-France", "972", "Martinique", "Z5"),\n    ("97400", "Saint-Denis (Réunion)", "974", "La Réunion", "Z5"),\n]\n\nwith open(os.path.join(OUT_DIR, "geographie.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["code_postal", "commune", "departement", "region", "zonier_tempete"])\n    for row in GEO_ROWS:\n        w.writerow(row)\n\nALL_CP = [r[0] for r in GEO_ROWS]\nprint(f"geographie.csv : {len(GEO_ROWS)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 2) produits.csv\n# ---------------------------------------------------------------------------\n# Petit catalogue : 3 branches x 3 formules + 1 produit retiré + 1 affinitaire.\nPRODUITS = [\n    ("PRD-MRH-ESS",  "MRH",         "Essentiel", date(2014, 1, 1),  300.00, "Oui"),\n    ("PRD-MRH-CONF", "MRH",         "Confort",   date(2015, 1, 1),  150.00, "Oui"),\n    ("PRD-MRH-PREM", "MRH",         "Premium",   date(2018, 6, 1),  100.00, "Oui"),\n    ("PRD-AUTO-ESS", "Auto",        "Essentiel", date(2014, 1, 1),  500.00, "Oui"),\n    ("PRD-AUTO-CONF","Auto",        "Confort",   date(2015, 1, 1),  300.00, "Oui"),\n    ("PRD-AUTO-PREM","Auto",        "Premium",   date(2019, 3, 1),  150.00, "Oui"),\n    ("PRD-AUTO-LEG", "Auto",        "Confort",   date(2010, 1, 1),  400.00, "Non"),  # produit retiré\n    ("PRD-AFF-MOB",  "Affinitaire", "Essentiel", date(2020, 9, 1),   75.00, "Oui"),\n    ("PRD-AFF-VEL",  "Affinitaire", "Confort",   date(2021, 4, 1),  100.00, "Oui"),\n    ("PRD-AFF-VOY",  "Affinitaire", "Essentiel", date(2022, 5, 1),   50.00, "Oui"),\n]\n\nwith open(os.path.join(OUT_DIR, "produits.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["produit_id", "branche", "formule", "date_lancement",\n                "franchise_eur", "actif"])\n    for pid, br, formule, dlanc, fr_eur, actif in PRODUITS:\n        w.writerow([pid, br, formule, fmt_date_fr(dlanc),\n                    f"{fr_eur:.2f}", actif])\n\nPROD_IDS = [p[0] for p in PRODUITS]\nPROD_AUTO = [p[0] for p in PRODUITS if p[1] == "Auto"]\nprint(f"produits.csv : {len(PRODUITS)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 3) clients.csv\n# ---------------------------------------------------------------------------\nN_CLIENTS = 600\nCSP_CHOICES = ["Cadre", "Employé", "Profession intermédiaire", "Ouvrier",\n               "Indépendant", "Retraité", "Étudiant", "Sans emploi"]\nCSP_WEIGHTS = [0.22, 0.28, 0.15, 0.10, 0.08, 0.12, 0.03, 0.02]\nCANAUX = ["Agent", "Direct web", "Comparateur", "Affinitaire"]\nCANAL_WEIGHTS = [0.55, 0.25, 0.15, 0.05]\nGENRES = ["F", "M", "NC"]\nGENRE_WEIGHTS = [0.48, 0.49, 0.03]\n\nclients = []\nfor i in range(1, N_CLIENTS + 1):\n    cid = f"CLI{i:06d}"\n    # Naissance : entre 1945 et 2005\n    naissance = date(random.randint(1945, 2005),\n                     random.randint(1, 12),\n                     random.randint(1, 28))\n    genre = random.choices(GENRES, GENRE_WEIGHTS)[0]\n    cp = random.choice(ALL_CP)\n    # Entrée en relation entre 2010 et 2024\n    entree = random_date(date(2010, 1, 1), date(2024, 6, 30))\n    csp = random.choices(CSP_CHOICES, CSP_WEIGHTS)[0]\n    canal = random.choices(CANAUX, CANAL_WEIGHTS)[0]\n    optin = random.choices(["Oui", "Non"], [0.62, 0.38])[0]\n    clients.append((cid, naissance, genre, cp, entree, csp, canal, optin))\n\nwith open(os.path.join(OUT_DIR, "clients.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["client_id", "date_naissance", "genre", "code_postal",\n                "date_entree_relation", "csp", "canal_acquisition", "email_optin"])\n    for cid, naissance, genre, cp, entree, csp, canal, optin in clients:\n        w.writerow([cid, fmt_date_fr(naissance), genre, cp,\n                    fmt_date_fr(entree), csp, canal, optin])\n\nCLIENT_IDS = [c[0] for c in clients]\nprint(f"clients.csv : {len(clients)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 4) polices.csv\n# ---------------------------------------------------------------------------\nN_POLICES = 750\nMOTIFS = ["Loi Hamon", "Châtel", "Non-paiement", "Sinistre", "Déménagement", "Autre"]\nMOTIF_WEIGHTS = [0.32, 0.18, 0.20, 0.10, 0.12, 0.08]\n\npolices = []\nfor i in range(1, N_POLICES + 1):\n    pol_id = f"POL{i:08d}"\n    client_id = random.choice(CLIENT_IDS)\n    # Biais Auto (mission centrée Auto) ~70%, MRH 22%, Affinitaire 8%\n    r = random.random()\n    if r < 0.70:\n        produit_id = random.choice(PROD_AUTO)\n    elif r < 0.92:\n        produit_id = random.choice([p for p in PROD_IDS if p.startswith("PRD-MRH")])\n    else:\n        produit_id = random.choice([p for p in PROD_IDS if p.startswith("PRD-AFF")])\n\n    cp_risque = random.choice(ALL_CP)\n    date_effet = random_date(date(2021, 1, 1), date(2025, 3, 31))\n\n    # ~30% de polices résiliées\n    resilie = random.random() < 0.30\n    if resilie:\n        # Résiliation entre 1 mois et 36 mois après date d\'effet,\n        # mais avant aujourd\'hui (31/03/2025 référence)\n        max_ref = date(2025, 3, 31)\n        earliest = date_effet + timedelta(days=30)\n        if earliest >= max_ref:\n            date_resil = None\n            motif = ""\n            statut = "En cours"\n        else:\n            date_resil = random_date(earliest, max_ref)\n            motif = random.choices(MOTIFS, MOTIF_WEIGHTS)[0]\n            statut = "Résilié"\n    else:\n        date_resil = None\n        motif = ""\n        statut = "En cours" if random.random() < 0.97 else "Suspendu"\n\n    # Prime annuelle TTC : variable selon branche\n    if produit_id.startswith("PRD-AUTO"):\n        prime = round(np.random.normal(680, 180), 2)\n    elif produit_id.startswith("PRD-MRH"):\n        prime = round(np.random.normal(420, 120), 2)\n    else:\n        prime = round(np.random.normal(95, 25), 2)\n    prime = max(50.0, prime)\n\n    # Capital assuré\n    if produit_id.startswith("PRD-AUTO"):\n        capital = round(max(2000, np.random.normal(18000, 7000)), 2)\n    elif produit_id.startswith("PRD-MRH"):\n        capital = round(max(20000, np.random.normal(180000, 80000)), 2)\n    else:\n        capital = round(max(200, np.random.normal(900, 400)), 2)\n\n    canal_sous = random.choices(CANAUX, CANAL_WEIGHTS)[0]\n\n    polices.append({\n        "police_id": pol_id,\n        "client_id": client_id,\n        "produit_id": produit_id,\n        "code_postal_risque": cp_risque,\n        "date_effet": date_effet,\n        "date_resiliation": date_resil,\n        "motif_resiliation": motif,\n        "prime_annuelle_ttc": prime,\n        "capital_assure": capital,\n        "canal_souscription": canal_sous,\n        "statut": statut,\n    })\n\n# --- Trap polices.prime_annuelle_ttc : format français ---\n# Toutes les primes utilisent virgule décimale.\n# ~8% des lignes ont en plus un séparateur de milliers (espace insécable).\n# Quelques lignes ont prime nulle/négative (anomalie qualité documentée).\npolices_idx_thousands = set(random.sample(range(N_POLICES), int(N_POLICES * 0.08)))\n# Anomalie : ~1% de primes nulles/négatives (artefact migration SI)\npolices_idx_anomalie_prime = set(random.sample(range(N_POLICES), int(N_POLICES * 0.01)))\nfor idx in polices_idx_anomalie_prime:\n    polices[idx]["prime_annuelle_ttc"] = random.choice([0.0, -50.0, -120.0])\n\nwith open(os.path.join(OUT_DIR, "polices.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["police_id", "client_id", "produit_id", "code_postal_risque",\n                "date_effet", "date_resiliation", "motif_resiliation",\n                "prime_annuelle_ttc", "capital_assure", "canal_souscription",\n                "statut"])\n    for idx, p in enumerate(polices):\n        thousands = idx in polices_idx_thousands and p["prime_annuelle_ttc"] >= 1000\n        prime_str = fmt_eur_fr(p["prime_annuelle_ttc"], thousands_sep=thousands)\n        w.writerow([\n            p["police_id"], p["client_id"], p["produit_id"],\n            p["code_postal_risque"], fmt_date_fr(p["date_effet"]),\n            fmt_date_fr(p["date_resiliation"]), p["motif_resiliation"],\n            prime_str, f"{p[\'capital_assure\']:.2f}",\n            p["canal_souscription"], p["statut"],\n        ])\n\nPOLICE_IDS = [p["police_id"] for p in polices]\nprint(f"polices.csv : {len(polices)} lignes")\n\n\n# ---------------------------------------------------------------------------\n# 5) sinistres.csv\n# ---------------------------------------------------------------------------\n# Pour reproduire le piège métier "charge = payé + provision - recours" :\n#   - certains dossiers Clos gardent une provision_dossier > 0 (post-migration)\n#   - certains montants payés sont dupliqués (avenants enregistrés en 2 lignes)\nNATURES_AUTO = ["Collision", "Vol", "Bris de glace", "Tempête", "Autre"]\nNATURES_AUTO_W = [0.50, 0.10, 0.25, 0.08, 0.07]\nNATURES_MRH = ["Dégât des eaux", "Incendie", "Vol", "Tempête", "Autre"]\nNATURES_MRH_W = [0.50, 0.10, 0.18, 0.15, 0.07]\nNATURES_AFF = ["Vol", "Bris de glace", "Autre"]\nNATURES_AFF_W = [0.55, 0.30, 0.15]\n\n# On veut ~1 sinistre pour 1.5 polices en moyenne -> autour de 500 sinistres.\n# Quelques polices auront 2-3 sinistres, beaucoup 0 ou 1.\nsinistres = []\nsin_counter = 1\nfor p in polices:\n    # Probabilité d\'avoir au moins un sinistre : Auto 35%, MRH 18%, Aff 10%\n    if p["produit_id"].startswith("PRD-AUTO"):\n        lam = 0.55\n        natures, weights = NATURES_AUTO, NATURES_AUTO_W\n    elif p["produit_id"].startswith("PRD-MRH"):\n        lam = 0.25\n        natures, weights = NATURES_MRH, NATURES_MRH_W\n    else:\n        lam = 0.10\n        natures, weights = NATURES_AFF, NATURES_AFF_W\n    n_sin = np.random.poisson(lam)\n    for _ in range(n_sin):\n        sin_id = f"SIN{sin_counter:010d}"\n        sin_counter += 1\n        # Date de survenance entre date d\'effet et min(date_resil, today)\n        end_bound = p["date_resiliation"] or date(2025, 3, 31)\n        if end_bound <= p["date_effet"]:\n            end_bound = p["date_effet"] + timedelta(days=30)\n        date_surv = random_date(p["date_effet"], end_bound)\n        # Déclaration : 0 à 25 jours après survenance\n        date_decl = date_surv + timedelta(days=random.randint(0, 25))\n\n        nature = random.choices(natures, weights)[0]\n\n        # Montants : log-normal selon nature\n        if nature in ("Incendie", "Tempête"):\n            base = np.random.lognormal(mean=8.5, sigma=0.9)\n        elif nature in ("Vol", "Collision"):\n            base = np.random.lognormal(mean=7.5, sigma=0.8)\n        elif nature == "Bris de glace":\n            base = np.random.lognormal(mean=5.8, sigma=0.5)\n        else:\n            base = np.random.lognormal(mean=6.5, sigma=0.7)\n        base = round(min(base, 80000), 2)\n\n        # Statut\n        r = random.random()\n        if r < 0.65:\n            statut = "Clos"\n        elif r < 0.85:\n            statut = "En cours"\n        elif r < 0.95:\n            statut = "Ouvert"\n        else:\n            statut = "Sans suite"\n\n        # Répartition payé / provision selon statut\n        if statut == "Clos":\n            paye = round(base * random.uniform(0.85, 1.0), 2)\n            # Trap : ~12% des dossiers Clos ont une provision > 0 résiduelle\n            if random.random() < 0.12:\n                provision = round(base * random.uniform(0.05, 0.25), 2)\n            else:\n                provision = 0.0\n        elif statut == "En cours":\n            paye = round(base * random.uniform(0.30, 0.70), 2)\n            provision = round(base - paye, 2)\n        elif statut == "Ouvert":\n            paye = 0.0\n            provision = round(base, 2)\n        else:  # Sans suite\n            paye = 0.0\n            provision = 0.0\n\n        # Recours encaissé : ~15% des sinistres avec recours non nul (auto surtout)\n        if nature in ("Collision", "Vol") and random.random() < 0.18:\n            recours = round(base * random.uniform(0.10, 0.40), 2)\n        else:\n            recours = 0.0\n\n        # Date clôture\n        if statut == "Clos":\n            date_clot = date_decl + timedelta(days=random.randint(20, 240))\n            if date_clot > date(2025, 3, 31):\n                date_clot = date(2025, 3, 31)\n        elif statut == "Sans suite":\n            date_clot = date_decl + timedelta(days=random.randint(5, 60))\n        else:\n            date_clot = None\n\n        # Responsabilité (auto)\n        if p["produit_id"].startswith("PRD-AUTO") and nature in ("Collision",):\n            responsabilite = random.choice(["0%", "25%", "50%", "75%", "100%"])\n        else:\n            responsabilite = ""\n\n        sinistres.append({\n            "sinistre_id": sin_id,\n            "police_id": p["police_id"],\n            "date_survenance": date_surv,\n            "date_declaration": date_decl,\n            "date_cloture": date_clot,\n            "nature_sinistre": nature,\n            "montant_paye": paye,\n            "provision_dossier": provision,\n            "recours_encaisse": recours,\n            "statut_dossier": statut,\n            "responsabilite": responsabilite,\n        })\n\n# --- Trap : doublons d\'avenants de règlement ---\n# ~3% des sinistres avec montant_paye > 0 sont dupliqués sous un nouveau sinistre_id\n# mais avec même police_id et même date_survenance (avenants enregistrés\n# comme nouvelles lignes plutôt qu\'agrégés post-migration SI).\ncandidates = [i for i, s in enumerate(sinistres) if s["montant_paye"] > 0]\nn_dup = max(1, int(len(candidates) * 0.03))\nfor idx in random.sample(candidates, n_dup):\n    src = sinistres[idx]\n    dup = dict(src)\n    dup["sinistre_id"] = f"SIN{sin_counter:010d}"\n    sin_counter += 1\n    # Avenant : montant partiel, déclaré quelques jours plus tard\n    dup["montant_paye"] = round(src["montant_paye"] * random.uniform(0.15, 0.45), 2)\n    dup["provision_dossier"] = 0.0\n    dup["recours_encaisse"] = 0.0\n    dup["statut_dossier"] = "Clos"\n    dup["date_declaration"] = src["date_declaration"] + timedelta(days=random.randint(30, 120))\n    if src["date_cloture"]:\n        dup["date_cloture"] = src["date_cloture"] + timedelta(days=random.randint(5, 60))\n        if dup["date_cloture"] > date(2025, 3, 31):\n            dup["date_cloture"] = date(2025, 3, 31)\n    sinistres.append(dup)\n\n# --- Anomalies de qualité supplémentaires (cohérentes avec la mission) ---\n# 1) ~1% de sinistres avec date_declaration < date_survenance (incohérence)\nn_inco = max(1, int(len(sinistres) * 0.01))\nfor idx in random.sample(range(len(sinistres)), n_inco):\n    s = sinistres[idx]\n    s["date_declaration"] = s["date_survenance"] - timedelta(days=random.randint(1, 5))\n\nwith open(os.path.join(OUT_DIR, "sinistres.csv"), "w", encoding="utf-8", newline="") as f:\n    w = csv.writer(f)\n    w.writerow(["sinistre_id", "police_id", "date_survenance", "date_declaration",\n                "date_cloture", "nature_sinistre", "montant_paye",\n                "provision_dossier", "recours_encaisse", "statut_dossier",\n                "responsabilite"])\n    for s in sinistres:\n        w.writerow([\n            s["sinistre_id"], s["police_id"],\n            fmt_date_fr(s["date_survenance"]), fmt_date_fr(s["date_declaration"]),\n            fmt_date_fr(s["date_cloture"]), s["nature_sinistre"],\n            f"{s[\'montant_paye\']:.2f}", f"{s[\'provision_dossier\']:.2f}",\n            f"{s[\'recours_encaisse\']:.2f}", s["statut_dossier"],\n            s["responsabilite"],\n        ])\n\nprint(f"sinistres.csv : {len(sinistres)} lignes")\nprint(f"\\n✅ Fichiers générés dans : {OUT_DIR}")\n'}, 'id': 'toolu_01S16nbCzSfH4CZy9UM5epMc', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 9353, 'output_tokens': 10106, 'total_tokens': 19459, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='wrote 21080 chars to starter/generate_data.py', name='write_file', tool_call_id='toolu_01S16nbCzSfH4CZy9UM5epMc'), AIMessage(content=[{'id': 'toolu_01PwW9Rkb16ZWiDvbWqr7VVK', 'caller': {'type': 'direct'}, 'input': {'script_path': 'starter/generate_data.py'}, 'name': 'run_python', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_01UsQWCxkvwT4grvqRvN8MC5', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 19490, 'output_tokens': 73, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de40e-96ef-7c93-86a7-ef164dd89c49-0', tool_calls=[{'name': 'run_python', 'args': {'script_path': 'starter/generate_data.py'}, 'id': 'toolu_01PwW9Rkb16ZWiDvbWqr7VVK', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 19490, 'output_tokens': 73, 'total_tokens': 19563, 'input_token_details': {'cache_read': 0, 'cache_creation': 0, 'ephemeral_5m_input_tokens': 0, 'ephemeral_1h_input_tokens': 0}}), ToolMessage(content='exit=0\nstdout:\ngeographie.csv : 60 lignes\nproduits.csv : 10 lignes\nclients.csv : 600 lignes\npolices.csv : 750 lignes\nsinistres.csv : 347 lignes\n\n✅ Fichiers générés dans : /Users/allan.tamdem/Documents/Workspace/buc_factory/data/run_004/starter/data\n\nstderr:\n', name='run_python', tool_call_id='toolu_01PwW9Rkb16ZWiDvbWqr7VVK'), AIMessage(content=[{'text': 'The script ran cleanly. produits.csv has 10 rows and geographie.csv has 60 — both are reference dimensions where 300+ rows would be unrealistic (only 10 products total, finite postal codes). The brief 300-800 row range applies to the substantive entities (clients=600, polices=750, sinistres=347).\n\nLet me bump sinistres a touch and verify FK integrity for the main fact-to-dimension link.', 'type': 'text'}, {'id': 'toolu_01KATwcRH4ceh4nn5QDC3vvQ', 'caller': {'type': 'direct'}, 'input': {'spec_json': '{"facts": "starter/data/sinistres.csv", "fact_fk": "police_id", "dim": "starter/data/polices.csv", "dim_pk": "police_id"}'}, 'name': 'validate_csv_integrity', 'type': 'tool_use'}, {'id': 'toolu_01WBTzHwN73UB8wtqHTM8BYD', 'caller': {'type': 'direct'}, 'input': {'spec_json': '{"facts": "starter/data/polices.csv", "fact_fk": "client_id", "dim": "starter/data/clients.csv", "dim_pk": "client_id"}'}, 'name': 'validate_csv_integrity', 'type': 'tool_use'}, {'id': 'toolu_01KXjfd6YkVXv7wwMGJYBBvJ', 'caller': {'type': 'direct'}, 'input': {'spec_json': '{"facts": "starter/data/polices.csv", "fact_fk": "produit_id", "dim": "starter/data/produits.csv", "dim_pk": "produit_id"}'}, 'name': 'validate_csv_integrity', 'type': 'tool_use'}, {'id': 'toolu_019i3Yh4PE8c4m5Zmy5gPpfH', 'caller': {'type': 'direct'}, 'input': {'spec_json': '{"facts": "starter/data/polices.csv", "fact_fk": "code_postal_risque", "dim": "starter/data/geographie.csv", "dim_pk": "code_postal"}'}, 'name': 'validate_csv_integrity', 'type': 'tool_use'}], additional_kwargs={}, response_metadata={'id': 'msg_012vrjAH4X4HXnxtAC7V9vMK', 'container': None, 'model': 'claude-opus-4-7', 'stop_details': None, 'stop_reason': 'tool_use', 'stop_sequence': None, 'usage': {'cache_creation': {'ephemeral_1h_input_tokens': 0, 'ephemeral_5m_input_tokens': 0}, 'cache_creation_input_tokens': 0, 'cache_read_input_tokens': 0, 'inference_geo': 'global', 'input_tokens': 19709, 'output_tokens': 610, 'server_tool_use': None, 'service_tier': 'standard'}, 'model_name': 'claude-opus-4-7', 'model_provider': 'anthropic'}, id='lc_run--019de40e-aadb-7bd3-afb8-44ecff6d37b